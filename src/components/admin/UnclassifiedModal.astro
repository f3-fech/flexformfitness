---
import type { Product } from '../../types';
import { getObjectPosition } from '../../lib/utils';

interface Props {
  products: Product[];
}

const { products = [] } = Astro.props;
---

<div id="unclassified-modal" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-slate-900/60 backdrop-blur-sm hidden animate-fade-in">
  <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 w-full max-w-3xl max-h-[85vh] flex flex-col overflow-hidden animate-scale-up">
    <!-- Header -->
    <div class="px-6 py-4.5 border-b border-slate-200 flex items-center justify-between bg-slate-50/80 shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-amber-100 border border-amber-200 flex items-center justify-center text-amber-700 shadow-3xs shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3l3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider font-mono">
              Artículos Olvidados / Sin Clasificar
            </h3>
            <span id="unclassified-modal-count-badge" class="px-2 py-0.5 rounded-full text-3xs font-black bg-amber-200 text-amber-900 font-mono">
              {products.length}
            </span>
          </div>
          <p class="text-[11px] text-slate-500 font-medium">
            Productos creados que no pertenecen a ninguna carpeta o colección de la tienda.
          </p>
        </div>
      </div>
      <button
        type="button"
        id="close-unclassified-modal"
        class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-800 flex items-center justify-center transition-all cursor-pointer font-bold text-lg select-none"
      >
        ×
      </button>
    </div>

    <!-- Body -->
    <div class="p-6 overflow-y-auto flex-grow flex flex-col gap-4">
      {products.length === 0 ? (
        <div class="py-12 flex flex-col items-center justify-center text-center gap-3">
          <div class="w-14 h-14 rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wider">¡Todos los productos están organizados!</h4>
          <p class="text-xs text-slate-400 max-w-sm">No hay artículos huérfanos sin colección. Todos pertenecen al menos a una carpeta.</p>
        </div>
      ) : (
        <>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 bg-amber-50/70 border border-amber-200/80 rounded-2xl">
            <p class="text-xs text-amber-900 font-medium leading-relaxed">
              Estos productos existen en la tienda pero no se muestran en ningún catálogo ni menú. Puedes editarlos para asignarles colecciones o filtrarlos en la barra lateral para arrastrarlos a sus carpetas.
            </p>
            <button
              type="button"
              id="filter-sidebar-from-modal-btn"
              class="px-3.5 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-3xs font-black uppercase tracking-wider shadow-sm transition-all shrink-0 cursor-pointer flex items-center gap-1.5 active:scale-95"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
              <span>Filtrar en barra lateral</span>
            </button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="unclassified-products-grid">
            {products.map((p) => (
              <div class="bg-white border border-slate-200 rounded-2xl p-3 flex items-center gap-3.5 hover:border-slate-300 hover:shadow-2xs transition-all">
                <div class="w-14 h-18 rounded-xl overflow-hidden bg-slate-50 shrink-0 border border-slate-200">
                  <img src={p.images[0] || '/images/placeholder.jpg'} alt={p.title} class="w-full h-full object-cover" style={`object-position: ${getObjectPosition(p.images[0])}`} />
                </div>
                <div class="min-w-0 flex-1 flex flex-col justify-between h-full py-0.5">
                  <div>
                    <div class="flex items-center gap-1.5 mb-0.5">
                      <span class="text-3xs font-mono font-bold text-slate-400 uppercase tracking-wider">
                        SKU: {p.variants[0]?.sku || 'BASE'}
                      </span>
                      <span class="px-1.5 py-0.2 rounded text-[8px] font-black uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-200">
                        Sin Carpeta
                      </span>
                    </div>
                    <h5 class="text-xs font-bold text-slate-900 truncate leading-tight" title={p.title}>
                      {p.title}
                    </h5>
                    <div class="text-3xs text-slate-500 font-mono mt-0.5">
                      {(p.price / 100).toFixed(2)} € • Stock: {p.stock}
                    </div>
                  </div>

                  <div class="flex items-center gap-2 mt-2">
                    <button
                      type="button"
                      class="edit-product-btn px-2.5 py-1 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-3xs font-bold uppercase tracking-wider transition-all cursor-pointer active:scale-95"
                      data-product={JSON.stringify(p)}
                    >
                      Editar
                    </button>
                    <a
                      href={`/es/productos/${p.slug}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-3xs font-bold uppercase tracking-wider transition-all cursor-pointer flex items-center gap-1"
                    >
                      <span>Ver</span>
                      <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </>
      )}
    </div>

    <!-- Footer -->
    <div class="px-6 py-3.5 border-t border-slate-200 bg-slate-50/80 flex items-center justify-end shrink-0">
      <button
        type="button"
        id="cancel-unclassified-modal"
        class="px-4 py-2 bg-white hover:bg-slate-100 border border-slate-200 text-slate-600 rounded-xl text-xs font-bold uppercase transition-colors shadow-3xs cursor-pointer active:scale-95"
      >
        Cerrar
      </button>
    </div>
  </div>
</div>
