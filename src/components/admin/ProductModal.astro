<!-- MODAL: IMAGE CROP/ALIGNMENT -->
<div id="crop-modal" class="fixed inset-0 z-[70] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden">
  <div class="bg-white border border-slate-200 rounded-3xl w-full max-w-xl shadow-2xl overflow-hidden animate-fade-in flex flex-col max-h-[90vh]">
    <!-- Title Bar -->
    <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex justify-between items-center select-none shrink-0">
      <span class="text-xs font-extrabold tracking-widest text-slate-800 uppercase font-mono">Recortar Imagen de Portada (3:4)</span>
      <button type="button" id="close-crop-modal" class="w-5 h-5 flex items-center justify-center rounded bg-slate-100 hover:bg-rose-600 hover:text-white text-slate-500 text-xs font-bold transition-all">×</button>
    </div>
    
    <!-- Modal Body -->
    <div class="p-6 flex flex-col items-center gap-4 overflow-hidden flex-grow bg-slate-50/50">
      <!-- Cropper Container -->
      <div class="w-full flex-grow min-h-[320px] max-h-[450px] overflow-hidden rounded-2xl border border-slate-200 bg-slate-900 flex items-center justify-center relative">
        <img id="crop-preview-img" class="max-w-full max-h-[400px] block" crossorigin="anonymous" src="" />
      </div>
      <p class="text-[9px] text-slate-400 select-none text-center">Arrastra el recuadro para mover el área de recorte o arrastra las esquinas para redimensionarla. El aspecto está fijado en 2:3 (vertical 3:2).</p>
    </div>

    <!-- Footer -->
    <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex justify-end gap-2 shrink-0">
      <button type="button" id="cancel-crop-btn" class="px-4 py-2 bg-white hover:bg-slate-100 border border-slate-200 text-slate-650 hover:text-slate-900 rounded-xl text-xs font-bold uppercase transition-all select-none cursor-pointer">Cancelar</button>
      <button type="button" id="save-crop-btn" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-bold uppercase transition-all select-none cursor-pointer">Recortar y Guardar</button>
    </div>
  </div>
</div>

<!-- MODAL: CONFIRMAR ELIMINACIÓN DE IMAGEN DEL PRODUCTO / BASE DE DATOS -->
<div id="remove-media-modal" class="fixed inset-0 z-[80] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden">
  <div class="bg-white border border-slate-200 rounded-3xl w-full max-w-md shadow-2xl overflow-hidden animate-fade-in flex flex-col">
    <!-- Header -->
    <div class="px-5 py-4 bg-slate-50 border-b border-slate-200 flex justify-between items-center shrink-0">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-rose-50 border border-rose-100 text-rose-600 flex items-center justify-center">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
          </svg>
        </div>
        <h4 class="text-xs font-black uppercase tracking-wider text-slate-800">¿Cómo deseas gestionar esta foto?</h4>
      </div>
      <button type="button" id="close-remove-media-modal" class="text-slate-400 hover:text-slate-700 text-lg font-bold p-1 leading-none cursor-pointer">×</button>
    </div>

    <!-- Body -->
    <div class="p-5 flex flex-col gap-4">
      <div class="flex items-center gap-3.5 p-3 rounded-2xl bg-slate-50 border border-slate-100">
        <div class="w-16 h-20 rounded-xl overflow-hidden border border-slate-200 bg-white shrink-0 shadow-3xs">
          <img id="remove-media-preview-img" src="" alt="Vista previa" class="w-full h-full object-cover" />
        </div>
        <div class="flex flex-col gap-1 min-w-0">
          <p class="text-xs font-bold text-slate-800">Selecciona una opción</p>
          <p class="text-[11px] text-slate-500 leading-relaxed">Puedes quitarla únicamente de la lista de fotos de este producto o borrarla de forma definitiva del servidor y la galería.</p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col gap-2.5">
        <!-- Option 1: Remove from product only -->
        <button
          type="button"
          id="btn-remove-from-product-only"
          class="w-full text-left p-3.5 rounded-2xl border border-slate-200 hover:border-slate-400 bg-white hover:bg-slate-50 transition-all flex items-start gap-3 cursor-pointer group active:scale-[0.99]"
        >
          <div class="w-8 h-8 rounded-xl bg-slate-100 group-hover:bg-slate-200 text-slate-700 flex items-center justify-center shrink-0 mt-0.5 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xs font-extrabold text-slate-800 group-hover:text-slate-950">Quitar solo del producto</span>
            <span class="text-[10px] text-slate-500">La imagen desaparecerá de este producto, pero seguirá guardada en la galería y en Firebase Storage.</span>
          </div>
        </button>

        <!-- Option 2: Delete permanently from DB/Storage -->
        <button
          type="button"
          id="btn-delete-from-db-storage"
          class="w-full text-left p-3.5 rounded-2xl border border-rose-200 hover:border-rose-400 bg-rose-50/50 hover:bg-rose-50 transition-all flex items-start gap-3 cursor-pointer group active:scale-[0.99]"
        >
          <div class="w-8 h-8 rounded-xl bg-rose-100 group-hover:bg-rose-200 text-rose-700 flex items-center justify-center shrink-0 mt-0.5 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xs font-extrabold text-rose-700 group-hover:text-rose-800 flex items-center gap-1.5">
              Eliminar de la Galería y Base de Datos
              <span class="text-[9px] font-bold bg-rose-200 text-rose-800 px-1.5 py-0.2 rounded uppercase">Definitivo</span>
            </span>
            <span class="text-[10px] text-rose-600/80">Se eliminará permanentemente de Firebase Storage, de este producto y de la galería de medios.</span>
          </div>
        </button>
      </div>
    </div>

    <!-- Footer -->
    <div class="p-3.5 bg-slate-50 border-t border-slate-200 flex justify-end shrink-0">
      <button
        type="button"
        id="cancel-remove-media-btn"
        class="px-4 py-2 bg-white hover:bg-slate-100 border border-slate-200 text-slate-650 hover:text-slate-900 rounded-xl text-xs font-bold uppercase transition-all cursor-pointer"
      >
        Cancelar
      </button>
    </div>
  </div>
</div>

<!-- Pass server data to client side -->
<div id="products-data-provider" data-products={JSON.stringify(products.map((p) => ({ id: p.id, slug: p.slug, title: p.title, images: p.images || [], variants: (p.variants || []).map((v: any) => ({ name: v.name, image: v.image })) })))} class="hidden"></div>
<div id="collections-data-provider" data-collections={JSON.stringify(collections)} class="hidden"></div>
<div id="saved-colors-data-provider" data-colors={JSON.stringify(savedColors)} class="hidden"></div>
