---
import { db } from '../lib/firebase';
import type { Product, ProductCollection } from '../types';
import { getGeneralSettings } from '../lib/settings';
import { useTranslations } from '../lib/i18n';
import { getColorHex, isLightColor } from '../lib/utils';
import { optimizeProduct, optimizeStorageUrl } from '../lib/cdn';

let collections: ProductCollection[] = [];
try {
  const snap = await db.collection('collections').get();
  if (!snap.empty) {
    collections = snap.docs.map((doc) => ({ id: doc.id, ...doc.data() }) as ProductCollection);
  }
} catch (e) {
  console.error('Error loading collections for Navbar:', e);
}

let allProducts: Product[] = [];
try {
  const snap = await db.collection('products').orderBy('createdAt', 'desc').get();
  if (!snap.empty) {
    allProducts = snap.docs.map((doc) => optimizeProduct({ id: doc.id, ...doc.data() } as Product));
  }
} catch (e) {
  console.error('Error loading products for Navbar search:', e);
}

interface SwatchColor {
  name: string;
  hex: string;
  image: string | null;
}

const getUniqueColors = (product: Product): SwatchColor[] => {
  if (!product.variants || product.variants.length === 0) return [];
  const colorMap = new Map<string, SwatchColor>();
  
  product.variants.forEach((v) => {
    const parts = v.name.split('/').map((p) => p.trim());
    const name = parts[0] || 'Base';
    
    if (!colorMap.has(name)) {
      const hex = v.colorHex || getColorHex(name);
      colorMap.set(name, {
        name: name,
        hex: hex,
        image: v.image || null
      });
    }
  });
  
  return Array.from(colorMap.values());
};

const getProductType = (title: string): string => {
  const t = title.toLowerCase();
  if (t.includes('tirante') || t.includes('sin manga') || t.includes('tank')) return 'Tirantes';
  if (t.includes('camiseta') || t.includes('t-shirt') || t.includes('tee')) return 'Camisetas';
  if (t.includes('sudadera') || t.includes('hoodie')) return 'Sudaderas';
  if (t.includes('legging') || t.includes('malla')) return 'Leggings';
  if (t.includes('top')) return 'Tops Deportivos';
  if (t.includes('pantalón') || t.includes('pantalon') || t.includes('short')) return 'Pantalones';
  return 'Otras prendas';
};

const getProductFit = (title: string): string => {
  const t = title.toLowerCase();
  if (t.includes('superoversize')) return 'Superoversized';
  if (t.includes('oversize')) return 'Oversized';
  if (t.includes('crop')) return 'Cropped';
  if (t.includes('body fit') || t.includes('tight') || t.includes('slim')) return 'Body Fit';
  return 'Regular Fit';
};

const getProductGender = (product: Product): string => {
  const t = (product.title || '').toLowerCase();
  if (t.includes('mujer') || t.includes('women')) return 'Mujer';
  if (t.includes('hombre') || t.includes('men')) return 'Hombre';

  const inMujer = collections.some(c => 
    (c.slug.includes('mujer') || c.title.toLowerCase().includes('mujer') || c.parentCategory === 'Mujer') &&
    c.productIds && c.productIds.includes(product.id)
  );
  if (inMujer) return 'Mujer';

  return 'Hombre';
};

const getProductFeatures = (title: string): string[] => {
  const t = title.toLowerCase();
  const f: string[] = [];
  if (t.includes('oversize') || t.includes('superoversize')) f.push('Oversized');
  if (t.includes('tirante') || t.includes('sin manga')) f.push('Tirantes');
  if (t.includes('crop')) f.push('Cropped');
  if (t.includes('3/4')) f.push('Manga 3/4');
  else if (t.includes('camiseta') && !t.includes('sin manga')) f.push('Manga Corta');
  return f;
};

const getProductSizes = (product: Product): string[] => {
  const sizeSet = new Set<string>();
  (product.variants || []).forEach((v) => {
    const parts = (v.name || '').split('/');
    if (parts[1]) {
      const s = parts[1].trim().toUpperCase();
      if (s) sizeSet.add(s);
    }
  });
  return Array.from(sizeSet);
};

const minProducts = allProducts.map((p) => {
  const colIds = collections.filter((c) => c.productIds && c.productIds.includes(p.id)).map((c) => c.id);
  const createdMs = p.createdAt?._seconds ? p.createdAt._seconds * 1000 : (p.createdAt ? new Date(p.createdAt).getTime() : 0);

  return {
    id: p.id,
    title: p.title,
    title_en: p.title_en || '',
    description: p.description,
    description_en: p.description_en || '',
    slug: p.slug,
    price: p.price,
    images: p.images || [],
    stock: p.stock || 0,
    uniqueColors: getUniqueColors(p),
    sizes: getProductSizes(p),
    collectionIds: colIds,
    productType: getProductType(p.title),
    fit: getProductFit(p.title),
    gender: getProductGender(p),
    features: getProductFeatures(p.title),
    createdAt: createdMs
  };
});

const minCollections = collections.map((c) => ({
  id: c.id,
  title: c.title,
  title_en: c.title_en || c.title,
  slug: c.slug,
  count: c.productIds?.length || 0
}));

const user = Astro.locals.user;
const settings = await getGeneralSettings();

const { lang = 'es' } = Astro.params;
const t = useTranslations(lang);
const isEn = lang === 'en';

// 1. General Mega Menu configuration
const megaMenu = settings.megaMenu;
const s1Title = megaMenu?.section1?.title ? (isEn ? (megaMenu.section1.titleEn || megaMenu.section1.title) : megaMenu.section1.title) : (isEn ? "Our Collections" : "Nuestras Colecciones");
const s1Ids = megaMenu?.section1?.collectionIds;
const s1Collections = s1Ids 
  ? s1Ids.map(id => collections.find(c => c.id === id)).filter(Boolean) as ProductCollection[]
  : collections.slice(0, 5);

const s2Title = megaMenu?.section2?.title ? (isEn ? (megaMenu.section2.titleEn || megaMenu.section2.title) : megaMenu.section2.title) : (isEn ? "More Categories" : "Más Categorías");
const s2Ids = megaMenu?.section2?.collectionIds;
const s2Collections = s2Ids 
  ? s2Ids.map(id => collections.find(c => c.id === id)).filter(Boolean) as ProductCollection[]
  : collections.slice(5);

const p1Image = optimizeStorageUrl(megaMenu?.promo1?.imageUrl) || "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=600";
const p1Title = megaMenu?.promo1?.title 
  ? (isEn ? (megaMenu.promo1.titleEn || megaMenu.promo1.title) : megaMenu.promo1.title) 
  : (isEn ? "Men's Collection" : "Colección Hombre");
const p1Subtitle = megaMenu?.promo1?.subtitle 
  ? (isEn ? (megaMenu.promo1.subtitleEn || megaMenu.promo1.subtitle) : megaMenu.promo1.subtitle) 
  : (isEn ? "Explore New" : "Explorar Novedades");
const p1RawLink = megaMenu?.promo1?.linkUrl || 'hombre';
const p1Link = p1RawLink.startsWith('/') ? p1RawLink : `/${lang}/colecciones/${p1RawLink}`;

const p2Image = optimizeStorageUrl(megaMenu?.promo2?.imageUrl) || "https://images.unsplash.com/photo-1518310383802-640c2de311b2?w=600";
const p2Title = megaMenu?.promo2?.title 
  ? (isEn ? (megaMenu.promo2.titleEn || megaMenu.promo2.title) : megaMenu.promo2.title) 
  : (isEn ? "Women's Collection" : "Colección Mujer");
const p2Subtitle = megaMenu?.promo2?.subtitle 
  ? (isEn ? (megaMenu.promo2.subtitleEn || megaMenu.promo2.subtitle) : megaMenu.promo2.subtitle) 
  : (isEn ? "Explore New" : "Explorar Novedades");
const p2RawLink = megaMenu?.promo2?.linkUrl || 'mujer';
const p2Link = p2RawLink.startsWith('/') ? p2RawLink : `/${lang}/colecciones/${p2RawLink}`;

// Subcollections default fallback filters for Hombre and Mujer
const subCollectionsHombre = collections.filter((c) => {
  if (c.slug === 'hombre' || c.slug === 'mujer') return false;
  if (c.parentCategory) return c.parentCategory === 'Hombre';
  const isMen = c.slug.includes('hombre') || c.title.toLowerCase().includes('hombre') || c.title.toLowerCase().includes('men');
  return isMen;
}).sort((a, b) => (a.indexOrder ?? 999) - (b.indexOrder ?? 999));

const subCollectionsMujer = collections.filter((c) => {
  if (c.slug === 'hombre' || c.slug === 'mujer') return false;
  if (c.parentCategory) return c.parentCategory === 'Mujer';
  const isMen = c.slug.includes('hombre') || c.title.toLowerCase().includes('hombre') || c.title.toLowerCase().includes('men');
  const isWomen = c.slug.includes('mujer') || c.title.toLowerCase().includes('mujer') || c.title.toLowerCase().includes('women');
  return isWomen && !isMen;
}).sort((a, b) => (a.indexOrder ?? 999) - (b.indexOrder ?? 999));

// 2. Hombre Mega Menu
const megaMenuHombre = settings.megaMenuHombre;
const m1Title = isEn ? "Men's Wear" : "Ropa Hombre";
const m1Collections = subCollectionsHombre;

const m2Title = megaMenuHombre?.section2?.title ? (isEn ? (megaMenuHombre.section2.titleEn || megaMenuHombre.section2.title) : megaMenuHombre.section2.title) : (isEn ? "More Categories" : "Más Categorías");
const m2Collections = megaMenuHombre?.section2?.collectionIds
  ? (megaMenuHombre.section2.collectionIds.map(id => collections.find(c => c.id === id)).filter(Boolean) as ProductCollection[])
  : [];

const mP1Image = optimizeStorageUrl(megaMenuHombre?.promo1?.imageUrl) || "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=600";
const mP1Title = megaMenuHombre?.promo1?.title ? (isEn ? (megaMenuHombre.promo1.titleEn || megaMenuHombre.promo1.title) : megaMenuHombre.promo1.title) : (isEn ? "Men's Collection" : "Colección Hombre");
const mP1Subtitle = megaMenuHombre?.promo1?.subtitle ? (isEn ? (megaMenuHombre.promo1.subtitleEn || megaMenuHombre.promo1.subtitle) : megaMenuHombre.promo1.subtitle) : (isEn ? "Explore New" : "Explorar Novedades");
const mP1RawLink = megaMenuHombre?.promo1?.linkUrl || 'hombre';
const mP1Link = mP1RawLink.startsWith('/') ? mP1RawLink : `/${lang}/colecciones/${mP1RawLink}`;

const mP2Image = optimizeStorageUrl(megaMenuHombre?.promo2?.imageUrl) || "https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=600";
const mP2Title = megaMenuHombre?.promo2?.title ? (isEn ? (megaMenuHombre.promo2.titleEn || megaMenuHombre.promo2.title) : megaMenuHombre.promo2.title) : (isEn ? "New Drops" : "Nuevos Drops");
const mP2Subtitle = megaMenuHombre?.promo2?.subtitle ? (isEn ? (megaMenuHombre.promo2.subtitleEn || megaMenuHombre.promo2.subtitle) : megaMenuHombre.promo2.subtitle) : (isEn ? "Limited Edition" : "Edición Limitada");
const mP2RawLink = megaMenuHombre?.promo2?.linkUrl || 'hombre';
const mP2Link = mP2RawLink.startsWith('/') ? mP2RawLink : `/${lang}/colecciones/${mP2RawLink}`;

// 3. Mujer Mega Menu
const megaMenuMujer = settings.megaMenuMujer;
const w1Title = isEn ? "Women's Wear" : "Ropa Mujer";
const w1Collections = subCollectionsMujer;

const w2Title = megaMenuMujer?.section2?.title ? (isEn ? (megaMenuMujer.section2.titleEn || megaMenuMujer.section2.title) : megaMenuMujer.section2.title) : (isEn ? "More Categories" : "Más Categorías");
const w2Collections = megaMenuMujer?.section2?.collectionIds
  ? (megaMenuMujer.section2.collectionIds.map(id => collections.find(c => c.id === id)).filter(Boolean) as ProductCollection[])
  : [];

const wP1Image = optimizeStorageUrl(megaMenuMujer?.promo1?.imageUrl) || "https://images.unsplash.com/photo-1518310383802-640c2de311b2?w=600";
const wP1Title = megaMenuMujer?.promo1?.title ? (isEn ? (megaMenuMujer.promo1.titleEn || megaMenuMujer.promo1.title) : megaMenuMujer.promo1.title) : (isEn ? "Women's Collection" : "Colección Mujer");
const wP1Subtitle = megaMenuMujer?.promo1?.subtitle ? (isEn ? (megaMenuMujer.promo1.subtitleEn || megaMenuMujer.promo1.subtitle) : megaMenuMujer.promo1.subtitle) : (isEn ? "Explore New" : "Explorar Novedades");
const wP1RawLink = megaMenuMujer?.promo1?.linkUrl || 'mujer';
const wP1Link = wP1RawLink.startsWith('/') ? wP1RawLink : `/${lang}/colecciones/${wP1RawLink}`;

const wP2Image = optimizeStorageUrl(megaMenuMujer?.promo2?.imageUrl) || "https://images.unsplash.com/photo-1574680096145-d05b474e2155?w=600";
const wP2Title = megaMenuMujer?.promo2?.title ? (isEn ? (megaMenuMujer.promo2.titleEn || megaMenuMujer.promo2.title) : megaMenuMujer.promo2.title) : (isEn ? "New Drops" : "Nuevos Drops");
const wP2Subtitle = megaMenuMujer?.promo2?.subtitle ? (isEn ? (megaMenuMujer.promo2.subtitleEn || megaMenuMujer.promo2.subtitle) : megaMenuMujer.promo2.subtitle) : (isEn ? "Limited Edition" : "Edición Limitada");
const wP2RawLink = megaMenuMujer?.promo2?.linkUrl || 'mujer';
const wP2Link = wP2RawLink.startsWith('/') ? wP2RawLink : `/${lang}/colecciones/${wP2RawLink}`;

// Helper to remove gender suffixes from collection/category names
const cleanTitle = (title: string): string => {
  return title
    .replace(/\s*(?:de|para|of|for)?\s*[-–—]?\s*(hombre|mujer|men|women)$/i, '')
    .trim();
};
---

<!-- Announcement Bar -->
<div class="bg-slate-950 text-white py-2 px-3 text-center text-[9px] sm:text-[10px] md:text-xs font-bold tracking-wider sm:tracking-widest uppercase w-full">
  {t('announcement.free_shipping')} <span id="announcement-free-shipping-amount">{((settings.freeShippingMin || 5000) / 100).toFixed(0)} €</span>
</div>

<!-- Header / Navbar (Full Width) -->
<header class="w-full bg-white border-b border-slate-100 sticky top-0 z-50 relative">
  <div class="w-full flex justify-between items-center py-5 px-4 min-[1500px]:px-8">
    <div class="flex items-center gap-1.5 sm:gap-3 min-[1500px]:w-1/4 shrink-0">
      <!-- Hamburger Toggle Button -->
      <button type="button" id="mobile-menu-btn" class="min-[1500px]:hidden text-slate-800 focus:outline-none p-1 shrink-0" aria-label="Abrir Menú">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>

      <!-- Mobile Search Icon (Magnifying Glass next to Hamburger) -->
      <button type="button" id="mobile-search-btn" class="min-[1500px]:hidden text-slate-700 hover:text-rose-650 transition-colors p-1 shrink-0 cursor-pointer focus:outline-none" aria-label={t('nav.search')}>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </button>
      
      <!-- Logo (Centered absolutely on mobile, normal in flex flow on desktop) -->
      <a href={`/${lang}`} class="absolute left-1/2 -translate-x-1/2 min-[1500px]:static min-[1500px]:translate-x-0 flex items-center gap-1 group z-10">
        {settings.logoUrl ? (
          <img src={settings.logoUrl} alt="FLEX FORM FITNESS" class="h-6 sm:h-8 md:h-10 w-auto object-contain" />
        ) : (
          <div class="flex flex-col">
            <span class="text-base sm:text-2xl md:text-3xl font-black italic tracking-tighter text-slate-955 uppercase leading-none">
              FLEX <span class="text-rose-600">FORM</span>
            </span>
            <span class="text-[7.5px] sm:text-[9px] md:text-[10px] font-extrabold tracking-[0.18em] sm:tracking-[0.25em] text-slate-400 uppercase leading-none mt-0.5 group-hover:text-red-600 transition-colors">
              FITNESS
            </span>
          </div>
        )}
      </a>
    </div>

    <!-- Main Navigation Links -->
    <nav class="hidden min-[1500px]:flex items-center justify-center gap-8 min-[1500px]:w-2/4">
      <a href={`/${lang}`} class="text-[13px] font-bold tracking-widest text-slate-955 hover:text-red-600 uppercase transition-colors">
        {t('nav.home')}
      </a>
      
      <!-- Hombre Mega Menu Dropdown -->
      <div class="py-2">
        <button type="button" id="men-dropdown-btn" class="text-[13px] font-bold tracking-widest text-slate-600 hover:text-rose-600 uppercase transition-all flex items-center gap-1 focus:outline-none cursor-pointer">
          {t('nav.men')}
          <svg id="men-dropdown-arrow" class="w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
        </button>

        <div id="men-mega-menu" class="absolute left-0 right-0 w-full top-full bg-white border-b border-slate-100 shadow-xl opacity-0 pointer-events-none transition-all duration-200 z-50 py-10 px-6 md:px-16">
          <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-10 text-left">
            <!-- Column 1: Section 1 -->
            <div class="flex flex-col gap-4">
              <span class="text-3xs font-extrabold text-slate-400 uppercase tracking-widest">{m1Title}</span>
              <div class="flex flex-col gap-2.5">
                <a href={`/${lang}/colecciones/hombre`} class="text-xs font-black tracking-wider uppercase text-rose-600 hover:text-rose-700 transition-colors flex items-center gap-2">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg>
                  {t('nav.view_all')}
                </a>
                {m1Collections.map((col) => (
                  <a href={`/${lang}/colecciones/hombre?cat=${col.id}`} class="text-xs font-bold tracking-wider uppercase text-slate-800 hover:text-rose-600 transition-colors flex items-center gap-2">
