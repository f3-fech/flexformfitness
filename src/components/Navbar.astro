              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-3">
                <span class="text-white text-3xs font-black tracking-wider uppercase">{wP1Title}</span>
                <span class="text-[8px] text-slate-300 font-bold uppercase tracking-widest mt-0.5">{wP1Subtitle}</span>
              </div>
              <a href={wP1Link} class="absolute inset-0 z-10" aria-label={wP1Title}></a>
            </div>
            <div class="group/img relative aspect-[16/10] rounded-xl overflow-hidden shadow-sm bg-slate-100 border border-slate-100 max-w-[280px]">
              <img src={wP2Image} alt={wP2Title} class="w-full h-full object-cover object-center" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-3">
                <span class="text-white text-3xs font-black tracking-wider uppercase">{wP2Title}</span>
                <span class="text-[8px] text-slate-300 font-bold uppercase tracking-widest mt-0.5">{wP2Subtitle}</span>
              </div>
              <a href={wP2Link} class="absolute inset-0 z-10" aria-label={wP2Title}></a>
            </div>
          </div>
        </div>
      </div>

      <!-- Expandable Collections accordion -->
      <div class="border-b border-slate-100/80 pb-4 pt-1 flex flex-col gap-3">
        <button type="button" id="mobile-coll-trigger" class="w-full flex justify-between items-center text-xs font-extrabold tracking-widest text-slate-900 hover:text-rose-600 uppercase cursor-pointer">
          <span>{t('nav.collections')}</span>
          <svg id="mobile-coll-arrow" class="w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobile-coll-list" class="flex flex-col gap-5 pl-3 mt-1 hidden transition-all">
          {s1Collections.length > 0 && (
            <div class="flex flex-col gap-2.5">
              <span class="text-3xs font-bold text-slate-400 uppercase tracking-widest block">{s1Title}</span>
              <div class="flex flex-col gap-2 pl-2 border-l border-slate-100">
                {s1Collections.map((col) => (
                  <a 
                    href={`/${lang}/colecciones/${col.slug}`} 
                    class="text-2xs font-semibold uppercase text-slate-700 hover:text-rose-600 transition-colors flex items-center gap-2"
                  >
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-300 shrink-0"></span>
                    {isEn ? (col.title_en || col.title) : col.title}
                  </a>
                ))}
              </div>
            </div>
          )}

          {s2Collections.length > 0 && (
            <div class="flex flex-col gap-2.5">
              <span class="text-3xs font-bold text-slate-400 uppercase tracking-widest block">{s2Title}</span>
              <div class="flex flex-col gap-2 pl-2 border-l border-slate-100">
                {s2Collections.map((col) => (
                  <a 
                    href={`/${lang}/colecciones/${col.slug}`} 
                    class="text-2xs font-semibold uppercase text-slate-700 hover:text-rose-600 transition-colors flex items-center gap-2"
                  >
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-300 shrink-0"></span>
                    {isEn ? (col.title_en || col.title) : col.title}
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="flex flex-col gap-4 mt-2">
            <div class="group/img relative aspect-[16/10] rounded-xl overflow-hidden shadow-sm bg-slate-100 border border-slate-100 max-w-[280px]">
              <img src={p1Image} alt={p1Title} class="w-full h-full object-cover object-center" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-3">
                <span class="text-white text-3xs font-black tracking-wider uppercase">{p1Title}</span>
                <span class="text-[8px] text-slate-300 font-bold uppercase tracking-widest mt-0.5">{p1Subtitle}</span>
              </div>
              <a href={p1Link} class="absolute inset-0 z-10" aria-label={p1Title}></a>
            </div>

            <div class="group/img relative aspect-[16/10] rounded-xl overflow-hidden shadow-sm bg-slate-100 border border-slate-100 max-w-[280px]">
              <img src={p2Image} alt={p2Title} class="w-full h-full object-cover object-center" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-3">
                <span class="text-white text-3xs font-black tracking-wider uppercase">{p2Title}</span>
                <span class="text-[8px] text-slate-300 font-bold uppercase tracking-widest mt-0.5">{p2Subtitle}</span>
              </div>
              <a href={p2Link} class="absolute inset-0 z-10" aria-label={p2Title}></a>
            </div>
          </div>
        </div>
      </div>

      <div class="border-b border-slate-100/80 pb-4 pt-1">
        <a href={`/${lang}/synergies`} class="text-xs font-black tracking-widest text-slate-900 hover:text-rose-600 uppercase flex items-center justify-between">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-rose-600 animate-pulse"></span>
            {t('nav.synergies')}
          </span>
          <span class="text-[9px] bg-rose-600 text-white font-extrabold px-1.5 py-0.5 rounded tracking-wider">SOON</span>
        </a>
      </div>

      <div class="border-b border-slate-100/80 pb-4 pt-1">
        <a href={`/${lang}/contacto`} class="text-xs font-extrabold tracking-widest text-slate-900 hover:text-rose-600 uppercase block">
          {t('nav.contact')}
        </a>
      </div>
    </div>

    <!-- Drawer Footer (Dynamic client-side hydration container) -->
    <div id="mobile-drawer-user-section" class="p-6 border-t border-slate-100 bg-slate-50 flex flex-col gap-4 text-xs font-extrabold tracking-widest uppercase">
      {user ? (
        <div class="flex items-center gap-2 w-full">
          <a href={`/${lang}/mi-cuenta`} class="flex-1 text-center bg-slate-900 hover:bg-rose-600 text-white py-2.5 px-4 rounded-lg transition-colors shadow-2xs text-xs font-extrabold tracking-widest uppercase">
            {isEn ? 'My Account' : 'Mi Cuenta'}
          </a>
          <a href="/api/auth/logout" class="w-10 h-10 shrink-0 bg-white hover:bg-rose-50 border border-slate-200 hover:border-rose-300 text-slate-700 hover:text-rose-600 rounded-lg flex items-center justify-center transition-colors" title={isEn ? 'Sign Out' : 'Cerrar Sesión'}>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
            </svg>
          </a>
        </div>
      ) : (
        <a href={`/${lang}/login`} class="block text-center bg-slate-900 hover:bg-rose-600 text-white py-2.5 rounded-lg transition-colors shadow-2xs text-xs font-extrabold tracking-widest uppercase">
          {t('nav.signin')}
        </a>
      )}
    </div>
  </div>
</div>

<!-- Custom Styled Logout Confirmation Modal -->
<div id="logout-modal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-md z-[120] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-200">
  <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-sm w-full shadow-2xl border border-slate-100 flex flex-col items-center text-center gap-5 scale-95 transition-transform duration-200" id="logout-modal-pane">
    <!-- Logout Icon Badge -->
    <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0 border border-rose-100 shadow-3xs">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
      </svg>
    </div>

    <!-- Text Content -->
    <div class="flex flex-col gap-1.5">
      <h3 class="text-lg font-black text-slate-950 tracking-tight">
        {isEn ? "Sign Out" : "Cerrar Sesión"}
      </h3>
      <p class="text-xs text-slate-500 font-medium leading-relaxed">
        {isEn ? "Are you sure you want to sign out of your account?" : "¿Estás seguro de que deseas cerrar sesión en tu cuenta?"}
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center gap-3 w-full pt-1">
      <button
        type="button"
        id="cancel-logout-btn"
        class="flex-1 py-3 px-4 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-extrabold uppercase tracking-wider transition-colors cursor-pointer"
      >
        {isEn ? "Cancel" : "Cancelar"}
      </button>
      <button
        type="button"
        id="confirm-logout-btn"
        class="flex-1 py-3 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-extrabold uppercase tracking-wider transition-colors shadow-sm cursor-pointer"
      >
        {isEn ? "Sign Out" : "Cerrar Sesión"}
      </button>
    </div>
  </div>
</div>

<!-- Full-screen Search & Catalog Modal -->
<div id="search-modal" class="fixed inset-0 bg-white z-[100] w-screen h-screen min-h-screen flex flex-col opacity-0 pointer-events-none transition-all duration-300 overflow-y-auto">
  
  <!-- Sticky Header Bar (Search Input Bar) -->
  <header class="w-full bg-white border-b border-slate-100 py-3.5 px-3 sm:px-6 md:px-8 sticky top-0 z-[120] flex items-center justify-between shadow-2xs">
    <div class="w-full max-w-[1720px] mx-auto flex items-center gap-3 md:gap-4">
      <button type="button" id="close-search-modal" class="text-slate-700 hover:text-rose-600 transition-colors p-2 cursor-pointer focus:outline-none flex items-center shrink-0" title={isEn ? "Back" : "Volver"}>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
      </button>

      <div class="flex-1 relative flex items-center">
        <svg class="w-5 h-5 text-slate-400 absolute left-3 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          id="search-modal-input"
          placeholder={isEn ? "What are you looking for?" : "¿Qué estás buscando?"}
          class="w-full bg-slate-50 hover:bg-slate-100/70 focus:bg-white border border-slate-200 focus:border-rose-600 rounded-full py-2.5 pl-10 pr-10 text-slate-900 text-sm sm:text-base font-bold placeholder-slate-400 focus:outline-none transition-colors"
        />
        <button type="button" id="search-modal-clear" class="absolute right-3 text-slate-400 hover:text-slate-800 text-xl font-bold w-6 h-6 flex items-center justify-center rounded-full hover:bg-slate-200 hidden cursor-pointer leading-none" title={isEn ? "Clear Search" : "Limpiar búsqueda"}>
          ×
        </button>
      </div>

      <button type="button" id="close-search-modal-text" class="hidden sm:block text-xs font-black uppercase tracking-wider text-slate-600 hover:text-rose-600 px-2 py-1 transition-colors cursor-pointer">
        {isEn ? "Close" : "Cerrar"}
      </button>
    </div>
  </header>

  <!-- Mobile Toolbar Sub-header (Shown on mobile / tablet < 1024px) -->
  <div class="w-full bg-white border-b border-slate-200 sticky top-[61px] sm:top-[69px] z-[110] flex min-[1024px]:hidden items-stretch text-center font-bold text-xs uppercase tracking-wider text-slate-800 select-none shadow-2xs">
    <!-- Clasificar (Sort) button -->
    <button type="button" id="mobile-sort-btn" class="flex-1 py-3 px-2 flex items-center justify-center gap-2 hover:bg-slate-50 border-r border-slate-200 cursor-pointer active:bg-slate-100 transition-colors">
      <span>{isEn ? "Sort" : "Clasificar"}</span>
      <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5L7.5 3m0 0L12 7.5M7.5 3v13.5m13.5 0L16.5 21m0 0L12 16.5m4.5 4.5V7.5" />
      </svg>
    </button>

    <!-- Products Count in Center -->
    <div id="mobile-products-count" class="flex-1 py-3 px-2 flex items-center justify-center text-slate-500 font-bold border-r border-slate-200 select-none">
      0 {isEn ? "products" : "productos"}
    </div>

    <!-- Filtrar (Filter) button -->
    <button type="button" id="mobile-filter-btn" class="flex-1 py-3 px-2 flex items-center justify-center gap-2 hover:bg-slate-50 cursor-pointer active:bg-slate-100 transition-colors">
      <span>{isEn ? "Filter" : "Filtrar"}</span>
      <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <span id="mobile-filter-badge" class="min-w-4 h-4 px-1 rounded-full bg-rose-600 text-white text-[9px] font-black inline-flex items-center justify-center hidden">0</span>
    </button>
  </div>

  <!-- Modal Main Content Area -->
  <main class="flex-grow w-full bg-white px-2 sm:px-4 md:px-8 py-6">
    <div class="w-full max-w-[1720px] mx-auto flex flex-col min-[1024px]:flex-row gap-8 items-start">
      
      <!-- DESKTOP FILTER SIDEBAR (Hidden on mobile) -->
      <aside class="search-filter-sidebar w-64 xl:w-72 shrink-0 hidden min-[1024px]:flex flex-col gap-6 select-none pr-4 border-r border-slate-100 min-[1024px]:sticky min-[1024px]:top-[88px] min-[1024px]:self-start min-[1024px]:max-h-[calc(100vh-104px)] min-[1024px]:overflow-y-auto min-[1024px]:z-30">
        <!-- Sidebar Title & Clear All -->
        <div class="flex items-center justify-between pb-3 border-b border-slate-200">
          <span class="text-xs font-black uppercase tracking-widest text-slate-900">
            {isEn ? "FILTER & SORT" : "FILTRAR Y ORDENAR"}
          </span>
          <button type="button" class="btn-clear-all-filters text-2xs font-bold text-slate-500 hover:text-rose-600 underline cursor-pointer transition-colors">
            {isEn ? "Clear all" : "Borrar todo"}
          </button>
        </div>

        <!-- Filter Accordions -->
        <div class="flex flex-col divide-y divide-slate-100">
          
          <!-- Accordion 1: Ordenar Por (Open by default) -->
          <div class="filter-acc-group py-3" data-acc="sort">
            <button type="button" class="filter-acc-btn w-full flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-900 hover:text-rose-600 cursor-pointer">
              <span>{isEn ? "Sort By" : "Ordenar Por"}</span>
              <svg class="filter-acc-icon w-3.5 h-3.5 text-slate-400 transform transition-transform duration-200 rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="filter-acc-body flex flex-col gap-2.5 pt-3 text-xs text-slate-700">
              <label class="flex items-center gap-2.5 cursor-pointer hover:text-slate-950">
                <input type="radio" name="desktop-sort" value="price-asc" class="sort-radio accent-rose-600 w-3.5 h-3.5 cursor-pointer" />
                <span>{isEn ? "Price: Low to High" : "Precio: de menor a mayor"}</span>
              </label>
              <label class="flex items-center gap-2.5 cursor-pointer hover:text-slate-950">
                <input type="radio" name="desktop-sort" value="price-desc" class="sort-radio accent-rose-600 w-3.5 h-3.5 cursor-pointer" />
                <span>{isEn ? "Price: High to Low" : "Precio: De mayor a menor"}</span>
              </label>
              <label class="flex items-center gap-2.5 cursor-pointer hover:text-slate-950">
                <input type="radio" name="desktop-sort" value="relevance" checked class="sort-radio accent-rose-600 w-3.5 h-3.5 cursor-pointer" />
                <span>{isEn ? "Relevance" : "Relevancia"}</span>
              </label>
              <label class="flex items-center gap-2.5 cursor-pointer hover:text-slate-950">
                <input type="radio" name="desktop-sort" value="newest" class="sort-radio accent-rose-600 w-3.5 h-3.5 cursor-pointer" />
                <span>{isEn ? "Newest" : "Más reciente"}</span>
              </label>
            </div>
          </div>

          <!-- Accordion 2: Tipo De Producto -->
          <div class="filter-acc-group py-3" data-acc="types">
            <button type="button" class="filter-acc-btn w-full flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-900 hover:text-rose-600 cursor-pointer">
              <span>{isEn ? "Product Type" : "Tipo De Producto"}</span>
              <svg class="filter-acc-icon w-3.5 h-3.5 text-slate-400 transform transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="filter-acc-body hidden flex flex-col gap-2.5 pt-3 text-xs text-slate-700">
              {["Camisetas", "Tirantes", "Sudaderas", "Leggings", "Tops Deportivos", "Pantalones", "Otras prendas"].map((type) => (
                <label class="flex items-center gap-2.5 cursor-pointer hover:text-slate-950">
                  <input type="checkbox" class="filter-cb accent-rose-600 rounded text-rose-600 w-3.5 h-3.5 border-slate-300 cursor-pointer" data-group="types" data-value={type} />
                  <span>{type}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Accordion 3: Tamaño -->
          <div class="filter-acc-group py-3" data-acc="sizes">
            <button type="button" class="filter-acc-btn w-full flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-900 hover:text-rose-600 cursor-pointer">
              <span>{isEn ? "Size" : "Tamaño"}</span>
              <svg class="filter-acc-icon w-3.5 h-3.5 text-slate-400 transform transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="filter-acc-body hidden pt-3">
              <div class="grid grid-cols-4 gap-1.5">
                {["XS", "S", "M", "L", "XL", "XXL", "3XL", "4XL"].map((sz) => (
                  <button
                    type="button"
                    class="filter-size-btn border border-slate-200 py-1.5 text-2xs font-extrabold uppercase rounded-md text-slate-700 hover:border-slate-950 hover:text-slate-950 cursor-pointer text-center transition-all"
                    data-group="sizes"
                    data-value={sz}
                  >
                    {sz}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <!-- Accordion 4: Características -->
          <div class="filter-acc-group py-3" data-acc="features">
            <button type="button" class="filter-acc-btn w-full flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-900 hover:text-rose-600 cursor-pointer">
              <span>{isEn ? "Features" : "Características"}</span>
              <svg class="filter-acc-icon w-3.5 h-3.5 text-slate-400 transform transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="filter-acc-body hidden flex flex-col gap-2.5 pt-3 text-xs text-slate-700">
              {["Oversized", "Tirantes", "Cropped", "Manga Corta", "Manga 3/4"].map((feat) => (
                <label class="flex items-center gap-2.5 cursor-pointer hover:text-slate-950">
                  <input type="checkbox" class="filter-cb accent-rose-600 rounded text-rose-600 w-3.5 h-3.5 border-slate-300 cursor-pointer" data-group="features" data-value={feat} />
                  <span>{feat}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Accordion 5: Ajustar (Fit) -->
          <div class="filter-acc-group py-3" data-acc="fits">
            <button type="button" class="filter-acc-btn w-full flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-900 hover:text-rose-600 cursor-pointer">
              <span>{isEn ? "Fit" : "Ajustar"}</span>
              <svg class="filter-acc-icon w-3.5 h-3.5 text-slate-400 transform transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="filter-acc-body hidden flex flex-col gap-2.5 pt-3 text-xs text-slate-700">
              {["Superoversized", "Oversized", "Cropped", "Body Fit", "Regular Fit"].map((fit) => (
                <label class="flex items-center gap-2.5 cursor-pointer hover:text-slate-950">
                  <input type="checkbox" class="filter-cb accent-rose-600 rounded text-rose-600 w-3.5 h-3.5 border-slate-300 cursor-pointer" data-group="fits" data-value={fit} />
                  <span>{fit}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Accordion 6: Actividad / Género -->
          <div class="filter-acc-group py-3" data-acc="genders">
            <button type="button" class="filter-acc-btn w-full flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-900 hover:text-rose-600 cursor-pointer">
              <span>{isEn ? "Activity / Gender" : "Actividad"}</span>
              <svg class="filter-acc-icon w-3.5 h-3.5 text-slate-400 transform transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="filter-acc-body hidden flex flex-col gap-2.5 pt-3 text-xs text-slate-700">
              {["Hombre", "Mujer"].map((g) => (
                <label class="flex items-center gap-2.5 cursor-pointer hover:text-slate-950">
                  <input type="checkbox" class="filter-cb accent-rose-600 rounded text-rose-600 w-3.5 h-3.5 border-slate-300 cursor-pointer" data-group="genders" data-value={g} />
                  <span>{g}</span>
                </label>
              ))}
