<script id="navbar-products-data" is:inline type="application/json" set:html={JSON.stringify(minProducts)}></script>
<script id="navbar-collections-data" is:inline type="application/json" set:html={JSON.stringify(minCollections)}></script>

<script>
  import { cartStore } from '../stores/cart';
  import { auth } from '../lib/firebaseClient';
  import { onAuthStateChanged } from 'firebase/auth';

  // Helper to read language dynamically from route pathname segment
  function getLang() {
    const segs = window.location.pathname.split('/');
    return (segs[1] === 'en' || segs[1] === 'es') ? segs[1] : 'es';
  }

  // Custom Logout Confirmation Modal logic
  const logoutModal = document.getElementById('logout-modal');
  const logoutModalPane = document.getElementById('logout-modal-pane');
  const cancelLogoutBtn = document.getElementById('cancel-logout-btn');
  const confirmLogoutBtn = document.getElementById('confirm-logout-btn');

  const openLogoutModal = () => {
    if (logoutModal && logoutModalPane) {
      logoutModal.classList.remove('opacity-0', 'pointer-events-none');
      logoutModal.classList.add('opacity-100', 'pointer-events-auto');
      logoutModalPane.classList.remove('scale-95');
      logoutModalPane.classList.add('scale-100');
    }
  };

  const closeLogoutModal = () => {
    if (logoutModal && logoutModalPane) {
      logoutModal.classList.remove('opacity-100', 'pointer-events-auto');
      logoutModal.classList.add('opacity-0', 'pointer-events-none');
      logoutModalPane.classList.remove('scale-100');
      logoutModalPane.classList.add('scale-95');
    }
  };

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const logoutLink = target.closest('a[href="/api/auth/logout"]');
    if (logoutLink) {
      e.preventDefault();
      openLogoutModal();
    }
  });

  cancelLogoutBtn?.addEventListener('click', closeLogoutModal);
  logoutModal?.addEventListener('click', (e) => {
    if (e.target === logoutModal) {
      closeLogoutModal();
    }
  });

  confirmLogoutBtn?.addEventListener('click', async () => {
    try {
      const { signOut } = await import('firebase/auth');
      await signOut(auth);
    } catch (err) {
      console.error('Error signing out client-side:', err);
    }
    window.location.href = '/api/auth/logout';
  });

  // Language switching script
  document.querySelectorAll('.lang-switch-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetLang = btn.getAttribute('data-lang') || 'es';
      
      const pathname = window.location.pathname;
      const segments = pathname.split('/');
      
      if (segments[1] === 'es' || segments[1] === 'en') {
        segments[1] = targetLang;
      } else {
        segments.splice(1, 0, targetLang);
      }
      
      window.location.pathname = segments.join('/');
    });
  });

  // Listen to client-side auth state to update navbar dynamically on static pre-rendered routes
  onAuthStateChanged(auth, (usr) => {
    const desktopContainer = document.getElementById('nav-user-section');
    const mobileContainer = document.getElementById('mobile-drawer-user-section');
    const lang = getLang();
    const isEn = lang === 'en';
    
    if (usr) {
      const name = usr.displayName || usr.email?.split('@')[0] || 'Usuario';
      
      if (desktopContainer) {
        desktopContainer.innerHTML = `
          <a href="/${lang}/mi-cuenta" class="text-slate-700 hover:text-rose-600 transition-colors relative flex items-center shrink-0" title="${isEn ? 'Connected as' : 'Conectado como'} ${name}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
            <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-emerald-500 border border-white animate-pulse"></span>
          </a>
        `;
      }
      
      if (mobileContainer) {
        mobileContainer.innerHTML = `
          <div class="flex items-center gap-2 w-full">
            <a href="/${lang}/mi-cuenta" class="flex-1 text-center bg-slate-900 hover:bg-rose-600 text-white py-2.5 px-4 rounded-lg transition-colors shadow-2xs text-xs font-extrabold tracking-widest uppercase">
              ${isEn ? 'My Account' : 'Mi Cuenta'}
            </a>
            <a href="/api/auth/logout" class="w-10 h-10 shrink-0 bg-white hover:bg-rose-50 border border-slate-200 hover:border-rose-300 text-slate-700 hover:text-rose-600 rounded-lg flex items-center justify-center transition-colors" title="${isEn ? 'Sign Out' : 'Cerrar Sesión'}">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
              </svg>
            </a>
          </div>
        `;
      }
    } else {
      if (desktopContainer) {
        desktopContainer.innerHTML = `
          <a href="/${lang}/login" class="text-slate-700 hover:text-rose-600 transition-colors relative flex items-center shrink-0" title="${isEn ? 'Sign In' : 'Iniciar sesión'}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
            <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-slate-350 border border-white"></span>
          </a>
        `;
      }
      
      if (mobileContainer) {
        mobileContainer.innerHTML = `
          <a href="/${lang}/login" class="block text-center bg-slate-900 hover:bg-rose-600 text-white py-2.5 rounded-lg transition-colors shadow-2xs text-xs font-extrabold tracking-widest uppercase">
            ${isEn ? 'Sign In' : 'Iniciar Sesión'}
          </a>
        `;
      }
    }
  });

  // Update cart count badge in navbar dynamically
  const updateCartBadge = (cart: Record<string, any>) => {
    const count = Object.values(cart).reduce((sum: number, item: any) => sum + (item.quantity || 0), 0);
    const badge = document.getElementById('cart-badge');
    if (badge) {
      badge.textContent = String(count);
      if (count === 0) {
        badge.classList.add('hidden');
      } else {
        badge.classList.remove('hidden');
      }
    }
  };

  cartStore.subscribe((cart) => {
    updateCartBadge(cart);
  });

  window.addEventListener('pageshow', () => {
    updateCartBadge(cartStore.get());
  });

  // Control desktop dropdown behavior for mega menus
  function setupDropdown(btnId: string, dropdownId: string, arrowId: string) {
    const btn = document.getElementById(btnId);
    const dropdown = document.getElementById(dropdownId);
    const arrow = document.getElementById(arrowId);
    
    if (btn && dropdown) {
      const closeOtherDropdowns = () => {
        ['collections-mega-menu', 'men-mega-menu', 'women-mega-menu'].forEach(id => {
          if (id !== dropdownId) {
            const other = document.getElementById(id);
            if (other) {
              other.classList.remove('opacity-100', 'pointer-events-auto');
              other.classList.add('opacity-0', 'pointer-events-none');
            }
          }
        });
        ['collections-dropdown-arrow', 'men-dropdown-arrow', 'women-dropdown-arrow'].forEach(id => {
          if (id !== arrowId) {
            const otherArrow = document.getElementById(id);
            if (otherArrow) otherArrow.classList.remove('rotate-180', 'text-rose-600');
          }
        });
      };

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isClosed = dropdown.classList.contains('opacity-0');
        closeOtherDropdowns();

        if (isClosed) {
          dropdown.classList.remove('opacity-0', 'pointer-events-none');
          dropdown.classList.add('opacity-100', 'pointer-events-auto');
          if (arrow) arrow.classList.add('rotate-180', 'text-rose-600');
        } else {
          dropdown.classList.remove('opacity-100', 'pointer-events-auto');
          dropdown.classList.add('opacity-0', 'pointer-events-none');
          if (arrow) arrow.classList.remove('rotate-180', 'text-rose-600');
        }
      });

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!dropdown.contains(target) && !btn.contains(target)) {
          dropdown.classList.remove('opacity-100', 'pointer-events-auto');
          dropdown.classList.add('opacity-0', 'pointer-events-none');
          if (arrow) arrow.classList.remove('rotate-180', 'text-rose-600');
        }
      });
    }
  }

  setupDropdown('collections-dropdown-btn', 'collections-mega-menu', 'collections-dropdown-arrow');
  setupDropdown('men-dropdown-btn', 'men-mega-menu', 'men-dropdown-arrow');
  setupDropdown('women-dropdown-btn', 'women-mega-menu', 'women-dropdown-arrow');

  // Control Mobile Drawer Open/Close
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mobileDrawerPane = document.getElementById('mobile-drawer-pane');
  const closeDrawerBtn = document.getElementById('close-mobile-drawer');
  
  if (mobileBtn && mobileDrawer && mobileDrawerPane) {
    const openDrawer = () => {
      mobileDrawer.classList.remove('opacity-0', 'pointer-events-none');
      mobileDrawer.classList.add('opacity-100', 'pointer-events-auto');
      mobileDrawerPane.classList.remove('translate-x-[-100%]');
      mobileDrawerPane.classList.add('translate-x-0');
      document.body.style.overflow = 'hidden';
    };

    const closeDrawer = () => {
      mobileDrawer.classList.add('opacity-0', 'pointer-events-none');
      mobileDrawer.classList.remove('opacity-100', 'pointer-events-auto');
      mobileDrawerPane.classList.remove('translate-x-0');
      mobileDrawerPane.classList.add('translate-x-[-100%]');
      document.body.style.overflow = '';
    };

    mobileBtn.addEventListener('click', openDrawer);
    closeDrawerBtn?.addEventListener('click', closeDrawer);
    mobileDrawer.addEventListener('click', (e) => {
      if (e.target === mobileDrawer) closeDrawer();
    });
  }

  // Mobile accordions toggle
  function setupAccordion(triggerId: string, listId: string, arrowId: string) {
    const trigger = document.getElementById(triggerId);
    const list = document.getElementById(listId);
    const arrow = document.getElementById(arrowId);

    if (trigger && list) {
      trigger.addEventListener('click', () => {
        const isHidden = list.classList.contains('hidden');
        if (isHidden) {
          list.classList.remove('hidden');
          if (arrow) arrow.classList.add('rotate-180', 'text-rose-600');
        } else {
          list.classList.add('hidden');
          if (arrow) arrow.classList.remove('rotate-180', 'text-rose-600');
        }
      });
    }
  }

  setupAccordion('mobile-men-trigger', 'mobile-men-list', 'mobile-men-arrow');
  setupAccordion('mobile-women-trigger', 'mobile-women-list', 'mobile-women-arrow');
  setupAccordion('mobile-coll-trigger', 'mobile-coll-list', 'mobile-coll-arrow');

  // Sync Announcement Bar with live settings from admin
  (async function syncAnnouncementSettings() {
    try {
      const res = await fetch('/api/settings');
      if (res.ok) {
        const data = await res.json();
        if (typeof data.freeShippingMin === 'number') {
          const el = document.getElementById('announcement-free-shipping-amount');
          if (el) {
            el.textContent = `${(data.freeShippingMin / 100).toFixed(0)} €`;
          }
        }
      }
    } catch (e) {
      // Fallback to pre-rendered value
    }
  })();

  // Search Modal & Catalog Filters Client Logic
  (function() {
    const searchModal = document.getElementById('search-modal');
    const searchInput = document.getElementById('search-modal-input') as HTMLInputElement;
    const closeBtn = document.getElementById('close-search-modal');
    const closeTextBtn = document.getElementById('close-search-modal-text');
    const clearBtn = document.getElementById('search-modal-clear');
    const emptyState = document.getElementById('search-modal-empty');
    const resultsGrid = document.getElementById('search-modal-grid');
    const sentinel = document.getElementById('search-infinite-sentinel');
    const sentinelSpinner = document.getElementById('search-infinite-spinner');

    const desktopCountEl = document.getElementById('desktop-products-count');
    const mobileCountEl = document.getElementById('mobile-products-count');
    const mobileFilterBadge = document.getElementById('mobile-filter-badge');
    const applyMobileFilterText = document.getElementById('apply-mobile-filter-text');
    const activeChipsContainer = document.getElementById('search-active-chips');

    // Mobile Drawers
    const mobileSortBtn = document.getElementById('mobile-sort-btn');
    const mobileSortDrawer = document.getElementById('mobile-sort-drawer');
    const mobileSortPane = document.getElementById('mobile-sort-pane');
    const closeMobileSortBtn = document.getElementById('close-mobile-sort');

    const mobileFilterBtn = document.getElementById('mobile-filter-btn');
    const mobileFilterDrawer = document.getElementById('mobile-filter-drawer');
    const mobileFilterPane = document.getElementById('mobile-filter-pane');
    const closeMobileFilterBtn = document.getElementById('close-mobile-filter');
    const applyMobileFilterBtn = document.getElementById('apply-mobile-filter');

    const productsDataEl = document.getElementById('navbar-products-data');
    const collectionsDataEl = document.getElementById('navbar-collections-data');
    const products: any[] = productsDataEl ? JSON.parse(productsDataEl.textContent || '[]') : [];
    const collections: any[] = collectionsDataEl ? JSON.parse(collectionsDataEl.textContent || '[]') : [];

    const mobileSearchTrigger = document.getElementById('mobile-search-btn');
    const desktopSearchTrigger = document.getElementById('desktop-search-btn');
    const lang = getLang();
    const isEn = lang === 'en';

    // State
    const state = {
      query: '',
      sort: 'relevance',
      types: new Set<string>(),
      sizes: new Set<string>(),
      features: new Set<string>(),
      fits: new Set<string>(),
      genders: new Set<string>(),
      collections: new Set<string>(),
      renderedCount: 0,
      batchSize: 12,
    };

    let filteredCache: any[] = [];
    let infiniteObserver: IntersectionObserver | null = null;

    function getObjectPosition(url: string | undefined): string {
      if (!url) return 'center';
      const match = url.match(/#pos=([a-zA-Z0-9%_-]+)/);
      if (match && match[1]) {
        return match[1].replace('_', ' ');
      }
      return 'center';
    }

    // Filter and Sort core
    function computeFilteredProducts(): any[] {
      const q = state.query.toLowerCase().trim();

      const filtered = products.filter((p) => {
        // Text query
        if (q) {
          const title = (isEn ? (p.title_en || p.title) : p.title).toLowerCase();
          const desc = (isEn ? (p.description_en || p.description) : p.description).toLowerCase();
          const matchTitle = title.includes(q);
          const matchDesc = desc.includes(q);
          const matchType = (p.productType || '').toLowerCase().includes(q);
          if (!matchTitle && !matchDesc && !matchType) return false;
        }

        // Type
        if (state.types.size > 0 && !state.types.has(p.productType)) {
          return false;
        }

        // Sizes
        if (state.sizes.size > 0) {
          const hasSize = (p.sizes || []).some((s: string) => state.sizes.has(s));
          if (!hasSize) return false;
        }

        // Features
        if (state.features.size > 0) {
          const hasFeat = (p.features || []).some((f: string) => state.features.has(f));
          if (!hasFeat) return false;
        }

        // Fits
        if (state.fits.size > 0 && !state.fits.has(p.fit)) {
          return false;
        }

        // Gender
        if (state.genders.size > 0 && !state.genders.has(p.gender)) {
          return false;
        }

        // Collections
        if (state.collections.size > 0) {
          const hasCol = (p.collectionIds || []).some((id: string) => state.collections.has(id));
          if (!hasCol) return false;
        }

        return true;
      });

      // Sorting
      if (state.sort === 'price-asc') {
        filtered.sort((a, b) => a.price - b.price);
      } else if (state.sort === 'price-desc') {
        filtered.sort((a, b) => b.price - a.price);
      } else if (state.sort === 'newest') {
        filtered.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
      }

      return filtered;
    }

    function renderProductCardHtml(p: any): string {
      const imageList = p.images && p.images.length > 0 ? p.images : ['/images/default-product.jpg'];
      const imagesSliderHtml = imageList.map((imgUrl: string, imgIdx: number) => `
        <a
          href="/${lang}/productos/${p.slug}"
          class="block w-full h-full shrink-0 snap-start snap-always relative overflow-hidden"
          data-index="${imgIdx}"
          style="aspect-ratio: 2/3;"
        >
          <img
            src="${imgUrl}"
            alt="${isEn ? (p.title_en || p.title) : p.title} - Vista ${imgIdx + 1}"
            class="w-full h-full object-cover group-hover:scale-[1.01] transition-opacity duration-300 opacity-0"
            style="object-position: ${getObjectPosition(imgUrl)}"
            loading="lazy"
            onload="this.classList.remove('opacity-0')"
          />
        </a>
      `).join('');

      const arrowsHtml = imageList.length > 1 ? `
        <button
          type="button"
          class="slider-arrow-left absolute left-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow-md opacity-0 group-hover/slider:opacity-100 transition-opacity active:scale-90 z-10 cursor-pointer hidden md:flex"
          title="${isEn ? 'Previous image' : 'Imagen anterior'}"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>
        <button
          type="button"
          class="slider-arrow-right absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-white/90 hover:bg-white text-slate-800 flex items-center justify-center shadow-md opacity-0 group-hover/slider:opacity-100 transition-opacity active:scale-90 z-10 cursor-pointer hidden md:flex"
          title="${isEn ? 'Next image' : 'Siguiente imagen'}"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>
      ` : '';

      const isOutOfStock = (p.stock !== undefined && p.stock <= 0);
      const stockWarningHtml = isOutOfStock ? `
        <span class="absolute top-2.5 left-2.5 px-2 py-0.5 bg-neutral-900 text-white text-[8px] md:text-[9px] font-bold uppercase tracking-wider z-10 border border-white/10">
          ${isEn ? 'SOLD OUT' : 'AGOTADO'}
        </span>
      ` : (p.stock <= 5 ? `
        <span class="absolute top-2.5 left-2.5 px-2 py-0.5 bg-rose-600 text-white text-[8px] md:text-[9px] font-bold uppercase tracking-wider z-10">
          ${isEn ? 'LAST ITEMS' : 'ÚLTIMAS UNIDADES'}
        </span>
      ` : '');

      const outOfStockCrossHtml = isOutOfStock ? `
        <svg class="absolute inset-0 w-full h-full pointer-events-none z-10" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <line x1="0" y1="0" x2="100" y2="100" stroke="rgba(15, 23, 42, 0.5)" stroke-width="1" vector-effect="non-scaling-stroke" style="filter: drop-shadow(0px 0px 1px rgba(255, 255, 255, 0.8));" />
          <line x1="100" y1="0" x2="0" y2="100" stroke="rgba(15, 23, 42, 0.5)" stroke-width="1" vector-effect="non-scaling-stroke" style="filter: drop-shadow(0px 0px 1px rgba(255, 255, 255, 0.8));" />
        </svg>
      ` : '';

      const priceTagHtml = `
        <span class="absolute bottom-1.5 right-1.5 sm:bottom-2.5 sm:right-2.5 px-1.5 py-0.5 sm:px-2.5 sm:py-1 bg-slate-950/85 backdrop-blur-xs text-white text-[10px] sm:text-xs font-extrabold font-mono rounded-none shadow-sm z-10 border border-white/10 select-none">
          ${(p.price / 100).toFixed(2)} €
        </span>
      `;

      return `
        <div class="product-card group flex flex-col justify-start w-full">
          <div class="relative aspect-[2/3] w-full bg-slate-50 border border-slate-100 overflow-hidden group/slider" style="aspect-ratio: 2/3; overflow: hidden;">
            <div class="product-images-slider flex w-full h-full overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-none ${isOutOfStock ? 'saturate-[0.85]' : ''}" style="scrollbar-width: none; -ms-overflow-style: none;">
              ${imagesSliderHtml}
            </div>
            ${arrowsHtml}
            ${outOfStockCrossHtml}
            ${stockWarningHtml}
            ${priceTagHtml}
          </div>

          <div class="mt-1.5 pt-1.5 md:mt-2 md:pt-2 border-t border-slate-200 flex flex-col items-center gap-1 w-full text-center">
            <a href="/${lang}/productos/${p.slug}" class="text-xs sm:text-sm md:text-base font-normal text-slate-900 hover:text-rose-600 transition-colors line-clamp-2 h-[2.4rem] sm:h-[2.5rem] md:h-[2.75rem] flex items-center justify-center text-center leading-tight sm:leading-tight overflow-hidden">
              ${isEn ? (p.title_en || p.title) : p.title}
            </a>
            
            <div class="flex items-center gap-1.5 justify-center min-h-[20px] md:min-h-[24px] mt-0.5">
              ${p.uniqueColors && p.uniqueColors.length > 0 ? p.uniqueColors.map((color: any) => `
                <button 
                  type="button"
                  class="color-swatch-btn w-4 h-4 md:w-5 md:h-5 rounded-none border border-slate-200/80 shadow-3xs hover:scale-110 active:scale-90 transition-transform cursor-pointer focus:outline-none" 
                  style="background-color: ${color.hex}"
                  title="${color.name}"
                  data-variant-image="${color.image || ''}"
                ></button>
              `).join('') : ''}
            </div>
          </div>
        </div>
      `;
    }

    function setupCardInteractions(card: HTMLElement) {
      if (!card || typeof card.querySelector !== 'function') return;
      const slider = card.querySelector('.product-images-slider') as HTMLDivElement;
      const arrowLeft = card.querySelector('.slider-arrow-left') as HTMLButtonElement;
      const arrowRight = card.querySelector('.slider-arrow-right') as HTMLButtonElement;
      const swatches = card.querySelectorAll('.color-swatch-btn') as NodeListOf<HTMLButtonElement>;

      if (slider) {
        arrowLeft?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          slider.scrollLeft -= slider.clientWidth;
        });

        arrowRight?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          slider.scrollLeft += slider.clientWidth;
        });
      }

      swatches.forEach((swatch) => {
        swatch.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          const imgUrl = swatch.dataset.variantImage;
          if (!imgUrl || !slider) return;

          const slides = Array.from(slider.querySelectorAll('img'));
          const matchedIndex = slides.findIndex((img) => {
            const src = img.getAttribute('src') || '';
            return src === imgUrl || img.src === imgUrl;
          });

          if (matchedIndex !== -1) {
            slider.scrollLeft = matchedIndex * slider.clientWidth;
          } else {
            const firstImg = slides[0];
            if (firstImg) {
              firstImg.src = imgUrl;
              slider.scrollLeft = 0;
            }
          }
        });
      });
    }

    function updateActiveChips() {
      if (!activeChipsContainer) return;
      activeChipsContainer.innerHTML = '';

      const makeChip = (label: string, onRemove: () => void) => {
        const chip = document.createElement('span');
        chip.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-800 text-2xs font-extrabold uppercase transition-colors';
        chip.innerHTML = `<span>${label}</span><button type="button" class="text-slate-400 hover:text-slate-900 font-black cursor-pointer leading-none">&times;</button>`;
        chip.querySelector('button')?.addEventListener('click', onRemove);
        activeChipsContainer.appendChild(chip);
      };

      state.types.forEach((t) => {
        makeChip(t, () => {
          state.types.delete(t);
          syncCheckboxes('types', t, false);
          applyFilterChanges();
        });
      });

      state.sizes.forEach((s) => {
        makeChip(s, () => {
          state.sizes.delete(s);
          syncSizeButtons(s, false);
          applyFilterChanges();
        });
      });

      state.features.forEach((f) => {
        makeChip(f, () => {
          state.features.delete(f);
          syncCheckboxes('features', f, false);
          applyFilterChanges();
        });
      });

      state.fits.forEach((ft) => {
        makeChip(ft, () => {
          state.fits.delete(ft);
          syncCheckboxes('fits', ft, false);
          applyFilterChanges();
        });
      });

      state.genders.forEach((g) => {
        makeChip(g, () => {
          state.genders.delete(g);
          syncCheckboxes('genders', g, false);
          applyFilterChanges();
        });
      });

      state.collections.forEach((colId) => {
        const c = collections.find((col) => col.id === colId);
        const colTitle = c ? (isEn ? (c.title_en || c.title) : c.title) : colId;
        makeChip(colTitle, () => {
          state.collections.delete(colId);
          syncCheckboxes('collections', colId, false);
          applyFilterChanges();
        });
      });
    }

    function syncCheckboxes(group: string, value: string, checked: boolean) {
      document.querySelectorAll<HTMLInputElement>(`.filter-cb[data-group="${group}"][data-value="${value}"]`).forEach((cb) => {
        cb.checked = checked;
      });
    }

    function syncSizeButtons(value: string, active: boolean) {
      document.querySelectorAll<HTMLButtonElement>(`.filter-size-btn[data-value="${value}"]`).forEach((btn) => {
        if (active) {
          btn.classList.add('bg-slate-950', 'text-white', 'border-slate-950');
          btn.classList.remove('text-slate-700', 'border-slate-200');
        } else {
          btn.classList.remove('bg-slate-950', 'text-white', 'border-slate-950');
          btn.classList.add('text-slate-700', 'border-slate-200');
        }
      });
    }

    function renderBatch(isReset: boolean) {
      if (!resultsGrid) return;

      if (isReset) {
        resultsGrid.innerHTML = '';
        state.renderedCount = 0;
      }

      const total = filteredCache.length;
      const countText = `${total} ${isEn ? (total === 1 ? 'product' : 'products') : (total === 1 ? 'producto' : 'productos')}`;
      if (desktopCountEl) desktopCountEl.textContent = countText;
      if (mobileCountEl) mobileCountEl.textContent = countText;
      if (applyMobileFilterText) {
        applyMobileFilterText.textContent = isEn ? `View ${total} products` : `Ver ${total} productos`;
      }

      // Update mobile badge
      const activeFilterCount = state.types.size + state.sizes.size + state.features.size + state.fits.size + state.genders.size + state.collections.size;
      if (mobileFilterBadge) {
        if (activeFilterCount > 0) {
          mobileFilterBadge.textContent = String(activeFilterCount);
          mobileFilterBadge.classList.remove('hidden');
        } else {
          mobileFilterBadge.classList.add('hidden');
        }
      }

      updateActiveChips();

      if (total === 0) {
        emptyState?.classList.remove('hidden');
        emptyState?.classList.add('flex');
        sentinel?.classList.add('hidden');
        return;
      }

      emptyState?.classList.add('hidden');
      emptyState?.classList.remove('flex');

      const nextBatch = filteredCache.slice(state.renderedCount, state.renderedCount + state.batchSize);
      if (nextBatch.length > 0) {
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = nextBatch.map(renderProductCardHtml).join('');
        
        Array.from(tempDiv.children).forEach((cardEl) => {
          resultsGrid.appendChild(cardEl);
          setupCardInteractions(cardEl as HTMLElement);
        });

        state.renderedCount += nextBatch.length;
      }

      // Sentinel control
      if (state.renderedCount < total) {
        sentinel?.classList.remove('hidden');
        sentinelSpinner?.classList.remove('hidden');
      } else {
        sentinel?.classList.add('hidden');
        sentinelSpinner?.classList.add('hidden');
      }
    }

    function applyFilterChanges(resetPaging: boolean = true) {
      filteredCache = computeFilteredProducts();
      renderBatch(resetPaging);
    }

    // Initialize Infinite Scroll observer
    if (sentinel) {
      infiniteObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && state.renderedCount < filteredCache.length) {
            renderBatch(false);
          }
        });
      }, { rootMargin: '200px' });
      infiniteObserver.observe(sentinel);
    }

    // Modal open / close handlers
    const openSearch = (e: Event) => {
      e.preventDefault();
      if (!searchModal) return;

      // Close mobile navigation drawer if open
      const mobileDrawer = document.getElementById('mobile-drawer');
      const mobileDrawerPane = document.getElementById('mobile-drawer-pane');
      if (mobileDrawer && mobileDrawerPane && !mobileDrawer.classList.contains('opacity-0')) {
        mobileDrawer.classList.add('opacity-0', 'pointer-events-none');
        mobileDrawer.classList.remove('opacity-100', 'pointer-events-auto');
        mobileDrawerPane.classList.remove('translate-x-0');
        mobileDrawerPane.classList.add('translate-x-[-100%]');
      }

      // Open animations
      searchModal.classList.remove('opacity-0', 'pointer-events-none');
      searchModal.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';

      // Automatically compute and render products immediately on opening!
      applyFilterChanges(true);

      setTimeout(() => searchInput?.focus(), 120);
    };

    const closeSearch = () => {
      if (!searchModal) return;
      searchModal.classList.add('opacity-0', 'pointer-events-none');
      searchModal.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
      closeMobileSort();
      closeMobileFilter();
    };

    mobileSearchTrigger?.addEventListener('click', openSearch);
    desktopSearchTrigger?.addEventListener('click', openSearch);
    closeBtn?.addEventListener('click', closeSearch);
    closeTextBtn?.addEventListener('click', closeSearch);

    // Search input typing
    searchInput?.addEventListener('input', () => {
      state.query = searchInput.value;
      if (state.query.trim()) {
        clearBtn?.classList.remove('hidden');
      } else {
        clearBtn?.classList.add('hidden');
      }
      applyFilterChanges(true);
    });

    clearBtn?.addEventListener('click', () => {
      searchInput.value = '';
      state.query = '';
      clearBtn.classList.add('hidden');
      searchInput.focus();
      applyFilterChanges(true);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !searchModal?.classList.contains('opacity-0')) {
        closeSearch();
      }
    });

    // Accordion expand / collapse
    document.querySelectorAll('.filter-acc-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const group = btn.closest('.filter-acc-group');
        const body = group?.querySelector('.filter-acc-body');
        const icon = btn.querySelector('.filter-acc-icon');
        if (body) {
          const isHidden = body.classList.contains('hidden');
          if (isHidden) {
            body.classList.remove('hidden');
            icon?.classList.add('rotate-180');
          } else {
            body.classList.add('hidden');
            icon?.classList.remove('rotate-180');
          }
        }
      });
    });

    // Checkbox event listener delegation
    document.addEventListener('change', (e) => {
      const target = e.target as HTMLElement;
      if (target && target.classList.contains('filter-cb')) {
        const cb = target as HTMLInputElement;
        const group = cb.dataset.group as 'types' | 'features' | 'fits' | 'genders' | 'collections';
        const val = cb.dataset.value || '';

        if (group && state[group]) {
          if (cb.checked) {
            state[group].add(val);
          } else {
            state[group].delete(val);
          }
          syncCheckboxes(group, val, cb.checked);
          applyFilterChanges(true);
        }
      }

      // Sort radio buttons (desktop & mobile synced)
      if (target && target.classList.contains('sort-radio')) {
        const radio = target as HTMLInputElement;
        state.sort = radio.value;
        document.querySelectorAll<HTMLInputElement>(`.sort-radio[value="${radio.value}"]`).forEach((r) => {
          r.checked = true;
        });
        applyFilterChanges(true);
        if (radio.name === 'mobile-sort') {
          closeMobileSort();
        }
      }
    });

    // Size buttons click handling (desktop & mobile)
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const sizeBtn = target.closest('.filter-size-btn') as HTMLButtonElement;
      if (sizeBtn) {
        const val = sizeBtn.dataset.value || '';
        if (state.sizes.has(val)) {
          state.sizes.delete(val);
          syncSizeButtons(val, false);
        } else {
          state.sizes.add(val);
          syncSizeButtons(val, true);
        }
        applyFilterChanges(true);
      }
    });

    // Clear all filters handlers
    const clearAllFilters = () => {
      state.types.clear();
      state.sizes.clear();
      state.features.clear();
      state.fits.clear();
      state.genders.clear();
      state.collections.clear();
      state.sort = 'relevance';
      state.query = '';
      if (searchInput) searchInput.value = '';
      clearBtn?.classList.add('hidden');

      document.querySelectorAll<HTMLInputElement>('.filter-cb').forEach((cb) => (cb.checked = false));
      document.querySelectorAll<HTMLButtonElement>('.filter-size-btn').forEach((btn) => {
        btn.classList.remove('bg-slate-950', 'text-white', 'border-slate-950');
        btn.classList.add('text-slate-700', 'border-slate-200');
      });
      document.querySelectorAll<HTMLInputElement>('.sort-radio[value="relevance"]').forEach((r) => (r.checked = true));

      applyFilterChanges(true);
    };

    document.querySelectorAll('.btn-clear-all-filters').forEach((btn) => {
      btn.addEventListener('click', clearAllFilters);
    });

    // Mobile Sort Drawer open/close
    const openMobileSort = () => {
      if (!mobileSortDrawer || !mobileSortPane) return;
      mobileSortDrawer.classList.remove('opacity-0', 'pointer-events-none');
      mobileSortDrawer.classList.add('opacity-100', 'pointer-events-auto');
      mobileSortPane.classList.remove('translate-y-full');
      mobileSortPane.classList.add('translate-y-0');
    };

    const closeMobileSort = () => {
      if (!mobileSortDrawer || !mobileSortPane) return;
      mobileSortPane.classList.remove('translate-y-0');
      mobileSortPane.classList.add('translate-y-full');
      mobileSortDrawer.classList.remove('opacity-100', 'pointer-events-auto');
      mobileSortDrawer.classList.add('opacity-0', 'pointer-events-none');
    };

    mobileSortBtn?.addEventListener('click', openMobileSort);
    closeMobileSortBtn?.addEventListener('click', closeMobileSort);
    mobileSortDrawer?.addEventListener('click', (e) => {
      if (e.target === mobileSortDrawer) closeMobileSort();
    });

    // Mobile Filter Drawer open/close
    const openMobileFilter = () => {
      if (!mobileFilterDrawer || !mobileFilterPane) return;
      mobileFilterDrawer.classList.remove('opacity-0', 'pointer-events-none');
      mobileFilterDrawer.classList.add('opacity-100', 'pointer-events-auto');
      mobileFilterPane.classList.remove('translate-x-full');
      mobileFilterPane.classList.add('translate-x-0');
    };

    const closeMobileFilter = () => {
      if (!mobileFilterDrawer || !mobileFilterPane) return;
      mobileFilterPane.classList.remove('translate-x-0');
      mobileFilterPane.classList.add('translate-x-full');
      mobileFilterDrawer.classList.remove('opacity-100', 'pointer-events-auto');
      mobileFilterDrawer.classList.add('opacity-0', 'pointer-events-none');
    };

    mobileFilterBtn?.addEventListener('click', openMobileFilter);
    closeMobileFilterBtn?.addEventListener('click', closeMobileFilter);
    applyMobileFilterBtn?.addEventListener('click', closeMobileFilter);
    mobileFilterDrawer?.addEventListener('click', (e) => {
      if (e.target === mobileFilterDrawer) closeMobileFilter();
    });
  })();
</script>

