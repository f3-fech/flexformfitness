                    {cleanTitle(isEn ? (col.title_en || col.title) : col.title)}
                  </a>
                ))}
              </div>
            </div>

            <!-- Column 2: Section 2 -->
            <div class="flex flex-col gap-4">
              <span class="text-3xs font-extrabold text-slate-400 uppercase tracking-widest">{m2Title}</span>
              <div class="flex flex-col gap-2.5">
                {m2Collections.map((col) => (
                  <a href={`/${lang}/colecciones/hombre?cat=${col.id}`} class="text-xs font-bold tracking-wider uppercase text-slate-800 hover:text-rose-600 transition-colors flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9" /></svg>
                    {cleanTitle(isEn ? (col.title_en || col.title) : col.title)}
                  </a>
                ))}
              </div>
            </div>

            <!-- Column 3: Promo 1 -->
            <div class="group/img relative aspect-[16/9] rounded-2xl overflow-hidden shadow-sm bg-slate-100 border border-slate-100">
              <img src={mP1Image} alt={mP1Title} class="w-full h-full object-cover object-center group-hover/img:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-4">
                <span class="text-white text-xs font-black tracking-wider uppercase">{mP1Title}</span>
                <span class="text-[10px] text-slate-300 font-bold uppercase tracking-widest mt-0.5">{mP1Subtitle}</span>
              </div>
              <a href={mP1Link} class="absolute inset-0 z-10" aria-label={mP1Title}></a>
            </div>

            <!-- Column 4: Promo 2 -->
            <div class="group/img relative aspect-[16/9] rounded-2xl overflow-hidden shadow-sm bg-slate-100 border border-slate-100">
              <img src={mP2Image} alt={mP2Title} class="w-full h-full object-cover object-center group-hover/img:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-4">
                <span class="text-white text-xs font-black tracking-wider uppercase">{mP2Title}</span>
                <span class="text-[10px] text-slate-300 font-bold uppercase tracking-widest mt-0.5">{mP2Subtitle}</span>
              </div>
              <a href={mP2Link} class="absolute inset-0 z-10" aria-label={mP2Title}></a>
            </div>
          </div>
        </div>
      </div>

      <!-- Mujer Mega Menu Dropdown -->
      <div class="py-2">
        <button type="button" id="women-dropdown-btn" class="text-[13px] font-bold tracking-widest text-slate-600 hover:text-rose-600 uppercase transition-all flex items-center gap-1 focus:outline-none cursor-pointer">
          {t('nav.women')}
          <svg id="women-dropdown-arrow" class="w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
        </button>

        <div id="women-mega-menu" class="absolute left-0 right-0 w-full top-full bg-white border-b border-slate-100 shadow-xl opacity-0 pointer-events-none transition-all duration-200 z-50 py-10 px-6 md:px-16">
          <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-10 text-left">
            <!-- Column 1: Section 1 -->
            <div class="flex flex-col gap-4">
              <span class="text-3xs font-extrabold text-slate-400 uppercase tracking-widest">{w1Title}</span>
              <div class="flex flex-col gap-2.5">
                <a href={`/${lang}/colecciones/mujer`} class="text-xs font-black tracking-wider uppercase text-rose-600 hover:text-rose-700 transition-colors flex items-center gap-2">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg>
                  {t('nav.view_all')}
                </a>
