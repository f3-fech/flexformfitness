---
export const prerender = false;

import { db } from '../../lib/firebase';
import SEO from '../../components/SEO.astro';
import Navbar from '../../components/Navbar.astro';
import { decrypt, decryptAddress } from '../../lib/crypto';

const { lang } = Astro.params;
const isEn = lang === 'en';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/${lang}/login`);
}

// Fetch user orders
let orders: any[] = [];
try {
  const ordersSnap = await db.collection('orders')
    .where('customerDetails.email', '==', user.email)
    .get();
  
  if (!ordersSnap.empty) {
    orders = ordersSnap.docs.map((doc) => ({ id: doc.id, ...doc.data() }));
    // Sort orders by date descending
    orders.sort((a, b) => {
      const dateA = a.createdAt?.toDate ? a.createdAt.toDate() : new Date(a.createdAt);
      const dateB = b.createdAt?.toDate ? b.createdAt.toDate() : new Date(b.createdAt);
      return dateB.getTime() - dateA.getTime();
    });
  }
} catch (e) {
  console.error('Error fetching orders for user:', e);
}

// Fetch customer profile
let customerProfile: any = {};
try {
  const customerDoc = await db.collection('customers').doc(user.uid).get();
  if (customerDoc.exists) {
    const data = customerDoc.data() || {};
    customerProfile = {
      ...data,
      phone: decrypt(data.phone),
      address: decryptAddress(data.address),
    };
  }
} catch (e) {
  console.error('Error fetching customer profile:', e);
}

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://flexformfitness.com';
const canonicalUrl = `${siteUrl}/${lang}/mi-cuenta`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <SEO
      title={isEn ? "My Account | FLEX FORM FITNESS" : "Mi Cuenta | FLEX FORM FITNESS"}
      description={isEn ? "Manage your profile details, shipping addresses and view your order history." : "Gestiona tus datos de perfil, direcciones de envío y consulta el historial de tus pedidos."}
      canonicalUrl={canonicalUrl}
      ogType="website"
    />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen antialiased flex flex-col justify-between w-full overflow-x-hidden">
    
    <Navbar />

    <!-- Hero Header -->
    <section class="w-full bg-slate-950 text-white py-10 px-4 md:px-8 border-b border-slate-800">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
        <div>
          <span class="text-[10px] font-mono font-bold uppercase tracking-[0.24em] text-slate-400 block mb-1">
            {isEn ? "USER DASHBOARD" : "PANEL DE USUARIO"}
          </span>
          <h1 class="text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-white leading-snug">
            {isEn ? "MY ACCOUNT" : "MI CUENTA"}
          </h1>
          <p class="text-slate-400 text-xs mt-1.5 font-normal">
            {isEn ? "Logged in as " : "Conectado como "}<span class="text-white font-semibold">{user.name}</span> ({user.email})
          </p>
        </div>
        
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-none border border-emerald-500/30 bg-emerald-950/30 text-emerald-400 text-[10px] font-mono font-bold tracking-widest uppercase">
            <span class="w-1.5 h-1.5 rounded-none bg-emerald-400"></span>
            {isEn ? "VERIFIED ACCOUNT" : "CUENTA VERIFICADA"}
          </span>
        </div>
      </div>
    </section>

    <!-- Main Content Grid -->
    <main class="w-full max-w-7xl mx-auto px-4 py-8 sm:py-10 flex-grow">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">
        
        <!-- Sidebar Navigation (3 cols) -->
        <aside class="account-nav-tabs lg:col-span-3 flex flex-row lg:flex-col overflow-x-auto lg:overflow-x-visible gap-1 bg-white border border-slate-200 p-2 sm:p-2.5 pb-2.5 lg:pb-2.5 rounded-none shadow-none w-full shrink-0 lg:min-h-[480px]">
          <button 
            type="button" 
            class="tab-btn px-4 py-3 rounded-none flex items-center gap-3 transition-colors text-left text-xs font-bold uppercase tracking-[0.14em] whitespace-nowrap bg-slate-100/80 text-slate-950 border-l-2 border-slate-950 select-none cursor-pointer w-full" 
            data-tab="tab-shipping"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"></path></svg>
            <span>{isEn ? "Shipping Info" : "Datos de Envío"}</span>
          </button>
          
          <button 
            type="button" 
            class="tab-btn px-4 py-3 rounded-none flex items-center gap-3 transition-colors text-left text-xs font-medium uppercase tracking-[0.14em] whitespace-nowrap text-slate-500 hover:text-slate-950 hover:bg-slate-50 border-l-2 border-transparent select-none cursor-pointer w-full" 
            data-tab="tab-orders"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"></path></svg>
            <span>{isEn ? "Orders" : "Mis Pedidos"}</span>
          </button>

          <button 
            type="button" 
            class="tab-btn px-4 py-3 rounded-none flex items-center gap-3 transition-colors text-left text-xs font-medium uppercase tracking-[0.14em] whitespace-nowrap text-slate-500 hover:text-slate-950 hover:bg-slate-50 border-l-2 border-transparent select-none cursor-pointer w-full" 
            data-tab="tab-newsletter"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"></path></svg>
            <span>{isEn ? "Newsletter" : "Suscripción"}</span>
          </button>

          <button 
            type="button" 
            class="tab-btn px-4 py-3 rounded-none flex items-center gap-3 transition-colors text-left text-xs font-medium uppercase tracking-[0.14em] whitespace-nowrap text-slate-500 hover:text-slate-950 hover:bg-slate-50 border-l-2 border-transparent select-none cursor-pointer w-full" 
            data-tab="tab-security"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"></path></svg>
            <span>{isEn ? "Security" : "Seguridad"}</span>
          </button>
        </aside>

        <!-- Right Side: Active Panel Container (9 cols) -->
        <div class="lg:col-span-9 w-full flex flex-col gap-6">
          
          <!-- Alert boxes -->
          <div id="error-box" class="hidden p-3 rounded-none bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium text-center leading-relaxed"></div>
          <div id="success-box" class="hidden p-3 rounded-none bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium text-center leading-relaxed"></div>

          <!-- PANEL 1: SHIPPING DETAILS -->
          <div id="tab-shipping" class="tab-panel bg-white border border-slate-200 shadow-none rounded-none p-6 sm:p-8 flex flex-col gap-6 lg:min-h-[480px]">
            <div class="border-b border-slate-200 pb-3">
              <h2 class="text-xs sm:text-sm font-bold text-slate-950 uppercase tracking-[0.18em]">
                {isEn ? "My Shipping Info" : "Mis Datos de Envío"}
              </h2>
              <p class="text-[11px] text-slate-500 mt-1">
                {isEn ? "Will auto-fill during checkout" : "Se auto-rellenarán al finalizar tu compra"}
              </p>
            </div>

            <form id="profile-form" class="flex flex-col gap-4">
              <div class="flex flex-col gap-1.5">
                <label for="form-name" class="block text-[10px] font-bold text-slate-700 uppercase tracking-[0.16em]">{isEn ? "Full Name" : "Nombre Completo"}</label>
                <input type="text" id="form-name" value={customerProfile.name || user.name || ''} class="w-full px-3.5 py-2.5 rounded-none border border-slate-300 bg-white placeholder-slate-400 text-slate-900 focus:outline-none focus:border-black transition-colors text-xs font-sans" required />
              </div>

              <div class="flex flex-col gap-1.5">
                <label for="form-phone" class="block text-[10px] font-bold text-slate-700 uppercase tracking-[0.16em]">{isEn ? "Contact Phone" : "Teléfono de Contacto"}</label>
                <input type="tel" id="form-phone" value={customerProfile.phone || ''} placeholder={isEn ? "e.g. +34 600 000 000" : "Ej: +34 600 000 000"} class="w-full px-3.5 py-2.5 rounded-none border border-slate-300 bg-white placeholder-slate-400 text-slate-900 focus:outline-none focus:border-black transition-colors text-xs font-mono" />
              </div>

              <div class="flex flex-col gap-1.5">
                <label for="form-address-1" class="block text-[10px] font-bold text-slate-700 uppercase tracking-[0.16em]">{isEn ? "Shipping Address" : "Dirección de Envío"}</label>
                <input type="text" id="form-address-1" value={customerProfile.address?.line1 || ''} placeholder={isEn ? "Street, number, floor..." : "Calle, número, piso..."} class="w-full px-3.5 py-2.5 rounded-none border border-slate-300 bg-white placeholder-slate-400 text-slate-900 focus:outline-none focus:border-black transition-colors text-xs font-sans" />
              </div>

              <div class="flex flex-col gap-1.5">
                <label for="form-address-2" class="block text-[10px] font-bold text-slate-700 uppercase tracking-[0.16em]">{isEn ? "Building, floor, etc. (Optional)" : "Portal, escalera, etc. (Opcional)"}</label>
                <input type="text" id="form-address-2" value={customerProfile.address?.line2 || ''} placeholder={isEn ? "e.g. Staircase B, 3rd C" : "Ej: Escalera B, 3º C"} class="w-full px-3.5 py-2.5 rounded-none border border-slate-300 bg-white placeholder-slate-400 text-slate-900 focus:outline-none focus:border-black transition-colors text-xs font-sans" />
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div class="flex flex-col gap-1.5">
                  <label for="form-city" class="block text-[10px] font-bold text-slate-700 uppercase tracking-[0.16em]">{isEn ? "City" : "Ciudad"}</label>
                  <input type="text" id="form-city" value={customerProfile.address?.city || ''} class="w-full px-3.5 py-2.5 rounded-none border border-slate-300 bg-white placeholder-slate-400 text-slate-900 focus:outline-none focus:border-black transition-colors text-xs font-sans" />
                </div>
                <div class="flex flex-col gap-1.5">
                  <label for="form-state" class="block text-[10px] font-bold text-slate-700 uppercase tracking-[0.16em]">{isEn ? "State / Region" : "Provincia / Región"}</label>
                  <input type="text" id="form-state" value={customerProfile.address?.state || ''} class="w-full px-3.5 py-2.5 rounded-none border border-slate-300 bg-white placeholder-slate-400 text-slate-900 focus:outline-none focus:border-black transition-colors text-xs font-sans" />
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div class="flex flex-col gap-1.5">
                  <label for="form-zip" class="block text-[10px] font-bold text-slate-700 uppercase tracking-[0.16em]">{isEn ? "Postal Code" : "Código Postal"}</label>
                  <input type="text" id="form-zip" value={customerProfile.address?.postal_code || ''} class="w-full px-3.5 py-2.5 rounded-none border border-slate-300 bg-white placeholder-slate-400 text-slate-900 focus:outline-none focus:border-black transition-colors text-xs font-mono" />
                </div>
                <div class="flex flex-col gap-1.5">
                  <label for="form-country" class="block text-[10px] font-bold text-slate-700 uppercase tracking-[0.16em]">{isEn ? "Country" : "País"}</label>
                  <input type="text" id="form-country" value={customerProfile.address?.country || (isEn ? 'Spain' : 'España')} class="w-full px-3.5 py-2.5 rounded-none border border-slate-300 bg-white placeholder-slate-400 text-slate-900 focus:outline-none focus:border-black transition-colors text-xs font-sans" />
                </div>
              </div>

              <button type="submit" id="save-btn" class="mt-2 w-full py-3.5 px-4 rounded-none bg-slate-950 hover:bg-slate-800 text-white font-bold text-xs tracking-[0.2em] uppercase transition-colors duration-150 cursor-pointer shadow-none active:scale-[0.99] flex items-center justify-center gap-2 select-none">
                <span>{isEn ? "Save Changes" : "Guardar Cambios"}</span>
              </button>
            </form>
          </div>

          <!-- PANEL 2: ORDER HISTORY -->
          <div id="tab-orders" class="tab-panel hidden bg-white border border-slate-200 shadow-none rounded-none p-6 sm:p-8 flex flex-col gap-6 lg:min-h-[480px]">
            <div class="border-b border-slate-200 pb-3">
              <h2 class="text-xs sm:text-sm font-bold text-slate-950 uppercase tracking-[0.18em]">
                {isEn ? "Order History" : "Historial de Pedidos"}
              </h2>
              <p class="text-[11px] text-slate-500 mt-1">
                {isEn ? "Check your purchases and delivery tracking status" : "Consulta tus compras y detalles de envío"}
              </p>
            </div>

            {orders.length > 0 ? (
              <div class="flex flex-col gap-5 max-h-[75vh] overflow-y-auto pr-1">
                {orders.map((order) => {
                  const date = order.createdAt?.toDate ? order.createdAt.toDate() : new Date(order.createdAt);
                  const dateString = date.toLocaleDateString(isEn ? 'en-US' : 'es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
                  const orderTotal = Number(order.totalAmount ?? order.amountTotal ?? order.total ?? 0) || 0;
                  
                  const actualShippingStatus = order.shippingStatus || 'pending';
                  const isDelivered = actualShippingStatus === 'delivered';
                  const isShipped = actualShippingStatus === 'shipped';

                  // Cálculo de los 14 días naturales desde la entrega física
                  let isWithinReturnWindow = false;
                  let daysRemaining = 0;
                  if (isDelivered) {
                    const deliveredDate = order.deliveredAt
                      ? new Date(order.deliveredAt)
                      : (order.updatedAt?.toDate ? order.updatedAt.toDate() : new Date(order.updatedAt || order.createdAt));
                    const daysSinceDelivery = Math.floor((Date.now() - deliveredDate.getTime()) / (1000 * 60 * 60 * 24));
                    daysRemaining = Math.max(0, 14 - daysSinceDelivery);
                    isWithinReturnWindow = daysSinceDelivery < 14;
                  }

                  return (
                    <div class="border border-slate-200 rounded-none overflow-hidden shadow-none">
                      <!-- Order Header -->
                      <div class="bg-slate-50 px-4 py-3 border-b border-slate-200 flex flex-wrap justify-between items-center gap-3">
                        <div class="flex flex-col gap-0.5">
                          <span class="text-[10px] font-mono font-bold text-slate-500 uppercase tracking-[0.14em]">{isEn ? "ORDER ID" : "ID PEDIDO"}</span>
                          <span class="text-xs font-mono font-bold text-slate-950 truncate max-w-[180px]" title={order.id}>{order.id}</span>
                        </div>
                        <div class="flex flex-col gap-0.5 text-right sm:text-left">
                          <span class="text-[10px] font-mono font-bold text-slate-500 uppercase tracking-[0.14em]">{isEn ? "DATE" : "FECHA"}</span>
                          <span class="text-xs font-medium text-slate-800">{dateString}</span>
                        </div>
                        <div class="flex flex-col gap-0.5 text-right">
                          <span class="text-[10px] font-mono font-bold text-slate-500 uppercase tracking-[0.14em]">TOTAL</span>
                          <span class="text-xs font-bold text-slate-950">{(orderTotal / 100).toFixed(2)} €</span>
                        </div>
                      </div>

                      <!-- Order Content -->
                      <div class="p-4 flex flex-col gap-4">
                        <!-- Products list inside the order -->
                        <div class="flex flex-col gap-3">
                          {order.items && order.items.map((item: any) => (
                            <div class="flex items-center gap-3">
                              <div class="w-12 h-14 rounded-none bg-slate-100 border border-slate-200 overflow-hidden shrink-0">
                                <img src={item.image || '/images/placeholder.jpg'} alt={item.name} class="w-full h-full object-cover" />
                              </div>
                              <div class="flex-grow min-w-0">
                                <span class="text-xs font-bold text-slate-900 block truncate leading-tight">{item.name}</span>
                                <span class="text-[11px] text-slate-500 font-normal tracking-wide">
                                  {isEn ? `Qty: ${item.quantity} · Price: ${(item.price / 100).toFixed(2)} €` : `Cantidad: ${item.quantity} · Precio: ${(item.price / 100).toFixed(2)} €`}
                                </span>
                              </div>
                            </div>
                          ))}
                        </div>

                        <!-- Delivery status & tracking -->
                        <div class="pt-3 border-t border-slate-200 flex flex-col gap-3">
                          <div class="flex flex-wrap justify-between items-center gap-2">
                            <div class="flex flex-wrap items-center gap-2">
                              <span class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.14em]">{isEn ? "STATUS:" : "ESTADO:"}</span>
                              <span class={`px-2.5 py-1 rounded-none text-[9px] font-mono font-bold tracking-widest uppercase border ${
                                actualShippingStatus === 'shipped'
                                  ? 'bg-blue-50 text-blue-900 border-blue-200'
                                  : actualShippingStatus === 'delivered'
                                  ? 'bg-emerald-50 text-emerald-900 border-emerald-200'
                                  : actualShippingStatus === 'returned'
                                  ? 'bg-amber-50 text-amber-900 border-amber-200'
                                  : actualShippingStatus === 'cancelled'
                                  ? 'bg-rose-50 text-rose-900 border-rose-200'
                                  : 'bg-slate-100 text-slate-900 border-slate-300'
                              }`}>
                                {actualShippingStatus === 'shipped' 
                                  ? (isEn ? 'Shipped' : 'Enviado') 
                                  : actualShippingStatus === 'delivered'
                                  ? (isEn ? 'Delivered' : 'Entregado')
                                  : actualShippingStatus === 'returned'
                                  ? (isEn ? 'Returned' : 'Devuelto')
                                  : actualShippingStatus === 'cancelled'
                                  ? (isEn ? 'Cancelled' : 'Cancelado')
                                  : (isEn ? 'In Preparation' : 'En preparación')}
                              </span>
                              
                              {order.returnRequest && (
                                <span class={`px-2.5 py-1 rounded-none text-[9px] font-mono font-bold tracking-widest uppercase border ${
                                  order.returnRequest.status === 'pending'
                                    ? 'bg-amber-50 text-amber-900 border-amber-200'
                                    : order.returnRequest.status === 'approved'
                                    ? 'bg-emerald-50 text-emerald-900 border-emerald-200'
                                    : 'bg-rose-50 text-rose-900 border-rose-200'
                                }`}>
                                  {isEn ? `Return: ${order.returnRequest.status}` : `Devolución: ${
                                    order.returnRequest.status === 'pending' ? 'Solicitada' :
                                    order.returnRequest.status === 'approved' ? 'Aprobada' : 'Rechazada'
                                  }`}
                                </span>
                              )}
                            </div>

                            <div class="flex flex-wrap items-center gap-2">
                              {/* 1. Botón para confirmar que el producto ha llegado cuando está enviado */}
                              {isShipped && (
                                <button
                                  type="button"
                                  class="confirm-delivery-btn px-3 py-1.5 bg-white hover:bg-slate-50 text-emerald-800 border border-emerald-300 rounded-none text-[10px] font-bold uppercase tracking-[0.14em] transition-colors cursor-pointer active:scale-98 flex items-center gap-1.5"
                                  data-order-id={order.id}
                                  title={isEn ? "Click when you have received the order to enable returns" : "Pulsa al recibir el pedido para habilitar el periodo de devolución"}
                                >
                                  <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
                                  {isEn ? "Confirm Received" : "He recibido el producto"}
                                </button>
                              )}

                              {/* 2. Si el producto ya fue entregado y no hay solicitud previa */}
                              {isDelivered && !order.returnRequest && (
                                isWithinReturnWindow ? (
                                  <div class="flex items-center gap-2">
                                    <span class="text-[10px] font-mono font-bold text-amber-900 bg-amber-50 px-2 py-1 rounded-none border border-amber-200">
                                      {isEn ? `${daysRemaining}d to return` : `Quedan ${daysRemaining} días`}
                                    </span>
                                    <button
                                      type="button"
                                      class="request-return-btn px-3 py-1.5 bg-white hover:bg-slate-50 text-slate-950 border border-slate-300 hover:border-black rounded-none text-[10px] font-bold uppercase tracking-[0.14em] transition-colors cursor-pointer active:scale-98"
                                      data-order-id={order.id}
                                    >
                                      {isEn ? "Request Return" : "Solicitar Devolución"}
                                    </button>
                                  </div>
                                ) : (
                                  <div class="flex items-center gap-2">
                                    <span class="text-[11px] text-slate-400 font-normal">
                                      {isEn ? "Return window closed (14d)" : "Plazo de devolución cerrado (14d)"}
                                    </span>
                                    <a
                                      href={`/${lang}/contacto?orderId=${encodeURIComponent(order.id)}`}
                                      class="px-3 py-1.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded-none text-[10px] font-bold uppercase tracking-[0.14em] transition-colors inline-flex items-center gap-1.5"
                                      title={isEn ? "Get assistance or file a warranty claim" : "Obtener asistencia o tramitar garantía"}
                                    >
                                      <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z"/></svg>
                                      {isEn ? "Contact Support" : "Contactar con Soporte"}
                                    </a>
                                  </div>
                                )
                              )}
                            </div>
                          </div>

                          {order.trackingNumber && (
                            <div class="text-[11px] font-medium text-slate-600">
                              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.14em]">{isEn ? "TRACKING NO:" : "Nº SEGUIMIENTO:"}</span>
                              <span class="font-mono bg-slate-100 border border-slate-200 px-2 py-0.5 rounded-none text-slate-900 ml-1.5">{order.trackingNumber}</span>
                            </div>
                          )}
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            ) : (
              <div class="text-center py-16 flex flex-col items-center gap-3 bg-slate-50 rounded-none border border-slate-200 p-8 max-w-sm mx-auto">
                <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                </svg>
                <h3 class="text-xs font-bold text-slate-950 uppercase tracking-[0.18em]">{isEn ? "No purchases" : "Sin compras"}</h3>
                <p class="text-xs text-slate-500 leading-relaxed">{isEn ? "You have not placed any orders in our shop yet." : "Todavía no has realizado ningún pedido en la tienda."}</p>
                <a href={`/${lang}#catalogo`} class="mt-2 text-xs font-bold text-slate-950 underline underline-offset-4 hover:text-rose-600 uppercase tracking-[0.14em]">{isEn ? "Explore Catalog" : "Explorar Catálogo"}</a>
              </div>
            )}
          </div>

          <!-- PANEL 3: NEWSLETTER / OFFERS -->
          <div id="tab-newsletter" class="tab-panel hidden bg-white border border-slate-200 shadow-none rounded-none p-6 sm:p-8 flex flex-col gap-6 lg:min-h-[480px]">
            <div class="border-b border-slate-200 pb-3">
              <h2 class="text-xs sm:text-sm font-bold text-slate-950 uppercase tracking-[0.18em]">
                {isEn ? "Offers & Subscriptions" : "Ofertas y Suscripciones"}
              </h2>
              <p class="text-[11px] text-slate-500 mt-1">
                {isEn ? "Manage your subscription preference for commercial newsletters" : "Gestiona tu suscripción a correos promocionales y boletines"}
              </p>
            </div>

            <div class="flex items-center justify-between p-5 bg-slate-50 rounded-none border border-slate-200">
              <div class="flex flex-col gap-0.5">
                <span class="text-xs font-bold text-slate-900">{isEn ? "Marketing emails" : "Correos comerciales"}</span>
                <span class="text-[11px] text-slate-500 font-normal" id="subscription-status">
                  {customerProfile.marketingConsent 
                    ? (isEn ? "Subscribed to offers" : "Suscrito a las ofertas") 
                    : (isEn ? "Not subscribed" : "No suscrito")}
                </span>
              </div>
              <button 
                type="button" 
                id="toggle-subscription-btn" 
                class={`px-4 py-2.5 rounded-none text-xs font-bold uppercase tracking-[0.16em] transition-colors cursor-pointer active:scale-98 border ${
                  customerProfile.marketingConsent 
                    ? 'bg-slate-950 hover:bg-slate-800 text-white border-slate-950' 
                    : 'bg-white hover:bg-slate-100 text-slate-950 border-slate-300 hover:border-black'
                }`}
                data-subscribed={customerProfile.marketingConsent ? "true" : "false"}
              >
                {customerProfile.marketingConsent 
                  ? (isEn ? "Unsubscribe" : "Darse de baja") 
                  : (isEn ? "Subscribe" : "Suscribirse")}
              </button>
            </div>
          </div>

          <!-- PANEL 4: SECURITY -->
          <div id="tab-security" class="tab-panel hidden bg-white border border-slate-200 shadow-none rounded-none p-6 sm:p-8 flex flex-col gap-6 lg:min-h-[480px]">
            <div class="border-b border-slate-200 pb-3">
              <h2 class="text-xs sm:text-sm font-bold text-slate-950 uppercase tracking-[0.18em]">
                {isEn ? "Security & Session" : "Seguridad y Sesión"}
              </h2>
              <p class="text-[11px] text-slate-500 mt-1">
                {isEn ? "Manage your account password and active session" : "Gestiona tu contraseña de acceso y sesión activa"}
              </p>
            </div>

            <p class="text-xs text-slate-600 leading-relaxed">
              {isEn ? "Do you want to reset your password or sign out from your account?" : "¿Quieres cambiar tu contraseña de acceso o cerrar tu sesión activa?"}
            </p>
            
            <div class="flex flex-col sm:flex-row gap-3">
              <button type="button" id="reset-password-btn" class="flex-1 py-3 px-4 rounded-none border border-slate-300 hover:border-black bg-white text-slate-900 hover:text-black text-xs font-bold uppercase tracking-[0.16em] transition-colors flex items-center justify-center gap-2 cursor-pointer active:scale-98 text-center">
                <span>{isEn ? "Reset Password" : "Restablecer Contraseña"}</span>
              </button>
              
              <a href="/api/auth/logout" class="flex-1 py-3 px-4 rounded-none border border-rose-300 hover:border-rose-600 bg-white hover:bg-rose-50 text-rose-650 hover:text-rose-700 text-xs font-bold uppercase tracking-[0.16em] transition-colors flex items-center justify-center gap-2 cursor-pointer active:scale-98 text-center no-underline">
                <span>{isEn ? "Sign Out" : "Cerrar Sesión"}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer (Full Width) -->
    <footer id="contacto" class="w-full bg-slate-900 text-slate-400 py-16 px-4 md:px-8 border-t border-slate-850">
      <div class="w-full grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
        <!-- Logo and info -->
        <div class="flex flex-col gap-4 col-span-2 md:col-span-1">
          <a href={`/${lang}`} class="flex flex-col">
            <span class="text-xl md:text-2xl font-black italic tracking-tighter text-white uppercase leading-none">
              FLEX <span class="text-red-550">FORM</span>
            </span>
            <span class="text-[8px] font-extrabold tracking-[0.25em] text-slate-500 uppercase leading-none mt-0.5">
              FITNESS
            </span>
          </a>
          <p class="text-xs text-slate-500 leading-relaxed">
            {isEn ? "High-performance sportswear and premium accessories designed for dedicated athletes." : "Ropa deportiva de alto rendimiento y accesorios premium diseñados para atletas dedicados."}
          </p>
        </div>

        <!-- Links Colecciones -->
        <div class="flex flex-col gap-3 col-span-1">
          <h4 class="text-xs font-bold text-white tracking-widest uppercase">{isEn ? "COLLECTIONS" : "COLECCIONES"}</h4>
          <ul class="text-xs flex flex-col gap-2">
            <li><a href={`/${lang}#catalogo`} class="hover:text-white transition-colors">{isEn ? "New Arrivals" : "Novedades"}</a></li>
            <li><a href={`/${lang}#catalogo`} class="hover:text-white transition-colors">{isEn ? "Men" : "Hombre"}</a></li>
            <li><a href={`/${lang}#catalogo`} class="hover:text-white transition-colors">{isEn ? "Women" : "Mujer"}</a></li>
            <li><a href={`/${lang}#catalogo`} class="hover:text-white transition-colors">{isEn ? "Bestsellers" : "Más Vendidos"}</a></li>
          </ul>
        </div>

        <!-- Links Ayuda -->
        <div class="flex flex-col gap-3 col-span-1">
          <h4 class="text-xs font-bold text-white tracking-widest uppercase">{isEn ? "SUPPORT" : "SOPORTE"}</h4>
          <ul class="text-xs flex flex-col gap-2">
            <li><a href="#" class="hover:text-white transition-colors">{isEn ? "Shipping & Deliveries" : "Envíos y Entregas"}</a></li>
            <li><a href={`/${lang}/devoluciones`} class="hover:text-white transition-colors">{isEn ? "Returns" : "Devoluciones"}</a></li>
            <li><a href="#" class="hover:text-white transition-colors">{isEn ? "Size Guide" : "Guía de Tallas"}</a></li>
          </ul>
        </div>

        <!-- Contact/Newsletter -->
        <div class="flex flex-col gap-3 col-span-2 md:col-span-1">
          <h4 class="text-xs font-bold text-white tracking-widest uppercase">NEWSLETTER</h4>
          <p class="text-xs text-slate-550 leading-relaxed">{isEn ? "Subscribe to receive a 10% discount on your first order and exclusive deals." : "Suscríbete para recibir un 10% de descuento en tu primer pedido y ofertas exclusivas."}</p>
          <div class="flex gap-2 mt-1">
            <input type="email" id="newsletter-email" placeholder={isEn ? "Your email" : "Tu email"} class="bg-slate-800 text-white placeholder-slate-500 border border-slate-700 px-3 py-2 text-xs focus:outline-none focus:border-white w-full rounded-none" />
            <button id="newsletter-submit-btn" class="bg-white text-slate-900 px-4 py-2 text-xs font-bold uppercase hover:bg-slate-100 transition-colors rounded-none">OK</button>
          </div>
        </div>
      </div>

      <div class="w-full pt-8 border-t border-slate-850 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] md:text-2xs text-slate-550">
        <p class="text-center md:text-left">&copy; {new Date().getFullYear()} FLEX FORM FITNESS. {isEn ? "All rights reserved." : "Todos los derechos reservados."} {isEn ? "in collaboration with" : "en colaboración con"} <a href="https://javiphoto.es" target="_blank" class="hover:text-white underline transition-colors">javiphoto.es</a></p>
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-1.5 md:gap-x-6">
          <a href={`/${lang}/condiciones`} class="hover:text-white transition-colors">Condiciones de Uso</a>
          <a href={`/${lang}/privacidad`} class="hover:text-white transition-colors">Política de Privacidad</a>
          <a href={`/${lang}/cookies`} class="hover:text-white transition-colors">Cookies</a>
        </div>
      </div>
    </footer>

    <!-- MODAL: REQUEST RETURN -->
    <div id="return-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-xs hidden">
      <div class="bg-white border border-slate-200 rounded-none w-full max-w-md shadow-2xl overflow-hidden flex flex-col">
        <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex justify-between items-center select-none shrink-0">
          <span class="text-xs font-bold tracking-[0.18em] text-slate-950 uppercase">{isEn ? "Request Return" : "Solicitar Devolución"}</span>
          <button type="button" id="close-return-modal" class="text-slate-400 hover:text-black text-xl font-light cursor-pointer">✕</button>
        </div>
        
        <form id="return-form" class="p-6 flex flex-col gap-4 text-xs">
          <input type="hidden" id="return-order-id" />

          <!-- Legal notice box -->
          <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-none flex flex-col gap-1 text-[11px] text-slate-600 leading-relaxed">
            <span class="font-bold text-slate-900 uppercase tracking-wider text-[10px]">
              {isEn ? "14-Day Statutory Right of Withdrawal" : "Derecho Legal de Desistimiento (14 Días)"}
            </span>
            <p>
              {isEn 
                ? "You have 14 calendar days from delivery to return your order without giving any reason. Products must be unworn with original tags attached. Direct return shipping costs are borne by the customer."
                : "Dispones de 14 días naturales desde la entrega para devolver tu pedido sin dar ninguna explicación. Las prendas deben estar sin usar y con sus etiquetas. Los gastos directos de devolución corren por cuenta del cliente."}
            </p>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="return-reason" class="block text-[10px] font-bold text-slate-700 uppercase tracking-[0.16em]">
              {isEn ? "Reason for Return (Optional)" : "Motivo de la Devolución (Opcional)"}
            </label>
            <textarea id="return-reason" rows="3" placeholder={isEn ? "Optional: You don't need to explain, but it helps us improve (wrong size, not as expected, etc.)..." : "Opcional: Por ley no estás obligado a dar explicaciones, pero nos ayuda a mejorar (cambio de talla, etc.)..."} class="w-full px-3.5 py-2.5 rounded-none bg-white border border-slate-300 text-slate-900 focus:outline-none focus:border-black text-xs font-sans"></textarea>
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="block text-[10px] font-bold text-slate-700 uppercase tracking-[0.16em]">
              {isEn ? "Images (optional)" : "Imágenes de Prueba (opcional)"}
            </label>
            <div class="flex flex-col gap-2">
              <input type="file" id="return-file-input" accept="image/*" multiple class="w-full px-3 py-2 border border-slate-300 rounded-none text-slate-700 text-xs font-sans bg-white cursor-pointer" />
              <div id="return-images-preview" class="grid grid-cols-4 gap-2 mt-2">
                <!-- Previews of selected return images -->
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-200 flex justify-end gap-3 shrink-0">
            <button type="button" id="cancel-return-modal" class="px-4 py-2.5 bg-white border border-slate-300 hover:border-black text-slate-900 rounded-none text-xs font-bold uppercase tracking-[0.16em] transition-colors cursor-pointer">
              {isEn ? "Cancel" : "Cancelar"}
            </button>
            <button type="submit" id="submit-return-btn" class="px-5 py-2.5 bg-slate-950 hover:bg-slate-800 text-white rounded-none text-xs font-bold uppercase tracking-[0.16em] transition-colors cursor-pointer">
              {isEn ? "Submit Request" : "Enviar Solicitud"}
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Client Script -->
    <script>
      import { actions } from 'astro:actions';
      import { auth } from '../../lib/firebaseClient';
      import { sendPasswordResetEmail } from 'firebase/auth';

      const profileForm = document.getElementById('profile-form') as HTMLFormElement;
      const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
      const resetPasswordBtn = document.getElementById('reset-password-btn') as HTMLButtonElement;
      
      const errorBox = document.getElementById('error-box') as HTMLDivElement;
      const successBox = document.getElementById('success-box') as HTMLDivElement;

      // Tab switcher logic
      const tabButtons = document.querySelectorAll('.tab-btn');
      const tabPanels = document.querySelectorAll('.tab-panel');

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetTabId = btn.getAttribute('data-tab');
          if (!targetTabId) return;

          // Clear existing feedback boxes
          errorBox.textContent = '';
          errorBox.classList.add('hidden');
          successBox.textContent = '';
          successBox.classList.add('hidden');

          // Hide all panels, show target panel
          tabPanels.forEach(panel => {
            if (panel.id === targetTabId) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          });

          // Reset buttons styles, set active style
          tabButtons.forEach(b => {
            b.className = "tab-btn px-4 py-3 rounded-none flex items-center gap-3 transition-colors text-left text-xs font-medium uppercase tracking-[0.14em] whitespace-nowrap text-slate-500 hover:text-slate-950 hover:bg-slate-50 border-l-2 border-transparent select-none cursor-pointer w-full";
          });

          btn.className = "tab-btn px-4 py-3 rounded-none flex items-center gap-3 transition-colors text-left text-xs font-bold uppercase tracking-[0.14em] whitespace-nowrap bg-slate-100/80 text-slate-950 border-l-2 border-slate-950 select-none cursor-pointer w-full";
        });
      });

      function getIsEn() {
        return window.location.pathname.startsWith('/en');
      }

      function showError(message: string) {
        errorBox.textContent = message;
        errorBox.classList.remove('hidden');
        successBox.classList.add('hidden');
      }

      function showSuccess(message: string) {
        successBox.textContent = message;
        successBox.classList.remove('hidden');
        errorBox.classList.add('hidden');
      }

      function clearBoxes() {
        errorBox.textContent = '';
        errorBox.classList.add('hidden');
        successBox.textContent = '';
        successBox.classList.add('hidden');
      }

      // Handle Profile update form submission
      profileForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearBoxes();

        saveBtn.disabled = true;
        const originalText = saveBtn.innerHTML;
        const isEn = getIsEn();
        saveBtn.innerHTML = `<span>${isEn ? 'Saving...' : 'Guardando...'}</span>`;

        const name = (document.getElementById('form-name') as HTMLInputElement).value.trim();
        const phone = (document.getElementById('form-phone') as HTMLInputElement).value.trim();
        const line1 = (document.getElementById('form-address-1') as HTMLInputElement).value.trim();
        const line2 = (document.getElementById('form-address-2') as HTMLInputElement).value.trim();
        const city = (document.getElementById('form-city') as HTMLInputElement).value.trim();
        const state = (document.getElementById('form-state') as HTMLInputElement).value.trim();
        const postal_code = (document.getElementById('form-zip') as HTMLInputElement).value.trim();
        const country = (document.getElementById('form-country') as HTMLInputElement).value.trim();

        try {
          const { error } = await actions.saveUserProfile({
            name,
            phone,
            address: {
              line1,
              line2: line2 || null,
              city,
              state,
              postal_code,
              country
            }
          });

          if (error) {
            showError(error.message || (isEn ? 'Error saving profile details.' : 'Error al guardar los datos de tu perfil.'));
          } else {
            showSuccess(isEn ? 'Your shipping details have been saved successfully!' : '¡Tus datos de envío se han guardado correctamente!');
          }
        } catch (err: any) {
          console.error('Error saving profile:', err);
          showError((isEn ? 'Unexpected error saving changes: ' : 'Error inesperado al guardar los cambios: ') + err.message);
        } finally {
          saveBtn.disabled = false;
          saveBtn.innerHTML = originalText;
        }
      });

      // Handle Toggle newsletter subscription
      const toggleSubscriptionBtn = document.getElementById('toggle-subscription-btn') as HTMLButtonElement;
      const subscriptionStatus = document.getElementById('subscription-status') as HTMLSpanElement;

      toggleSubscriptionBtn?.addEventListener('click', async () => {
        clearBoxes();
        const isEn = getIsEn();
        const isCurrentlySubscribed = toggleSubscriptionBtn.dataset.subscribed === "true";
        const newConsent = !isCurrentlySubscribed;

        toggleSubscriptionBtn.disabled = true;
        const originalText = toggleSubscriptionBtn.innerText;
        toggleSubscriptionBtn.innerText = '...';

        try {
          const { error } = await actions.saveMarketingConsent({
            email: auth.currentUser?.email || '',
            consent: newConsent,
            name: auth.currentUser?.displayName || '',
            userId: auth.currentUser?.uid,
          });

          if (error) throw error;

          toggleSubscriptionBtn.dataset.subscribed = newConsent ? "true" : "false";
          toggleSubscriptionBtn.innerText = newConsent 
            ? (isEn ? "Unsubscribe" : "Darse de baja") 
            : (isEn ? "Subscribe" : "Suscribirse");
          
          if (newConsent) {
            toggleSubscriptionBtn.className = "px-4 py-2.5 rounded-none text-xs font-bold uppercase tracking-[0.16em] transition-colors cursor-pointer active:scale-98 border bg-slate-950 hover:bg-slate-800 text-white border-slate-950";
            subscriptionStatus.textContent = isEn ? "Subscribed to offers" : "Suscrito a las ofertas";
            showSuccess(isEn ? "You have subscribed to our offers successfully!" : "¡Te has suscrito a nuestras ofertas correctamente!");
          } else {
            toggleSubscriptionBtn.className = "px-4 py-2.5 rounded-none text-xs font-bold uppercase tracking-[0.16em] transition-colors cursor-pointer active:scale-98 border bg-white hover:bg-slate-100 text-slate-950 border-slate-300 hover:border-black";
            subscriptionStatus.textContent = isEn ? "Not subscribed" : "No suscrito";
            showSuccess(isEn ? "You have unsubscribed from our offers." : "Te has dado de baja de nuestras ofertas.");
          }
        } catch (err: any) {
          console.error('Error toggling subscription:', err);
          toggleSubscriptionBtn.innerText = originalText;
          showError((isEn ? 'Error updating subscription preferences: ' : 'Error al actualizar las preferencias de suscripción: ') + (err.message || 'Error'));
        } finally {
          toggleSubscriptionBtn.disabled = false;
        }
      });

      // Handle Firebase password reset email request
      resetPasswordBtn?.addEventListener('click', async () => {
        clearBoxes();
        const isEn = getIsEn();
        
        const user = auth.currentUser;
        const userEmail = user?.email;
        if (!user || !userEmail) {
          showError(isEn ? 'Could not verify active user email.' : 'No se pudo verificar el correo electrónico del usuario activo.');
          return;
        }

        const isGoogleUser = user.providerData.some(p => p.providerId === 'google.com');
        if (isGoogleUser) {
          showError(isEn ? 'This account is linked with Google. Password is managed by Google.' : 'Esta cuenta está vinculada a Google. La contraseña es gestionada por Google.');
          return;
        }

        resetPasswordBtn.disabled = true;
        const originalContent = resetPasswordBtn.innerHTML;
        resetPasswordBtn.innerHTML = `<span>${isEn ? 'Sending email...' : 'Enviando correo...'}</span>`;

        try {
          await sendPasswordResetEmail(auth, userEmail);
          showSuccess(isEn ? 'Sent! Check your inbox to reset your password.' : '¡Enviado! Revisa tu bandeja de entrada para restablecer tu contraseña.');
        } catch (err: any) {
          console.error('Error sending password reset email:', err);
          showError((isEn ? 'Error sending reset email: ' : 'Error al enviar el correo de restablecimiento: ') + (err.message || err.code));
        } finally {
          resetPasswordBtn.disabled = false;
          resetPasswordBtn.innerHTML = originalContent;
        }
      });

      // Disable password reset on load if user is authenticated with Google
      auth.onAuthStateChanged((user) => {
        if (user) {
          const isGoogleUser = user.providerData.some(p => p.providerId === 'google.com');
          if (isGoogleUser && resetPasswordBtn) {
            resetPasswordBtn.disabled = true;
            resetPasswordBtn.classList.add('opacity-50', 'cursor-not-allowed');
            resetPasswordBtn.innerHTML = `<span>${getIsEn() ? 'Password managed by Google' : 'Contraseña gestionada por Google'}</span>`;
          }
        }
      });

      // Return Modal Toggling & Uploading
      const returnModal = document.getElementById('return-modal') as HTMLDivElement;
      const closeReturnModal = document.getElementById('close-return-modal') as HTMLButtonElement;
      const cancelReturnModal = document.getElementById('cancel-return-modal') as HTMLButtonElement;
      const returnForm = document.getElementById('return-form') as HTMLFormElement;
      const submitReturnBtn = document.getElementById('submit-return-btn') as HTMLButtonElement;
      const returnFileInput = document.getElementById('return-file-input') as HTMLInputElement;
      const returnImagesPreview = document.getElementById('return-images-preview') as HTMLDivElement;
      const returnOrderIdInput = document.getElementById('return-order-id') as HTMLInputElement;
      const returnReasonInput = document.getElementById('return-reason') as HTMLTextAreaElement;

      function toggleModal(el: HTMLDivElement | null, show: boolean) {
        if (!el) return;
        if (show) {
          el.classList.remove('hidden');
          el.classList.add('flex');
        } else {
          el.classList.remove('flex');
          el.classList.add('hidden');
        }
      }

      function blobToBase64(blob: Blob): Promise<string> {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onloadend = () => resolve(reader.result as string);
          reader.onerror = reject;
          reader.readAsDataURL(blob);
        });
      }

      function compressAndBase64(file: File): Promise<string> {
        return new Promise((resolve) => {
          const img = new Image();
          img.src = URL.createObjectURL(file);
          img.onload = () => {
            const canvas = document.createElement('canvas');
            const max = 1600; // max size for return proof images
            let w = img.width;
            let h = img.height;
            if (w > max || h > max) {
              if (w > h) {
                h = Math.round((h * max) / w);
                w = max;
              } else {
                w = Math.round((w * max) / h);
                h = max;
              }
            }
            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx?.drawImage(img, 0, 0, w, h);
            canvas.toBlob((blob) => {
              if (blob) {
                blobToBase64(blob).then(resolve);
              } else {
                blobToBase64(file).then(resolve);
              }
            }, 'image/jpeg', 0.9);
          };
        });
      }

      // Bind opening return modal on buttons
      document.querySelectorAll('.request-return-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const orderId = target.dataset.orderId || '';
          returnOrderIdInput.value = orderId;
          returnReasonInput.value = '';
          if (returnFileInput) returnFileInput.value = '';
          if (returnImagesPreview) returnImagesPreview.innerHTML = '';
          toggleModal(returnModal, true);
        });
      });

      // Bind confirm delivery buttons ("He recibido el producto")
      document.querySelectorAll('.confirm-delivery-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const orderId = target.dataset.orderId || '';
          if (!orderId) return;

          const isEn = getIsEn();
          const confirmMsg = isEn
            ? 'Have you received this order physically? Confirming delivery starts your statutory 14-day return period.'
            : '¿Confirmas que has recibido el producto? Al confirmar la entrega, se activará tu plazo legal de 14 días naturales para ejercer el derecho de devolución.';

          if (!confirm(confirmMsg)) return;

          target.disabled = true;
          const originalHTML = target.innerHTML;
          target.innerHTML = `<span>${isEn ? 'Confirming...' : 'Confirmando...'}</span>`;

          try {
            const { error } = await actions.confirmOrderDelivery({ orderId });
            if (error) throw error;
            alert(isEn ? 'Delivery confirmed! Your 14-day return window is now active.' : '¡Entrega confirmada! El plazo legal de 14 días para devoluciones ya está activo.');
            window.location.reload();
          } catch (err: any) {
            console.error('Error confirming delivery:', err);
            alert((isEn ? 'Error confirming delivery: ' : 'Error al confirmar la recepción: ') + (err.message || err.code));
            target.disabled = false;
            target.innerHTML = originalHTML;
          }
        });
      });

      closeReturnModal?.addEventListener('click', () => toggleModal(returnModal, false));
      cancelReturnModal?.addEventListener('click', () => toggleModal(returnModal, false));

      // Preview selected local images
      returnFileInput?.addEventListener('change', () => {
        returnImagesPreview.innerHTML = '';
        const files = Array.from(returnFileInput.files || []);
        files.forEach((file) => {
          const url = URL.createObjectURL(file);
          const img = document.createElement('img');
          img.src = url;
          img.className = "w-full aspect-square object-cover rounded-none border border-slate-200";
          returnImagesPreview.appendChild(img);
        });
      });

      // Submit return request
      returnForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const isEn = getIsEn();
        submitReturnBtn.disabled = true;
        const originalText = submitReturnBtn.innerHTML;
        submitReturnBtn.innerHTML = `<span>${isEn ? 'Submitting...' : 'Enviando...'}</span>`;

        const orderId = returnOrderIdInput.value;
        const reason = returnReasonInput.value.trim();
        const files = Array.from(returnFileInput?.files || []);

        try {
          const uploadedUrls: string[] = [];
          
          for (let i = 0; i < files.length; i++) {
            const file = files[i];
            const base64Data = await compressAndBase64(file);
            const { data, error: uploadError } = await actions.uploadReturnImage({
              base64Data,
              fileName: file.name
            });
            if (uploadError || !data?.success || !data?.url) {
              throw new Error(uploadError?.message || (isEn ? 'Error uploading returns image.' : 'Error al subir la imagen del pedido.'));
            }
            uploadedUrls.push(data.url);
          }

          const { error } = await actions.requestOrderReturn({
            orderId,
            reason,
            images: uploadedUrls
          });

          if (error) throw error;

          alert(isEn ? 'Return request submitted successfully!' : '¡Solicitud de devolución enviada con éxito!');
          window.location.reload();
        } catch (err: any) {
          console.error('Error submitting return request:', err);
          alert((isEn ? 'Error submitting request: ' : 'Error al enviar la solicitud: ') + (err.message || err.code));
          submitReturnBtn.disabled = false;
          submitReturnBtn.innerHTML = originalText;
        }
      });

      // Newsletter sign up logic
      const newsletterEmailInput = document.getElementById('newsletter-email') as HTMLInputElement;
      const newsletterSubmitBtn = document.getElementById('newsletter-submit-btn') as HTMLButtonElement;

      newsletterSubmitBtn?.addEventListener('click', async () => {
        const email = newsletterEmailInput.value.trim();
        const isEn = getIsEn();
        if (!email) {
          alert(isEn ? 'Please enter an email address.' : 'Por favor, introduce un correo electrónico.');
          return;
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          alert(isEn ? 'Please enter a valid email address.' : 'Por favor, introduce un correo electrónico válido.');
          return;
        }

        newsletterSubmitBtn.disabled = true;
        const originalText = newsletterSubmitBtn.innerText;
        newsletterSubmitBtn.innerText = '...';

        try {
          const { error } = await actions.saveMarketingConsent({
            email,
            consent: true,
          });
          if (error) throw error;
          alert(isEn ? 'Thank you for subscribing to our newsletter!' : '¡Gracias por suscribirte a nuestra newsletter!');
          newsletterEmailInput.value = '';
        } catch (err: any) {
          console.error(err);
          alert(isEn ? 'An error occurred during subscription: ' + (err.message || 'Unknown error') : 'Ocurrió un error al suscribirte: ' + (err.message || 'Error desconocido'));
        } finally {
          newsletterSubmitBtn.disabled = false;
          newsletterSubmitBtn.innerText = originalText;
        }
      });
    </script>

    <style>
      .account-nav-tabs {
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 #f1f5f9;
      }

      .account-nav-tabs::-webkit-scrollbar {
        height: 3px;
        width: 3px;
      }

      .account-nav-tabs::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 9999px;
        margin: 0 4px;
      }

      .account-nav-tabs::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 9999px;
        transition: background-color 0.2s ease;
      }

      .account-nav-tabs::-webkit-scrollbar-thumb:hover {
        background-color: #94a3b8;
      }

      .account-nav-tabs::-webkit-scrollbar-button {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
      }
    </style>
  </body>
</html>
