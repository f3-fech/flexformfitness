---
import { db } from '../../lib/firebase';
import type { Product } from '../../types';
import SEO from '../../components/SEO.astro';
import Navbar from '../../components/Navbar.astro';
import { mockProducts } from '../../lib/mockData';
import { getGeneralSettings } from '../../lib/settings';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const isEn = lang === 'en';

const getGender = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes('mujer') || t.includes('women')) return 'mujer';
  if (t.includes('hombre') || t.includes('men')) return 'hombre';
  return 'unisex';
};

const getObjectPosition = (url: string | undefined): string => {
  if (!url) return 'center';
  const match = url.match(/#pos=([a-zA-Z0-9%_-]+)/);
  if (match && match[1]) {
    return match[1].replace('_', ' ');
  }
  return 'center';
};

const getColorHex = (colorName: string): string => {
  const name = colorName.toLowerCase().trim();
  const colorMap: Record<string, string> = {
    'negro': '#0f172a',
    'black': '#0f172a',
    'gris': '#94a3b8',
    'grey': '#94a3b8',
    'gray': '#94a3b8',
    'gris-oscuro': '#4b5563',
    'rosa': '#db2777',
    'pink': '#db2777',
    'amarillo': '#fbbf24',
    'yellow': '#fbbf24',
    'azul-metalizado': '#475569',
    'azul-marino': '#1e3a8a',
    'navy': '#1e3a8a',
    'azul-claro': '#a5f3fc',
    'blanco': '#ffffff',
    'white': '#ffffff',
    'rojo': '#dc2626',
    'red': '#dc2626',
    'verde': '#16a34a',
    'green': '#16a34a',
    'naranja': '#ea580c',
    'orange': '#ea580c',
  };

  for (const key in colorMap) {
    if (name.includes(key)) {
      return colorMap[key];
    }
  }
  return '#64748b';
};

interface SwatchColor {
  name: string;
  hex: string;
  image: string | null;
}

const getUniqueColors = (product: Product): SwatchColor[] => {
  if (!product.variants || product.variants.length === 0) return [];
  const colorMap = new Map<string, SwatchColor>();
  
  product.variants.forEach((v) => {
    const parts = v.name.split('/').map((p) => p.trim());
    const name = parts[0] || 'Base';
    
    if (!colorMap.has(name)) {
      const hex = v.colorHex || getColorHex(name);
      colorMap.set(name, {
        name: name,
        hex: hex,
        image: v.image || null
      });
    }
  });
  
  return Array.from(colorMap.values());
};

interface HomepageCollectionData {
  id: string;
  title: string;
  products: Product[];
}

let homepageCollections: HomepageCollectionData[] = [];

// Fetch hombre and mujer collections to get their product IDs for filtering
let menProductIds: string[] = [];
let womenProductIds: string[] = [];

try {
  // 1. Fetch men and women collection IDs
  const menColSnap = await db.collection('collections').where('slug', '==', 'hombre').limit(1).get();
  if (!menColSnap.empty) {
    menProductIds = menColSnap.docs[0].data().productIds || [];
  }
  const womenColSnap = await db.collection('collections').where('slug', '==', 'mujer').limit(1).get();
  if (!womenColSnap.empty) {
    womenProductIds = womenColSnap.docs[0].data().productIds || [];
  }

  // 2. Fetch collections explicitly marked to show on index
  let collectionsSnap = await db.collection('collections')
    .where('showOnIndex', '==', true)
    .get();

  // Fallback to 'mas-vendidos' or 'best-sellers' if none is marked
  if (collectionsSnap.empty) {
    collectionsSnap = await db.collection('collections')
      .where('slug', 'in', ['mas-vendidos', 'best-sellers'])
      .limit(1)
      .get();
  }

  // Sort in-memory by indexOrder to avoid Firestore composite index requirement
  const sortedDocs = [...collectionsSnap.docs].sort((a, b) => {
    const orderA = a.data().indexOrder ?? 0;
    const orderB = b.data().indexOrder ?? 0;
    return orderA - orderB;
  });

  for (const doc of sortedDocs) {
    const colData = doc.data();
    if (!colData) continue;

    const title = isEn ? (colData.title_en || colData.title) : colData.title;
    const productIds: string[] = colData.productIds || [];
    let colProducts: Product[] = [];

    if (productIds.length > 0) {
      const targetIds = productIds.slice(0, 30);
      const productsSnap = await db.collection('products')
        .where('__name__', 'in', targetIds)
        .get();
      
      const unsortedProducts = productsSnap.docs.map((pDoc) => ({ id: pDoc.id, ...pDoc.data() }) as Product);
      colProducts = targetIds
        .map(id => unsortedProducts.find(p => p.id === id))
        .filter((p): p is Product => p !== undefined);
    }

    if (colProducts.length > 0) {
      homepageCollections.push({
        id: doc.id,
        title,
        products: colProducts
      });
    }
  }

  // Fallback if no collections have products
  if (homepageCollections.length === 0) {
    const productsSnap = await db.collection('products').limit(30).get();
    const fallbackProducts = productsSnap.docs.map((pDoc) => ({ id: pDoc.id, ...pDoc.data() }) as Product);
    homepageCollections.push({
      id: 'fallback',
      title: isEn ? "All Products" : "Todos los Productos",
      products: fallbackProducts
    });
  }
} catch (error) {
  console.warn('Error fetching homepage collections from Firestore. Using fallback.', error);
  homepageCollections = [{
    id: 'mock',
    title: isEn ? "Best Sellers" : "Más Vendidos",
    products: mockProducts
  }];
}
const settings = await getGeneralSettings();

let collectionsMap: Record<string, { slug: string; title: string }> = {};
try {
  const allColsSnap = await db.collection('collections').get();
  allColsSnap.docs.forEach((doc) => {
    const data = doc.data();
    collectionsMap[doc.id] = {
      slug: data.slug || '',
      title: data.title || '',
    };
  });
} catch (err) {
  console.error("Error building collectionsMap for homepage:", err);
}

const heroSlides = settings.heroSlides || [];
const firstSlide = heroSlides[0];
const shouldPreloadFirstSlideImage = firstSlide && firstSlide.desktopType === 'image';
const firstSlidePreloadUrl = shouldPreloadFirstSlideImage ? firstSlide.desktopUrl : '';

const user = Astro.locals.user;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://flexformfitness.vercel.app';
const canonicalUrl = `${siteUrl}/${lang}`;

// Construct OnlineStore structured data JSON-LD for store profile rich snippets
const storeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'OnlineStore',
  'name': 'Flex Form Fitness',
  'url': canonicalUrl,
  'logo': `${siteUrl}/logo.png`,
  'image': `${siteUrl}/images/hero-slide1.png`,
  'description': isEn 
    ? "Explore the official activewear collection of FLEX FORM FITNESS. High-performance shirts, leggings, joggers, and hoodies." 
    : "Explora la colección oficial de ropa deportiva técnica de FLEX FORM FITNESS. Camisetas, mallas, joggers y sudaderas de alto rendimiento.",
  'priceRange': '$$',
  'address': {
    '@type': 'PostalAddress',
    'addressCountry': 'ES'
  }
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={isEn ? "Flex Form Fitness | Gymwear & Fitness Clothing" : "Flex Form Fitness | Ropa Fitness, Ropa Gym y Culturismo"}
      description={isEn ? "Discover Flex Form Fitness premium gymwear and fitness clothing. Specialized clothing bodybuilding and activewear engineered for peak performance." : "Descubre Flex Form Fitness, la marca líder en ropa fitness, ropa gym y ropa culturismo de alto rendimiento con tecnología sin costuras."}
      jsonLd={storeJsonLd}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    {firstSlidePreloadUrl && (
      <link rel="preload" href={firstSlidePreloadUrl} as="image" fetchpriority="high" />
    )}
  </head>
  <body class="bg-white text-slate-900 font-sans min-h-screen antialiased flex flex-col justify-between w-full overflow-x-hidden">
    
    <Navbar />

    <!-- Hero Image Carousel Section (Edge to Edge / Full Width) -->
    <section class="w-full aspect-[4/5] min-[900px]:aspect-[8/3] relative overflow-hidden bg-slate-950">
      <!-- Carousel Slides -->
      <div class="absolute inset-0 w-full h-full">
        {heroSlides.map((slide, index) => {
          const isFirst = index === 0;
          let button1Link = '#catalogo';
          if (slide.button1?.collectionId && collectionsMap[slide.button1.collectionId]) {
            button1Link = `/${lang}/colecciones/${collectionsMap[slide.button1.collectionId].slug}`;
          }

          let button2Link = '#catalogo';
          if (slide.button2?.collectionId && collectionsMap[slide.button2.collectionId]) {
            button2Link = `/${lang}/colecciones/${collectionsMap[slide.button2.collectionId].slug}`;
          }

          const showButton1 = slide.button1?.enabled !== false;
          const showButton2 = slide.button2?.enabled === true;

          const getButtonClass = (style?: string) => {
            if (style === 'primary') {
              return "px-3 py-1.5 sm:px-5 sm:py-2 min-[900px]:px-8 min-[900px]:py-3.5 bg-rose-600 text-white border-[1.5px] min-[900px]:border-2 border-rose-600 font-bold uppercase tracking-wider min-[900px]:tracking-widest hover:bg-rose-700 hover:border-rose-700 transition-all duration-300 text-[10px] sm:text-xs min-[900px]:text-sm shadow-md min-[900px]:shadow-lg active:scale-95 hero-slide-btn";
            }
            if (style === 'pink') {
              return "px-3 py-1.5 sm:px-5 sm:py-2 min-[900px]:px-8 min-[900px]:py-3.5 bg-pink-600 text-white border-[1.5px] min-[900px]:border-2 border-pink-600 font-bold uppercase tracking-wider min-[900px]:tracking-widest hover:bg-pink-700 hover:border-pink-700 transition-all duration-300 text-[10px] sm:text-xs min-[900px]:text-sm shadow-md min-[900px]:shadow-lg active:scale-95 hero-slide-btn";
            }
            return "px-3 py-1.5 sm:px-5 sm:py-2 min-[900px]:px-8 min-[900px]:py-3.5 border-[1.5px] min-[900px]:border-2 border-white text-white font-bold uppercase tracking-wider min-[900px]:tracking-widest hover:bg-white hover:text-slate-950 transition-all duration-300 text-[10px] sm:text-xs min-[900px]:text-sm shadow-md min-[900px]:shadow-lg active:scale-95 hero-slide-btn";
          };

          return (
            <div
              class={`hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ${isFirst ? 'opacity-100 scale-102 z-10' : 'opacity-0 scale-102 z-0'}`}
              data-index={index}
            >
              {/* Media for desktop (>= 900px) */}
              {slide.desktopType === 'image' ? (
                <div
                  class="hidden min-[900px]:block absolute inset-0 bg-cover bg-center"
                  style={`background-image: url(${slide.desktopUrl});`}
                >
                </div>
              ) : (
                <div class="hidden min-[900px]:block absolute inset-0 bg-slate-950">
                  <video
                    muted
                    playsinline
                    preload={isFirst ? "auto" : "none"}
                    class="w-full h-full object-cover object-center hero-video-desktop"
                  >
                    <source src={slide.desktopUrl} type="video/mp4" />
                  </video>
                </div>
              )}

              {/* Media for mobile (< 900px) */}
              {slide.mobileType === 'image' ? (
                <div
                  class="block min-[900px]:hidden absolute inset-0 bg-cover bg-center"
                  style={`background-image: url(${slide.mobileUrl});`}
                >
                </div>
              ) : (
                <div class="block min-[900px]:hidden absolute inset-0 bg-slate-950">
                  <video
                    muted
                    playsinline
                    preload={isFirst ? "auto" : "none"}
                    class="w-full h-full object-cover object-center hero-video-mobile"
                  >
                    <source src={slide.mobileUrl} type="video/mp4" />
                  </video>
                </div>
              )}

              {/* Subtle Overlay */}
              {slide.showDarkOverlay !== false && (
                <div class="absolute inset-0 bg-slate-950/30"></div>
              )}

              {/* Centered Logo and Text Overlay with Centered Buttons */}
              <div class={`absolute inset-0 flex flex-col items-center text-center px-4 z-10 ${slide.showTitleOverlay !== false ? 'justify-center' : 'justify-end pb-12 min-[900px]:pb-24'}`}>
                {slide.showTitleOverlay !== false && (
                  <div class="relative select-none pointer-events-none mb-3 sm:mb-5 min-[900px]:mb-8">
                    <!-- Massive Logo Overlay Text -->
                    <div class="text-4xl sm:text-6xl min-[900px]:text-8xl lg:text-9xl font-black italic tracking-tighter text-white/20 uppercase leading-none">
                      FLEX FORM
                    </div>
                    <div class="text-base sm:text-2xl min-[900px]:text-4xl lg:text-5xl font-black italic tracking-wider text-red-600 uppercase -mt-1 sm:-mt-2 min-[900px]:-mt-4 text-center">
                      FITNESS
                    </div>
                  </div>
                )}

                <!-- Hero Buttons: Centered in middle right under the logo -->
                <div class="flex flex-wrap justify-center items-center gap-2 sm:gap-3 min-[900px]:gap-4 max-w-full">
                  {showButton2 && (
                    <a href={button2Link} class={getButtonClass(slide.button2?.style)}>
                      {isEn ? (slide.button2?.textEn || 'New Capsule') : (slide.button2?.text || 'Nueva Cápsula')}
                    </a>
                  )}
                  {showButton1 && (
                    <a href={button1Link} class={getButtonClass(slide.button1?.style)}>
                      {isEn ? (slide.button1?.textEn || 'Shop now') : (slide.button1?.text || 'Comprar ahora')}
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Indicator Dots -->
      <div class="absolute bottom-3 right-4 sm:bottom-6 sm:right-6 min-[900px]:right-8 min-[900px]:bottom-8 flex gap-2 min-[900px]:gap-3 z-20">
        {heroSlides.map((_, idx) => (
          <button
            type="button"
            class={`hero-dot w-1.5 h-1.5 min-[900px]:w-2.5 min-[900px]:h-2.5 rounded-full border-[1.5px] min-[900px]:border-2 border-white transition-all duration-300 focus:outline-none ${idx === 0 ? 'bg-white' : 'bg-transparent hover:bg-white/40'}`}
            data-slide={idx}
            aria-label={`Diapositiva ${idx + 1}`}
          ></button>
        ))}
      </div>

      <!-- Carousel Logic Script -->
      <script is:inline>
        let currentSlide = 0;
        const slides = document.querySelectorAll('.hero-slide');
        const dots = document.querySelectorAll('.hero-dot');
        let autoPlayTimeout;

        function showSlide(index) {
          if (slides.length === 0) return;
          
          // Clear any pending transition timer
          clearTimeout(autoPlayTimeout);

          // Keep index bounded
          currentSlide = (index + slides.length) % slides.length;

          // Transition slides
          slides.forEach((slide, idx) => {
            const videos = slide.querySelectorAll('video');
            if (idx === currentSlide) {
              slide.classList.remove('opacity-0', 'z-0');
              slide.classList.add('opacity-100', 'z-10');
              
              // Play only the visible video (desktop vs mobile)
              videos.forEach(video => {
                const isMobileVideo = video.classList.contains('hero-video-mobile');
                const isDesktopVideo = video.classList.contains('hero-video-desktop');
                const isMobileScreen = window.innerWidth < 900;
                
                if ((isMobileVideo && isMobileScreen) || (isDesktopVideo && !isMobileScreen)) {
                  video.currentTime = 0;
                  video.play()
                    .then(() => { /* playing */ })
                    .catch(err => {
                      console.log("Video play blocked, falling back to timer:", err);
                      setupFallbackTimer();
                    });
                } else {
                  video.pause();
                }
              });
            } else {
              slide.classList.remove('opacity-100', 'z-10');
              slide.classList.add('opacity-0', 'z-0');
              videos.forEach(video => video.pause());
            }
          });

          // Schedule timer if active slide has no active video playing
          const activeSlide = slides[currentSlide];
          const activeVideos = activeSlide.querySelectorAll('video');
          let hasActiveVideo = false;
          
          activeVideos.forEach(video => {
            const isMobileVideo = video.classList.contains('hero-video-mobile');
            const isDesktopVideo = video.classList.contains('hero-video-desktop');
            const isMobileScreen = window.innerWidth < 900;
            if ((isMobileVideo && isMobileScreen) || (isDesktopVideo && !isMobileScreen)) {
              hasActiveVideo = true;
            }
          });

          if (!hasActiveVideo) {
            setupFallbackTimer();
          }

          // Update dots
          dots.forEach((dot, idx) => {
            if (idx === currentSlide) {
              dot.classList.remove('bg-transparent', 'hover:bg-white/40');
              dot.classList.add('bg-white');
            } else {
              dot.classList.remove('bg-white');
              dot.classList.add('bg-transparent', 'hover:bg-white/40');
            }
          });
        }

        function setupFallbackTimer() {
          clearTimeout(autoPlayTimeout);
          autoPlayTimeout = setTimeout(() => {
            showSlide(currentSlide + 1);
          }, 5000);
        }

        // Initialize click events for dots and video ended event listeners
        slides.forEach((slide, idx) => {
          const videos = slide.querySelectorAll('video');
          videos.forEach(video => {
            video.addEventListener('ended', () => {
              if (currentSlide === idx) {
                showSlide(currentSlide + 1);
              }
            });
          });
        });

        dots.forEach((dot, idx) => {
          dot.addEventListener('click', () => {
            showSlide(idx);
          });
        });

        // Handle window resize to trigger play on correct videos if screen size crosses breakpoint
        let resizeTimeout;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(() => {
            showSlide(currentSlide);
          }, 250);
        });

        // Initialize carousel on slide 0
        showSlide(0);
      </script>

      <style>
        /* Button transitions on slide change */
        .hero-slide .hero-slide-btn {
          opacity: 0;
          transform: translateY(15px);
          transition: opacity 0.4s ease, transform 0.4s ease;
        }
        .hero-slide.opacity-100 .hero-slide-btn {
          opacity: 1;
          transform: translateY(0);
          transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.3s, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.3s;
        }
        .hero-slide.opacity-100 .hero-slide-btn:nth-child(2) {
          transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.45s, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.45s;
        }
        
        @keyframes bounce-subtle {
          0%, 100% {
            transform: translateY(-2px);
          }
          50% {
            transform: translateY(2px);
          }
        }
        .animate-bounce-subtle {
          animation: bounce-subtle 1.8s infinite ease-in-out;
        }
      </style>
    </section>

    <!-- Floating Scroll Down Arrow Button -->
    <div class="relative w-full h-0 z-30">
      <a
        href="#catalogo"
        class="absolute -translate-y-1/2 left-1/2 -translate-x-1/2 bg-slate-950 text-white border-2 border-white w-10 h-10 md:w-12 md:h-12 rounded-full flex items-center justify-center shadow-lg focus:outline-none scroll-down-btn cursor-pointer shrink-0 aspect-square"
        aria-label={isEn ? "Scroll down to catalog" : "Bajar al catálogo"}
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 md:w-5 md:h-5 text-white">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m0 0l6.75-6.75M12 19.5l-6.75-6.75" />
        </svg>
      </a>
    </div>

    <!-- Main Products Catalog (Slightly Reduced Side Margins) -->
    <main id="catalogo" class="w-full px-3 sm:px-6 md:px-8 lg:px-12 xl:px-14 py-12 flex-grow flex flex-col gap-12 md:gap-16" style="padding-left: clamp(0.75rem, 2.5vw, 3.5rem); padding-right: clamp(0.75rem, 2.5vw, 3.5rem);">
      {homepageCollections.map((col, idx) => (
        <section class="collection-section w-full flex flex-col gap-6" data-collection-id={col.id}>
          {idx === 0 ? (
            /* First section: Centered with left & right divider lines on mobile, left-aligned on desktop */
            <div class="w-full pl-3 pr-2 sm:px-0 pb-3 flex flex-col items-center sm:flex-row sm:justify-between sm:items-center gap-4 select-none">
              <div class="flex items-center justify-center sm:justify-start gap-2 sm:gap-4 flex-grow w-full sm:w-auto">
                <div class="hidden sm:block w-16 h-[1px] bg-gradient-to-r from-transparent to-slate-400"></div>
                <div class="w-6 shrink-0 h-[1px] bg-slate-300 sm:hidden"></div>
                <h2 class="text-base md:text-lg font-black italic uppercase tracking-[0.25em] text-slate-800 whitespace-nowrap">
                  {col.title}
                </h2>
                <div class="w-6 shrink-0 h-[1px] bg-slate-300 sm:hidden"></div>
              </div>
              
              <div class="flex gap-6 text-xs font-extrabold tracking-widest uppercase shrink-0 pl-1 sm:pl-0">
                <button type="button" class="filter-tab-btn border-b-2 border-rose-600 text-rose-600 pb-2 px-1 focus:outline-none transition-all duration-200" data-filter="all">
                  {isEn ? "All" : "Todos"}
                </button>
                <button type="button" class="filter-tab-btn border-b-2 border-transparent text-slate-400 hover:text-slate-900 pb-2 px-1 focus:outline-none transition-all duration-200" data-filter="hombre">
                  {isEn ? "Men" : "Hombre"}
                </button>
                <button type="button" class="filter-tab-btn border-b-2 border-transparent text-slate-400 hover:text-slate-900 pb-2 px-1 focus:outline-none transition-all duration-200" data-filter="mujer">
                  {isEn ? "Women" : "Mujer"}
                </button>
              </div>
            </div>
          ) : (
            /* Subsequent sections: Premium centered title divider line + centered filters */
            <div class="w-full flex flex-col gap-4">
              <div class="w-full flex items-center justify-center my-6 px-4 md:px-12 select-none">
                <div class="flex-grow h-[1px] bg-gradient-to-r from-transparent to-slate-200"></div>
                <h2 class="flex-shrink mx-6 text-base md:text-lg font-black italic uppercase tracking-[0.25em] text-slate-800">
                  {col.title}
                </h2>
                <div class="flex-grow h-[1px] bg-gradient-to-l from-transparent to-slate-200"></div>
              </div>
              
              <div class="flex justify-center gap-6 text-xs font-extrabold tracking-widest uppercase">
                <button type="button" class="filter-tab-btn border-b-2 border-rose-600 text-rose-600 pb-2 px-1 focus:outline-none transition-all duration-200" data-filter="all">
                  {isEn ? "All" : "Todos"}
                </button>
                <button type="button" class="filter-tab-btn border-b-2 border-transparent text-slate-400 hover:text-slate-900 pb-2 px-1 focus:outline-none transition-all duration-200" data-filter="hombre">
                  {isEn ? "Men" : "Hombre"}
                </button>
                <button type="button" class="filter-tab-btn border-b-2 border-transparent text-slate-400 hover:text-slate-900 pb-2 px-1 focus:outline-none transition-all duration-200" data-filter="mujer">
                  {isEn ? "Women" : "Mujer"}
                </button>
              </div>
            </div>
          )}

          {/* Grid layout: 2 cols on mobile, 3 cols under 1000px (sm/md), 4 cols on desktop (lg) */}
