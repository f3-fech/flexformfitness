---
import { db } from '../../../lib/firebase';
import type { Product } from '../../../types';
import SEO from '../../../components/SEO.astro';
import Navbar from '../../../components/Navbar.astro';
import { ProductSelector } from '../../../components/ProductSelector';
import { getApparelAttributes } from '../../../lib/merchantUtils';
import { optimizeProduct } from '../../../lib/cdn';

export const prerender = true;

export async function getStaticPaths() {
  try {
    const productsSnap = await db.collection('products').get();
    
    if (productsSnap.empty) {
      return [];
    }

    return productsSnap.docs.flatMap((doc) => {
      const product = optimizeProduct({ id: doc.id, ...doc.data() } as Product);
      const paths = [
        {
          params: { lang: 'es', slug: product.slug },
          props: { product },
        },
        {
          params: { lang: 'en', slug: product.slug },
          props: { product },
        }
      ];

      // Fallback for doc.id if different from slug (e.g. from existing email links)
      if (doc.id && doc.id !== product.slug) {
        paths.push(
          {
            params: { lang: 'es', slug: doc.id },
            props: { product },
          },
          {
            params: { lang: 'en', slug: doc.id },
            props: { product },
          }
        );
      }

      return paths;
    });
  } catch (error) {
    console.error('Error fetching static paths from Firestore for products:', error);
    return [];
  }
}

interface Props {
  product: Product;
}

let { product } = Astro.props;

// In dev mode, fetch fresh product from Firestore so admin edits (color, variants, stock) reflect immediately
if (import.meta.env.DEV && Astro.params.slug) {
  try {
    const freshSnap = await db.collection('products').where('slug', '==', Astro.params.slug).limit(1).get();
    if (!freshSnap.empty) {
      product = optimizeProduct({ id: freshSnap.docs[0].id, ...freshSnap.docs[0].data() } as Product);
    } else {
      // Fallback: check if Astro.params.slug is the document ID
      const docSnap = await db.collection('products').doc(Astro.params.slug).get();
      if (docSnap.exists) {
        product = optimizeProduct({ id: docSnap.id, ...docSnap.data() } as Product);
      }
    }
  } catch (err) {
    console.error('Error fetching fresh product in DEV mode:', err);
  }
} else if (product) {
  product = optimizeProduct(product);
}

if (!product) {
  return Astro.redirect('/404');
}

const { lang = 'es' } = Astro.params;
const isEn = lang === 'en';

// Redirect to canonical slug if accessed by document ID
if (Astro.params.slug === product.id && product.slug && product.slug !== product.id) {
  return Astro.redirect(`/${lang}/productos/${product.slug}`);
}

const getObjectPosition = (url: string | undefined): string => {
  if (!url) return 'center';
  const match = url.match(/#pos=([a-zA-Z0-9%_-]+)/);
  if (match && match[1]) {
    return match[1].replace('_', ' ');
  }
  return 'center';
};

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://flexformfitness.com';
const canonicalUrl = `${siteUrl}/${lang}/productos/${product.slug}`;

const productTitle = isEn ? (product.title_en || product.title) : product.title;
const productDescription = isEn ? (product.description_en || product.description) : product.description;

const defaultAttrs = getApparelAttributes(product, product.variants?.[0] || null, isEn);

// Construct comprehensive Schema.org JSON-LD for Google Rich Results & Google Merchant Crawler
const offersList = product.variants && product.variants.length > 0
  ? product.variants.map((v) => {
      const vAttrs = getApparelAttributes(product, v, isEn);
      const vPrice = ((v.price ?? product.price) / 100).toFixed(2);
      const vUrl = `${canonicalUrl}?variant=${encodeURIComponent(v.sku || v.name || '')}`;
      return {
        '@type': 'Offer',
        'sku': v.sku || `${product.id}-${v.name}`,
        'name': `${productTitle} - ${v.name}`,
        'price': parseFloat(vPrice),
        'priceCurrency': 'EUR',
        'priceValidUntil': '2027-12-31',
        'itemCondition': 'https://schema.org/NewCondition',
        'availability': vAttrs.schemaAvailability,
        'url': vUrl,
        'seller': {
          '@type': 'Organization',
          'name': 'FlexForm Fitness',
        },
        'hasMerchantReturnPolicy': {
          '@type': 'MerchantReturnPolicy',
          'applicableCountry': 'ES',
          'returnPolicyCategory': 'https://schema.org/MerchantReturnFiniteReturnWindow',
          'merchantReturnDays': 14,
          'returnMethod': 'https://schema.org/ReturnByMail',
          'returnFees': 'https://schema.org/FreeReturn',
        },
        'shippingDetails': {
          '@type': 'OfferShippingDetails',
          'shippingRate': {
            '@type': 'MonetaryAmount',
            'value': '4.99',
            'currency': 'EUR',
          },
          'shippingDestination': {
            '@type': 'DefinedRegion',
            'addressCountry': 'ES',
          },
          'deliveryTime': {
            '@type': 'ShippingDeliveryTime',
            'handlingTime': {
              '@type': 'QuantitativeValue',
              'minValue': 1,
              'maxValue': 2,
              'unitCode': 'd',
            },
            'transitTime': {
              '@type': 'QuantitativeValue',
              'minValue': 2,
              'maxValue': 5,
              'unitCode': 'd',
            },
          },
        },
      };
    })
  : [
      {
        '@type': 'Offer',
        'sku': product.id,
        'price': parseFloat((product.price / 100).toFixed(2)),
        'priceCurrency': 'EUR',
        'priceValidUntil': '2027-12-31',
        'itemCondition': 'https://schema.org/NewCondition',
        'availability': defaultAttrs.schemaAvailability,
        'url': canonicalUrl,
        'seller': {
          '@type': 'Organization',
          'name': 'FlexForm Fitness',
        },
        'hasMerchantReturnPolicy': {
          '@type': 'MerchantReturnPolicy',
          'applicableCountry': 'ES',
          'returnPolicyCategory': 'https://schema.org/MerchantReturnFiniteReturnWindow',
          'merchantReturnDays': 14,
          'returnMethod': 'https://schema.org/ReturnByMail',
          'returnFees': 'https://schema.org/FreeReturn',
        },
        'shippingDetails': {
          '@type': 'OfferShippingDetails',
          'shippingRate': {
            '@type': 'MonetaryAmount',
            'value': '4.99',
            'currency': 'EUR',
          },
          'shippingDestination': {
            '@type': 'DefinedRegion',
            'addressCountry': 'ES',
          },
          'deliveryTime': {
            '@type': 'ShippingDeliveryTime',
            'handlingTime': {
              '@type': 'QuantitativeValue',
              'minValue': 1,
              'maxValue': 2,
              'unitCode': 'd',
            },
            'transitTime': {
              '@type': 'QuantitativeValue',
              'minValue': 2,
              'maxValue': 5,
              'unitCode': 'd',
            },
          },
        },
      },
    ];

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  'name': productTitle,
  'image': product.images,
  'description': productDescription,
  'sku': product.variants?.[0]?.sku || product.id,
  'category': defaultAttrs.category,
  'color': defaultAttrs.color,
  'size': defaultAttrs.size,
  'audience': {
    '@type': 'PeopleAudience',
    'suggestedGender': defaultAttrs.gender,
    'suggestedAge': {
      '@type': 'QuantitativeValue',
      'minValue': 13,
    },
  },
  'brand': {
    '@type': 'Brand',
    'name': 'FlexForm Fitness',
  },
  'offers': offersList.length === 1 ? offersList[0] : offersList,
};

// Dynamic sizes present in this product
const productSizes: string[] = [];
if (product.variants && product.variants.length > 0) {
  product.variants.forEach((v) => {
    const parts = v.name.split('/').map((p) => p.trim());
    const sz = parts[1] || parts[0];
    if (sz && !productSizes.includes(sz.toUpperCase())) {
      productSizes.push(sz.toUpperCase());
    }
  });
}

const hasSpecs = Boolean(
  product.specs && (product.specs.material || product.specs.fabricWeight || product.specs.fit)
);

const hasMeasurements = Boolean(
  product.sizeMeasurements && Object.keys(product.sizeMeasurements).length > 0 && productSizes.length > 0
);
const hasSizeChart = Boolean(hasMeasurements);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <SEO
      title={isEn ? (product.seo_en?.title || product.seo?.title || `${productTitle} | FLEX FORM FITNESS`) : (product.seo?.title || `${productTitle} | FLEX FORM FITNESS`)}
      description={isEn ? (product.seo_en?.description || product.seo?.description || productDescription) : (product.seo?.description || productDescription)}
      image={product.images[0]}
      canonicalUrl={canonicalUrl}
      ogType="product"
      jsonLd={productJsonLd}
    />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen antialiased">
    <Navbar />

    <main class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8 py-5 sm:py-6 lg:py-8">
      <!-- Minimalist Breadcrumb -->
      <nav class="mb-3.5 text-[10px] sm:text-[11px] font-medium tracking-[0.15em] text-slate-400 uppercase flex items-center gap-2 select-none">
        <a href={`/${lang}`} class="hover:text-black transition-colors">{isEn ? "STORE" : "TIENDA"}</a>
        <span>/</span>
        <a href={`/${lang}#catalogo`} class="hover:text-black transition-colors">{isEn ? "COLLECTIONS" : "COLECCIONES"}</a>
        <span>/</span>
        <span class="text-slate-900 font-semibold truncate max-w-[280px]">{productTitle}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-14 items-start">
        <!-- Left: Product Media Gallery (Image 3 Style) -->
        <div id="product-gallery" data-images={JSON.stringify(product.images)} class="lg:col-span-7 flex flex-col w-full items-start">
          <div class="product-gallery-wrapper w-full flex flex-col mx-auto lg:mx-0">
            <!-- Main featured product image -->
            <div class="aspect-[2/3] w-full bg-white border border-slate-200/80 relative overflow-hidden group select-none" style="aspect-ratio: 2/3;">
              <img
                src={product.images[0]}
                alt={productTitle}
                class="w-full h-full object-cover transition-opacity duration-300 opacity-0 cursor-zoom-in"
                style={`object-position: ${getObjectPosition(product.images[0])}`}
                id="main-product-image"
                onload="this.classList.remove('opacity-0')"
              />

              <!-- Desktop Hover Arrows -->
              {product.images.length > 1 && (
                <>
                  <button
                    type="button"
                    id="prev-image-btn"
                    class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/90 text-slate-900 border border-slate-200 shadow-sm flex items-center justify-center transition-all duration-150 hover:bg-white active:scale-95 z-10 hidden sm:flex opacity-0 group-hover:opacity-100 focus:opacity-100 cursor-pointer"
                    aria-label={isEn ? "Previous image" : "Imagen anterior"}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    id="next-image-btn"
                    class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/90 text-slate-900 border border-slate-200 shadow-sm flex items-center justify-center transition-all duration-150 hover:bg-white active:scale-95 z-10 hidden sm:flex opacity-0 group-hover:opacity-100 focus:opacity-100 cursor-pointer"
                    aria-label={isEn ? "Next image" : "Siguiente imagen"}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                    </svg>
                  </button>
                </>
              )}
            </div>

            <!-- Thumbnails Grid directly underneath (Image 3 Style) -->
            {product.images.length > 1 && (
              <div class="flex flex-wrap gap-2 mt-2.5 w-full">
                {product.images.map((img, idx) => (
                  <button
                    type="button"
                    data-index={idx}
                    class={`thumbnail-btn aspect-[2/3] w-14 sm:w-16 overflow-hidden bg-slate-50 border ${idx === 0 ? 'border-slate-950 ring-1 ring-slate-950' : 'border-slate-200 hover:border-slate-400'} focus:outline-none transition-all duration-150 cursor-pointer rounded-none shrink-0`}
                  >
                    <img src={img} alt={`${productTitle} vista ${idx + 1}`} class="w-full h-full object-cover" style={`object-position: ${getObjectPosition(img)}`} />
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- Right: Product Purchase Info (YoungLA Style - Image 3) -->
        <div class="lg:col-span-5 flex flex-col gap-3.5 lg:sticky lg:top-24">
          <!-- Minimalist Header & Titles -->
          <div class="flex flex-col gap-1">
            <h1 class="text-sm sm:text-base font-bold tracking-[0.16em] uppercase text-slate-950 leading-snug">
              {productTitle}
            </h1>
            <p class="text-[11px] sm:text-xs font-semibold tracking-[0.18em] uppercase text-slate-500">
              {isEn ? (product.category_en || 'F3 SYNERGIES') : (product.category || 'F3 SYNERGIES')}
            </p>

            <!-- Price -->
            <div class="text-sm sm:text-base font-medium text-slate-950 mt-1">
              {(product.price / 100).toFixed(2)} €
            </div>
          </div>

          <div class="w-full h-px bg-slate-200/80 my-1"></div>

          <!-- Interactive Client Component Selector -->
          <ProductSelector product={product} lang={lang} client:load />

          <div class="w-full h-px bg-slate-200/80 my-2"></div>

          <!-- Description & Real Specifications -->
          <div class="flex flex-col gap-3 text-xs leading-relaxed text-slate-600">
            {hasSpecs && (
              <>
                {product.specs?.material && (
                  <div class="flex flex-col gap-0.5">
                    <span class="font-bold text-slate-900 tracking-wider text-[11px] uppercase">
                      {isEn ? "MATERIAL:" : "MATERIAL:"}
                    </span>
                    <span class="text-slate-600">{product.specs.material}</span>
                  </div>
                )}
                {product.specs?.fabricWeight && (
                  <div class="flex flex-col gap-0.5">
                    <span class="font-bold text-slate-900 tracking-wider text-[11px] uppercase">
                      {isEn ? "FABRIC WEIGHT:" : "GRAMAJE:"}
                    </span>
                    <span class="text-slate-600">{product.specs.fabricWeight}</span>
                  </div>
                )}
                {product.specs?.fit && (
                  <div class="flex flex-col gap-0.5">
                    <span class="font-bold text-slate-900 tracking-wider text-[11px] uppercase">
                      {isEn ? "FIT:" : "CORTE / AJUSTE:"}
                    </span>
                    <span class="text-slate-600">{product.specs.fit}</span>
                  </div>
                )}
              </>
            )}

            {productDescription && (
              <div class="flex flex-col gap-0.5">
                <span class="font-bold text-slate-900 tracking-wider text-[11px] uppercase">
                  {isEn ? "DESCRIPTION:" : "DESCRIPCIÓN:"}
                </span>
                <p class="text-slate-600 leading-relaxed whitespace-pre-line">
                  {productDescription}
                </p>
              </div>
            )}
          </div>          <!-- Dynamic Size Chart in CM (Only if product has measurements) -->
          {hasSizeChart && (
            <div class="border-t border-slate-200/80 pt-5 mt-2 flex flex-col gap-2.5" id="product-size-chart-section">
              <h4 class="text-xs font-bold tracking-[0.16em] uppercase text-slate-900">
                {isEn ? "SIZE CHART (CM)" : "GUÍA DE MEDIDAS (CM)"}
              </h4>

              {hasMeasurements && (
                <div class="w-full border border-slate-200 bg-white p-4">
                  <div class="text-[11px] font-bold text-center uppercase tracking-wider text-slate-900 mb-3 pb-1 border-b border-slate-900">
                    {isEn ? `${product.title} Measurements (cm)` : `Medidas de la prenda (cm) - ${product.title}`}
                  </div>
                  <div class="overflow-x-auto">
                    <table class="w-full text-[11px] text-center border-collapse">
                      <thead>
                        <tr class="font-bold uppercase tracking-wider text-slate-900 border-b border-slate-200">
                          <th class="py-1 px-2 text-left font-bold">{isEn ? "Measurement" : "Medida (cm)"}</th>
                          {productSizes.map((sz) => (
                            <th class="py-1 px-2 font-bold font-mono">{sz.toUpperCase()}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-slate-100 font-mono text-slate-700">
                        {product.sizeMeasurements?.length && (
                          <tr>
                            <td class="py-1.5 px-2 text-left font-bold text-slate-900 font-sans">{isEn ? "Length (cm)" : "Largo (cm)"}</td>
                            {productSizes.map((sz) => (
                              <td class="py-1.5 px-2">{product.sizeMeasurements?.length?.[sz] || product.sizeMeasurements?.length?.[sz.toLowerCase()] || product.sizeMeasurements?.length?.[sz.toUpperCase()] || '-'}</td>
                            ))}
                          </tr>
                        )}
                        {product.sizeMeasurements?.chest && (
                          <tr>
                            <td class="py-1.5 px-2 text-left font-bold text-slate-900 font-sans">{isEn ? "Chest (cm)" : "Pecho (cm)"}</td>
                            {productSizes.map((sz) => (
                              <td class="py-1.5 px-2">{product.sizeMeasurements?.chest?.[sz] || product.sizeMeasurements?.chest?.[sz.toLowerCase()] || product.sizeMeasurements?.chest?.[sz.toUpperCase()] || '-'}</td>
                            ))}
                          </tr>
                        )}
                        {product.sizeMeasurements?.waist && (
                          <tr>
                            <td class="py-1.5 px-2 text-left font-bold text-slate-900 font-sans">{isEn ? "Waist (cm)" : "Cintura (cm)"}</td>
                            {productSizes.map((sz) => (
                              <td class="py-1.5 px-2">{product.sizeMeasurements?.waist?.[sz] || product.sizeMeasurements?.waist?.[sz.toLowerCase()] || product.sizeMeasurements?.waist?.[sz.toUpperCase()] || '-'}</td>
                            ))}
                          </tr>
                        )}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </main>

    <!-- Zoom Lightbox Modal -->
    <div id="image-zoom-modal" class="fixed inset-0 bg-slate-950/95 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300 backdrop-blur-md">
      <!-- Close Button -->
      <button 
        type="button" 
        id="close-zoom-modal" 
        class="absolute top-6 right-6 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors border border-white/10 z-10 cursor-pointer focus:outline-none"
        aria-label={isEn ? "Close zoom" : "Cerrar zoom"}
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Prev Arrow -->
      {product.images.length > 1 && (
        <button 
          type="button" 
          id="modal-prev-btn" 
          class="absolute left-6 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors border border-white/10 z-10 cursor-pointer focus:outline-none"
          aria-label={isEn ? "Previous image" : "Imagen anterior"}
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
          </svg>
        </button>
      )}

      <!-- Next Arrow -->
      {product.images.length > 1 && (
        <button 
          type="button" 
          id="modal-next-btn" 
          class="absolute right-6 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors border border-white/10 z-10 cursor-pointer focus:outline-none"
          aria-label={isEn ? "Next image" : "Siguiente imagen"}
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        </button>
      )}

      <!-- Modal Image Container -->
      <div id="modal-image-wrapper" class="relative overflow-hidden cursor-zoom-in flex items-center justify-center max-w-[90vw] max-h-[85vh] select-none rounded-lg">
        <img 
          id="modal-zoomed-image" 
          src="" 
          alt={productTitle}
          class="max-w-full max-h-[85vh] object-contain transition-transform duration-300 ease-out origin-center" 
          draggable="false"
        />
      </div>
    </div>

    <!-- Footer (Full Width) -->
    <footer id="contacto" class="w-full bg-slate-900 text-slate-400 py-16 px-4 md:px-8 border-t border-slate-850 mt-20">
      <div class="w-full grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
        <!-- Logo and info -->
        <div class="flex flex-col gap-4 col-span-2 md:col-span-1">
          <a href={`/${lang}`} class="flex flex-col">
            <span class="text-xl md:text-2xl font-black italic tracking-tighter text-white uppercase leading-none">
              FLEX <span class="text-red-550">FORM</span>
            </span>
            <span class="text-[8px] font-extrabold tracking-[0.25em] text-slate-500 uppercase leading-none mt-0.5">
              FITNESS
            </span>
          </a>
          <p class="text-xs text-slate-500 leading-relaxed">
            {isEn ? "High-performance sportswear and premium accessories designed for dedicated athletes." : "Ropa deportiva de alto rendimiento y accesorios premium diseñados para atletas dedicados."}
          </p>
        </div>

        <!-- Links Colecciones -->
        <div class="flex flex-col gap-3 col-span-1">
          <h4 class="text-xs font-bold text-white tracking-widest uppercase">{isEn ? "COLLECTIONS" : "COLECCIONES"}</h4>
          <ul class="text-xs flex flex-col gap-2">
            <li><a href={`/${lang}#catalogo`} class="hover:text-white transition-colors">{isEn ? "New Arrivals" : "Novedades"}</a></li>
            <li><a href={`/${lang}#catalogo`} class="hover:text-white transition-colors">{isEn ? "Men" : "Hombre"}</a></li>
            <li><a href={`/${lang}#catalogo`} class="hover:text-white transition-colors">{isEn ? "Women" : "Mujer"}</a></li>
            <li><a href={`/${lang}#catalogo`} class="hover:text-white transition-colors">{isEn ? "Bestsellers" : "Más Vendidos"}</a></li>
          </ul>
        </div>

        <!-- Links Soporte -->
        <div class="flex flex-col gap-3 col-span-1">
          <h4 class="text-xs font-bold text-white tracking-widest uppercase">{isEn ? "SUPPORT" : "SOPORTE"}</h4>
          <ul class="text-xs flex flex-col gap-2">
            <li><a href={`/${lang}/contacto`} class="hover:text-white transition-colors font-semibold text-rose-500">{isEn ? "Contact Support" : "Contacto / Soporte"}</a></li>
            <li><a href="#" class="hover:text-white transition-colors">{isEn ? "Shipping & Deliveries" : "Envíos y Entregas"}</a></li>
            <li><a href={`/${lang}/devoluciones`} class="hover:text-white transition-colors">{isEn ? "Returns" : "Devoluciones"}</a></li>
            <li><a href="#" class="hover:text-white transition-colors">{isEn ? "Size Guide" : "Guía de Tallas"}</a></li>
          </ul>
        </div>

        <!-- Newsletter -->
        <div class="flex flex-col gap-3 col-span-2 md:col-span-1">
          <h4 class="text-xs font-bold text-white tracking-widest uppercase">NEWSLETTER</h4>
          <p class="text-xs text-slate-500 leading-relaxed">{isEn ? "Subscribe to receive a 10% discount on your first order and exclusive deals." : "Suscríbete para recibir un 10% de descuento en tu primer pedido y ofertas exclusivas."}</p>
          <div class="flex gap-2 mt-1">
            <input type="email" id="newsletter-email" placeholder={isEn ? "Your email" : "Tu email"} class="bg-slate-800 text-white placeholder-slate-500 border border-slate-700 px-3 py-2 text-xs focus:outline-none focus:border-white w-full" />
            <button id="newsletter-submit-btn" class="bg-white text-slate-900 px-4 py-2 text-xs font-bold uppercase hover:bg-red-600 hover:text-white transition-colors">OK</button>
          </div>
        </div>
      </div>

      <div class="w-full pt-8 border-t border-slate-850 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] md:text-2xs text-slate-550">
        <p class="text-center md:text-left">&copy; {new Date().getFullYear()} FLEX FORM FITNESS. {isEn ? "All rights reserved." : "Todos los derechos reservados."} {isEn ? "in collaboration with" : "en colaboración con"} <a href="https://javiphoto.es" target="_blank" class="hover:text-white underline transition-colors">javiphoto.es</a></p>
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-1.5 md:gap-x-6">
          <a href={`/${lang}/condiciones`} class="hover:text-white transition-colors">Condiciones de Uso</a>
          <a href={`/${lang}/privacidad`} class="hover:text-white transition-colors">Política de Privacidad</a>
          <a href={`/${lang}/cookies`} class="hover:text-white transition-colors">Cookies</a>
        </div>
      </div>
    </footer>
    <script>
      // Execute when DOM is ready
      function initGallery() {
        const gallery = document.getElementById('product-gallery');
        const mainImg = document.getElementById('main-product-image') as HTMLImageElement;
        const prevBtn = document.getElementById('prev-image-btn');
        const nextBtn = document.getElementById('next-image-btn');

        if (!gallery || !mainImg) return;

        let images: string[] = [];
        try {
          images = JSON.parse(gallery.dataset.images || '[]');
        } catch (e) {
          console.error('Failed to parse gallery images:', e);
          return;
        }

        if (images.length === 0) return;

        let currentIndex = 0;

        function changeToImage(idx: number) {
          if (idx < 0) idx = images.length - 1;
          if (idx >= images.length) idx = 0;

          currentIndex = idx;
          const newSrc = images[idx];

          mainImg.classList.add('opacity-0');
          mainImg.src = newSrc;

          const match = newSrc.match(/#pos=([a-zA-Z0-9%_-]+)/);
          mainImg.style.objectPosition = match ? match[1].replace('_', ' ') : 'center';
        }

        function updateActiveThumbnail(src: string) {
          const thumbnails = gallery?.querySelectorAll('.thumbnail-btn');
          if (!thumbnails) return;

          let matchedIndex = -1;

          // Helper to normalize URL for comparison
          const getPathname = (urlStr: string) => {
            try {
              return new URL(urlStr, window.location.origin).pathname;
            } catch {
              return urlStr;
            }
          };

          const targetPath = getPathname(src);

          thumbnails.forEach((thumb, idx) => {
            const thumbImg = thumb.querySelector('img');
            if (thumbImg && getPathname(thumbImg.src) === targetPath) {
              matchedIndex = idx;
            }
          });

          if (matchedIndex !== -1) {
            currentIndex = matchedIndex;
            thumbnails.forEach((thumb, idx) => {
              if (idx === matchedIndex) {
                thumb.classList.remove('border-slate-200', 'hover:border-slate-400');
                thumb.classList.add('border-slate-950', 'ring-1', 'ring-slate-950');
              } else {
                thumb.classList.remove('border-slate-950', 'ring-1', 'ring-slate-950');
                thumb.classList.add('border-slate-200', 'hover:border-slate-400');
              }
            });

            // Scroll thumbnail into view if needed
            const activeThumb = thumbnails[matchedIndex] as HTMLElement;
            activeThumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
          }
        }

        // Wire up thumbnail clicks
        const thumbnails = gallery.querySelectorAll('.thumbnail-btn');
        thumbnails.forEach((thumb) => {
          thumb.addEventListener('click', () => {
            const idx = parseInt(thumb.getAttribute('data-index') || '0', 10);
            changeToImage(idx);
          });
        });

        // Wire up desktop arrow buttons
        prevBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          changeToImage(currentIndex - 1);
        });

        nextBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          changeToImage(currentIndex + 1);
        });

        // Synchronize on main image load (triggered by variant clicks or thumbnail/arrow switches)
        mainImg.addEventListener('load', () => {
          mainImg.classList.remove('opacity-0');
          updateActiveThumbnail(mainImg.src);
        });

        // Initial setup for loaded image active state
        updateActiveThumbnail(mainImg.src);

        // Swipe gestures on mobile
        const mainImageContainer = mainImg.parentElement;
        if (mainImageContainer) {
          let touchStartX = 0;
          let touchStartY = 0;
          let touchStartTime = 0;

          mainImageContainer.addEventListener('touchstart', (e) => {
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
            touchStartTime = Date.now();
          }, { passive: true });

          mainImageContainer.addEventListener('touchend', (e) => {
            const touchEndX = e.changedTouches[0].clientX;
            const touchEndY = e.changedTouches[0].clientY;
            const touchEndTime = Date.now();

            const diffX = touchEndX - touchStartX;
            const diffY = touchEndY - touchStartY;
            const duration = touchEndTime - touchStartTime;

            // Swipe: short duration, significant horizontal movement, mostly horizontal direction
            if (duration < 500 && Math.abs(diffX) > 45 && Math.abs(diffX) > Math.abs(diffY) * 1.4) {
              if (diffX > 0) {
                // Swipe right -> Previous
                changeToImage(currentIndex - 1);
              } else {
                // Swipe left -> Next
                changeToImage(currentIndex + 1);
              }
            }
          });
        }

        // Zoom Modal Elements & Initialization
        const zoomModal = document.getElementById('image-zoom-modal');
        const modalImg = document.getElementById('modal-zoomed-image') as HTMLImageElement;
        const closeModal = document.getElementById('close-zoom-modal');
        const modalPrevBtn = document.getElementById('modal-prev-btn');
        const modalNextBtn = document.getElementById('modal-next-btn');
        const wrapper = document.getElementById('modal-image-wrapper');

        let isZoomed = false;

        if (zoomModal && modalImg && closeModal && wrapper) {
          mainImg.addEventListener('click', () => {
            modalImg.src = mainImg.src;
            zoomModal.classList.remove('hidden');
            setTimeout(() => {
              zoomModal.classList.remove('opacity-0');
            }, 10);
            document.body.style.overflow = 'hidden';
          });

          const handleClose = () => {
            zoomModal.classList.add('opacity-0');
            setTimeout(() => {
              zoomModal.classList.add('hidden');
              isZoomed = false;
              modalImg.style.transform = 'scale(1)';
              modalImg.style.transformOrigin = 'center';
              wrapper.classList.remove('cursor-zoom-out');
              wrapper.classList.add('cursor-zoom-in');
            }, 300);
            document.body.style.overflow = '';
          };

          closeModal.addEventListener('click', handleClose);

          zoomModal.addEventListener('click', (e) => {
            if (e.target === zoomModal) {
              handleClose();
            }
          });

          wrapper.addEventListener('click', (e: any) => {
            if (e.target.closest('#close-zoom-modal') || e.target.closest('#modal-prev-btn') || e.target.closest('#modal-next-btn')) return;

            isZoomed = !isZoomed;
            if (isZoomed) {
              modalImg.style.transform = 'scale(2.5)';
              wrapper.classList.remove('cursor-zoom-in');
              wrapper.classList.add('cursor-zoom-out');
              pan(e);
            } else {
              modalImg.style.transform = 'scale(1)';
              modalImg.style.transformOrigin = 'center';
              wrapper.classList.remove('cursor-zoom-out');
              wrapper.classList.add('cursor-zoom-in');
            }
          });

          const pan = (e: MouseEvent | TouchEvent) => {
            if (!isZoomed) return;
            const rect = wrapper.getBoundingClientRect();
            let clientX = 0;
            let clientY = 0;

            if (window.TouchEvent && e instanceof TouchEvent) {
              if (e.touches.length === 0) return;
              clientX = e.touches[0].clientX;
              clientY = e.touches[0].clientY;
            } else if (e instanceof MouseEvent) {
              clientX = e.clientX;
              clientY = e.clientY;
            }

            const x = clientX - rect.left;
            const y = clientY - rect.top;
            const xPercent = (x / rect.width) * 100;
            const yPercent = (y / rect.height) * 100;
            modalImg.style.transformOrigin = `${xPercent}% ${yPercent}%`;
          };

          wrapper.addEventListener('mousemove', pan);
          wrapper.addEventListener('touchmove', pan, { passive: true });

          if (modalPrevBtn) {
            modalPrevBtn.addEventListener('click', (ev) => {
              ev.stopPropagation();
              changeToImage(currentIndex - 1);
              modalImg.src = mainImg.src;
              isZoomed = false;
              modalImg.style.transform = 'scale(1)';
              wrapper.classList.remove('cursor-zoom-out');
              wrapper.classList.add('cursor-zoom-in');
            });
          }

          if (modalNextBtn) {
            modalNextBtn.addEventListener('click', (ev) => {
              ev.stopPropagation();
              changeToImage(currentIndex + 1);
              modalImg.src = mainImg.src;
              isZoomed = false;
              modalImg.style.transform = 'scale(1)';
              wrapper.classList.remove('cursor-zoom-out');
              wrapper.classList.add('cursor-zoom-in');
            });
          }

          const keydownHandler = (ev: KeyboardEvent) => {
            if (zoomModal.classList.contains('hidden')) return;
            if (ev.key === 'Escape') {
              handleClose();
            } else if (ev.key === 'ArrowLeft' && modalPrevBtn) {
              modalPrevBtn.click();
            } else if (ev.key === 'ArrowRight' && modalNextBtn) {
              modalNextBtn.click();
            }
          };

          document.addEventListener('keydown', keydownHandler);
          
          document.addEventListener('astro:before-swap', () => {
            document.removeEventListener('keydown', keydownHandler);
            document.body.style.overflow = '';
          }, { once: true });
        }
      }

      // Initialize on load and re-run on page transitions if applicable
      initGallery();
      document.addEventListener('astro:after-swap', initGallery);
    </script>

    <style is:global>
      /* Thin elegant scrollbar for the vertical thumbnail list */
      .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
        height: 5px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
      }

      /* Responsive gallery sizing: on standard desktop displays (like 1920x1080), limit height to fit viewport */
      @media (min-width: 1024px) {
        .product-gallery-wrapper {
          max-width: min(100%, calc((100vh - 15.5rem) * 2 / 3));
        }
      }

      /* On larger/taller screens (> 1080p height, e.g. 1440p and 4K displays), let it expand fully */
      @media (min-width: 1024px) and (min-height: 1100px) {
        .product-gallery-wrapper {
          max-width: 100%;
        }
      }
    </style>
  </body>
</html>
