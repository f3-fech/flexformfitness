---
import SEO from '../../components/SEO.astro';
import { getGeneralSettings } from '../../lib/settings';

export const prerender = true; // Pre-rendered static shell, client-side dynamic login

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const isEn = lang === 'en';
const settings = await getGeneralSettings();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={isEn ? "Sign In | FLEX FORM FITNESS" : "Iniciar Sesión | FLEX FORM FITNESS"}
      description={isEn ? "Sign in to your FLEX FORM FITNESS account. Access your orders, track shipments, and checkout quickly." : "Inicia sesión en tu cuenta de FLEX FORM FITNESS. Accede a tus pedidos, haz seguimiento de envíos y compra con rapidez."}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;950&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen antialiased flex flex-col justify-center py-10 px-4 sm:px-6">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
      <div class="bg-white border border-slate-200 p-8 sm:p-10 rounded-none shadow-none">
        
        <!-- Header & Logo -->
        <div class="text-center flex flex-col items-center mb-6">
          <a href={`/${lang}`} class="inline-flex flex-col items-center group mb-4">
            {settings.logoUrl ? (
              <img src={settings.logoUrl} alt="FLEX FORM FITNESS" class="h-9 sm:h-11 w-auto object-contain" />
            ) : (
              <span class="text-2xl font-black italic tracking-tighter text-slate-950 uppercase leading-none">
                FLEX <span class="text-rose-600">FORM</span>
              </span>
            )}
          </a>
          <h1 class="text-xs sm:text-[13px] font-bold tracking-[0.24em] uppercase text-slate-950">
            {isEn ? "SIGN IN" : "INICIAR SESIÓN"}
          </h1>
          <p class="mt-2 text-xs text-slate-500 font-normal">
            {isEn ? "Don't have an account yet?" : "¿Aún no tienes cuenta?"}{" "}
            <a href={`/${lang}/registro`} class="text-slate-950 underline underline-offset-4 font-semibold hover:text-rose-600 transition-colors">
              {isEn ? "Create one" : "Crea una"}
            </a>
          </p>
        </div>

        <!-- Error notification box -->
        <div id="error-box" class="hidden mb-5 p-3 rounded-none bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium text-center leading-relaxed">
        </div>

        <!-- Google Auth Button -->
        <div class="w-full">
          <button
            type="button"
            id="google-btn"
            class="w-full inline-flex justify-center items-center py-3 px-4 rounded-none border border-slate-300 hover:border-black bg-white text-xs font-bold uppercase tracking-[0.16em] text-slate-900 transition-colors duration-150 gap-2.5 cursor-pointer select-none"
          >
            <!-- Google logo vector -->
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" width="24" height="24">
              <path fill="#EA4335" d="M12 5.04c1.74 0 3.3.6 4.53 1.78l3.39-3.39C17.84 1.54 15.11 1 12 1 7.24 1 3.2 3.73 1.24 7.72l3.96 3.07C6.18 7.73 8.84 5.04 12 5.04z" />
              <path fill="#4285F4" d="M23.49 12.27c0-.81-.07-1.59-.2-2.36H12v4.51h6.46c-.29 1.48-1.14 2.73-2.42 3.57l3.77 2.92c2.2-2.03 3.68-5.03 3.68-8.64z" />
              <path fill="#FBBC05" d="M5.2 13.91c-.24-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29L1.24 6.26C.44 7.98 0 9.89 0 11.9s.44 3.92 1.24 5.64l3.96-3.63z" />
              <path fill="#34A853" d="M12 23c3.24 0 5.97-1.07 7.96-2.91l-3.77-2.92c-1.11.75-2.53 1.19-4.19 1.19-3.16 0-5.82-2.69-6.8-5.75L1.24 16.2C3.2 20.27 7.24 23 12 23z" />
            </svg>
            <span>{isEn ? "Continue with Google" : "Continuar con Google"}</span>
          </button>
        </div>

        <!-- Separator -->
        <div class="my-6 relative flex items-center justify-center">
          <div class="w-full border-t border-slate-200"></div>
          <span class="bg-white px-3 text-[10px] font-mono uppercase tracking-[0.2em] text-slate-400 absolute">
            {isEn ? "OR WITH EMAIL" : "O CON TU CORREO"}
          </span>
        </div>

        <!-- Credentials Form -->
        <form id="login-form" class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="email" class="block text-[10px] font-bold text-slate-700 uppercase tracking-[0.16em]">
              {isEn ? "Email Address" : "Correo Electrónico"}
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="ejemplo@correo.com"
              class="w-full px-3.5 py-2.5 rounded-none border border-slate-300 bg-white placeholder-slate-400 text-slate-900 focus:outline-none focus:border-black transition-colors text-xs font-sans"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="password" class="block text-[10px] font-bold text-slate-700 uppercase tracking-[0.16em]">
              {isEn ? "Password" : "Contraseña"}
            </label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              placeholder="••••••••"
              class="w-full px-3.5 py-2.5 rounded-none border border-slate-300 bg-white placeholder-slate-400 text-slate-900 focus:outline-none focus:border-black transition-colors text-xs font-sans"
            />
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3.5 px-4 rounded-none bg-slate-950 hover:bg-slate-800 text-white font-bold text-xs tracking-[0.2em] uppercase transition-colors duration-150 cursor-pointer shadow-none active:scale-[0.99] flex items-center justify-center gap-2 mt-2 select-none"
          >
            <span>{isEn ? "Sign In" : "Iniciar Sesión"}</span>
          </button>
        </form>

      </div>
    </div>

    <!-- Client-side script handling Firebase Authentication and backend integration -->
    <script>
      import { auth, googleProvider } from '../../lib/firebaseClient';
      import { signInWithPopup, signInWithEmailAndPassword } from 'firebase/auth';
      import { actions } from 'astro:actions';

      const loginForm = document.getElementById('login-form') as HTMLFormElement;
      const googleBtn = document.getElementById('google-btn') as HTMLButtonElement;
      const errorBox = document.getElementById('error-box') as HTMLDivElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

      function getIsEn() {
        return window.location.pathname.startsWith('/en');
      }

      function showError(message: string) {
        errorBox.innerHTML = message;
        errorBox.classList.remove('hidden');
      }

      function hideError() {
        errorBox.innerHTML = '';
        errorBox.classList.add('hidden');
      }

      // Handle server-side session exchange
      async function createSession(user: any) {
        const idToken = await user.getIdToken();
        
        const response = await fetch('/api/auth/session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ idToken }),
        });

        if (!response.ok) {
          const result = await response.json();
          throw new Error(result.message || (getIsEn() ? 'Error starting session on server' : 'Error al iniciar sesión en el servidor'));
        }

        // Redirect to homepage
        const pathSegments = window.location.pathname.split('/');
        const currentLang = pathSegments[1] || 'es';
        window.location.href = `/${currentLang}`;
      }

      // Traditional email/password sign-in
      loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();
        
        const emailInput = document.getElementById('email') as HTMLInputElement;
        const passwordInput = document.getElementById('password') as HTMLInputElement;
        
        const email = emailInput.value;
        const password = passwordInput.value;
        const isEn = getIsEn();
        
        // Disable inputs and show loading state
        submitBtn.disabled = true;
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = `<span>${isEn ? 'Verifying...' : 'Verificando...'}</span>`;

        try {
          const userCredential = await signInWithEmailAndPassword(auth, email, password);
          
          // Verify if email has been verified
          if (!userCredential.user.emailVerified) {
            const { signOut } = await import('firebase/auth');
            await signOut(auth);
            
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
            
            showError(isEn 
              ? 'Your email address has not been verified. <a href="#" id="resend-verification-btn" class="font-bold underline ml-1 text-rose-600 hover:text-rose-700">Resend verification link</a>'
              : 'Tu correo electrónico no ha sido verificado. <a href="#" id="resend-verification-btn" class="font-bold underline ml-1 text-rose-600 hover:text-rose-700">Reenviar enlace de verificación</a>'
            );
            
            const resendBtn = document.getElementById('resend-verification-btn');
            resendBtn?.addEventListener('click', async (event) => {
              event.preventDefault();
              try {
                const { sendEmailVerification } = await import('firebase/auth');
                await sendEmailVerification(userCredential.user);
                showError(isEn 
                  ? '<span class="text-green-600">Verification link resent! Check your inbox.</span>'
                  : '<span class="text-green-600">¡Enlace de verificación reenviado! Revisa tu bandeja de entrada.</span>'
                );
              } catch (resendErr: any) {
                console.error('Error resending email verification:', resendErr);
                showError(isEn 
                  ? 'Error resending verification: ' + (resendErr.message || resendErr.code)
                  : 'Error al reenviar el enlace: ' + (resendErr.message || resendErr.code)
                );
              }
            });
            return;
          }

          await createSession(userCredential.user);
        } catch (error: any) {
          console.error('Email sign in error:', error);
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
          
          let translatedMessage = isEn 
            ? 'An error occurred during sign in. Check your credentials.' 
            : 'Ocurrió un error al iniciar sesión. Comprueba tus credenciales.';
          if (error.code === 'auth/invalid-credential' || error.code === 'auth/wrong-password' || error.code === 'auth/user-not-found') {
            translatedMessage = isEn ? 'Incorrect email or password.' : 'El correo o la contraseña son incorrectos.';
          } else if (error.code === 'auth/invalid-email') {
            translatedMessage = isEn ? 'The email format is invalid.' : 'El formato del correo electrónico no es válido.';
          }
          showError(translatedMessage);
        }
      });

      // Google Auth Sign-in
      googleBtn?.addEventListener('click', async () => {
        hideError();
        googleBtn.disabled = true;
        const originalContent = googleBtn.innerHTML;
        const isEn = getIsEn();
        googleBtn.innerHTML = `<span>${isEn ? 'Connecting Google...' : 'Conectando con Google...'}</span>`;

        try {
          const userCredential = await signInWithPopup(auth, googleProvider);
          try {
            await actions.saveMarketingConsent({
              email: userCredential.user.email || '',
              consent: true,
              name: userCredential.user.displayName || '',
              userId: userCredential.user.uid,
            });
          } catch (consentErr) {
            console.error('Error saving marketing consent during Google sign in:', consentErr);
          }
          await createSession(userCredential.user);
        } catch (error: any) {
          console.error('Google sign in error:', error);
          googleBtn.disabled = false;
          googleBtn.innerHTML = originalContent;
          
          if (error.code !== 'auth/popup-closed-by-user') {
            showError(isEn 
              ? 'Error connecting with Google: ' + (error.message || error.code)
              : 'Error al conectar con Google: ' + (error.message || error.code)
            );
          }
        }
      });
    </script>
  </body>
</html>
