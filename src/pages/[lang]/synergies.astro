    <!-- Form Submit Script -->
    <script>
      import { actions, isInputError } from 'astro:actions';

      const form = document.getElementById('synergy-form') as HTMLFormElement;
      const submitBtn = document.getElementById('synergy-submit-btn') as HTMLButtonElement;
      const errorBox = document.getElementById('synergy-error-box') as HTMLDivElement;
      const errorText = document.getElementById('synergy-error-text') as HTMLSpanElement;
      const successBox = document.getElementById('synergy-success-box') as HTMLDivElement;

      if (form && submitBtn) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errorBox.classList.add('hidden');
          submitBtn.disabled = true;
          
          const isEn = window.location.pathname.startsWith('/en');
          const originalText = submitBtn.innerHTML;
          submitBtn.innerHTML = `<span>${isEn ? 'Sending...' : 'Enviando...'}</span>`;

          const formData = new FormData(form);
          const gymName = (formData.get('gymName') as string || '').trim();
          const contactName = (formData.get('contactName') as string || '').trim();
          const email = (formData.get('email') as string || '').trim();
          const phone = (formData.get('phone') as string || '').trim();
          const city = (formData.get('city') as string || '').trim();
          const instagram = (formData.get('instagram') as string || '').trim();
          const message = (formData.get('message') as string || '').trim();

          try {
            const { data, error } = await actions.submitSynergyApplication({
              gymName,
              contactName,
              email,
              phone,
              city,
              instagram,
              message,
            });

            if (error) {
              if (isInputError(error)) {
                const fields = error.fields as Record<string, string[] | undefined>;
                const keys = Object.keys(fields);
                if (keys.length > 0 && fields[keys[0]]?.[0]) {
                  throw new Error(fields[keys[0]]![0]);
                }
              }
              throw new Error(error.message || (isEn ? 'Failed to submit.' : 'Error al enviar la solicitud.'));
            }

            if (data?.success) {
              form.style.display = 'none';
              successBox.classList.remove('hidden');
            } else {
              throw new Error(isEn ? 'Failed to submit.' : 'Error al enviar la solicitud.');
            }
          } catch (err: any) {
            console.error('Synergy form error:', err);
            errorText.textContent = err.message || (isEn ? 'An unexpected error occurred.' : 'Ha ocurrido un error inesperado.');
            errorBox.classList.remove('hidden');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
          }
        });
      }
    </script>
