const texts = isEn ? t.en : t.es;
const isComingSoon = true;
---

<!doctype html>
<html lang={lang} class="scroll-smooth bg-white">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO 
      title={texts.seoTitle} 
      description={texts.seoDesc} 
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-white text-slate-900 font-sans min-h-screen flex flex-col antialiased selection:bg-rose-600 selection:text-white">
    <!-- Navbar (Siempre visible y funcional arriba) -->
    <Navbar />

    <main class="flex-grow flex flex-col min-h-[calc(100vh-80px)] relative">
      <!-- FULL-VIEWPORT COMING SOON SCREEN (Cubre toda la página debajo del Navbar) -->
      <section class="flex-grow flex flex-col items-center justify-center bg-slate-950 text-white px-4 sm:px-8 py-20 relative overflow-hidden select-none">
        <!-- Background glow & grid accents -->
        <div class="absolute inset-0 opacity-25 pointer-events-none bg-[radial-gradient(#e11d48_1px,transparent_1px)] [background-size:24px_24px]"></div>
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-rose-600/15 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Content Box -->
        <div class="max-w-xl mx-auto text-center flex flex-col items-center relative z-10">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rose-600/10 border border-rose-500/30 text-rose-400 text-3xs font-extrabold uppercase tracking-widest mb-6 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
            <span>{isEn ? "Under Development · Launching Soon" : "En Desarrollo · Lanzamiento Próximo"}</span>
          </div>

          <h1 class="text-4xl sm:text-6xl md:text-7xl font-black italic tracking-tighter uppercase leading-none mb-4">
            F3 <span class="text-rose-600">SYNERGIES</span>
          </h1>

          <p class="text-xs sm:text-sm font-mono font-black tracking-[0.35em] text-rose-500 uppercase mb-6">
            — COMING SOON —
          </p>

          <p class="text-xs sm:text-sm text-slate-400 max-w-md mx-auto leading-relaxed mb-8">
            {isEn
              ? "We are finalizing exclusive apparel partnerships with top gyms and athletic communities. The official portal will be available very soon."
              : "Estamos ultimando las alianzas exclusivas y colecciones cápsula junto a gimnasios y atletas. El portal oficial de sinergias estará disponible muy pronto."}
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto">
            <a 
              href={`/${lang}#catalogo`} 
              class="w-full sm:w-auto px-8 py-3.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold uppercase tracking-widest transition-all rounded-xl shadow-lg shadow-rose-950/50 flex items-center justify-center gap-2"
            >
              <span>{isEn ? "Visit Store" : "Visitar Tienda"}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg>
            </a>

            <a 
              href={`/${lang}/contacto`} 
              class="w-full sm:w-auto px-8 py-3.5 bg-slate-900 hover:bg-slate-850 text-slate-300 border border-slate-800 text-xs font-bold uppercase tracking-widest transition-colors rounded-xl flex items-center justify-center gap-2"
            >
              <span>{isEn ? "Contact Support" : "Contacto / Alianzas"}</span>
            </a>
          </div>
        </div>
      </section>

      <!-- HIDDEN ORIGINAL CONTENT -->
      <div class="hidden">
      <!-- HERO SECTION (CLEAN WHITE) -->
      <section class="w-full bg-white border-b border-slate-100 py-16 sm:py-24 px-4 sm:px-8">
        <div class="max-w-5xl mx-auto text-center flex flex-col items-center">
          
          <span class="text-xs font-black tracking-[0.25em] text-rose-600 uppercase mb-4">
            {texts.heroPre}
          </span>

          <h1 class="text-3xl sm:text-5xl md:text-6xl font-black italic tracking-tight uppercase text-slate-950 leading-tight mb-6">
            F3 <span class="text-rose-600">SYNERGIES</span> PROJECT
          </h1>

          <p class="text-sm sm:text-base md:text-lg text-slate-600 font-normal max-w-2xl mx-auto leading-relaxed mb-8">
            {texts.heroDesc}
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto">
            <a 
              href={`/${lang}/synergies/coleccion`} 
              class="w-full sm:w-auto px-8 py-3.5 bg-slate-950 hover:bg-rose-600 text-white text-xs font-bold uppercase tracking-widest transition-colors flex items-center justify-center gap-2"
            >
              <span>{texts.viewAllSynergies}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg>
            </a>
            
            <a 
              href="#alianza-formulario" 
              class="w-full sm:w-auto px-8 py-3.5 bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 text-xs font-bold uppercase tracking-widest transition-colors flex items-center justify-center gap-2"
            >
              <span>{texts.applyPartner}</span>
            </a>
          </div>

        </div>
      </section>

      <!-- MANIFESTO QUOTE (CLEAN WHITE) -->
      <section class="w-full bg-white border-b border-slate-100 py-14 px-4 sm:px-8 text-center">
        <div class="max-w-4xl mx-auto border-t-2 border-rose-600 pt-10">
          <span class="text-3xs font-extrabold text-rose-600 tracking-widest uppercase block mb-3">
            CONCEPTO CENTRAL
          </span>
          <p class="text-xl sm:text-2xl md:text-3xl font-black italic uppercase tracking-tight text-slate-900 leading-snug max-w-3xl mx-auto">
            {texts.quote}
          </p>
        </div>
      </section>

      <!-- PRODUCTS SHOWCASE (CLEAN PRODUCT GRID) -->
      <section class="w-full bg-white border-b border-slate-100 py-16 px-4 md:px-8">
        <div class="max-w-7xl mx-auto">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-4 border-b border-slate-100">
            <div>
              <span class="text-3xs font-extrabold text-rose-600 tracking-widest uppercase block mb-1">
                {texts.productsBadge}
              </span>
              <h2 class="text-xl sm:text-2xl md:text-3xl font-black italic uppercase tracking-tight text-slate-900">
                {texts.productsTitle}
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">
                {texts.productsSubtitle}
              </p>
            </div>

            <a 
              href={`/${lang}/synergies/coleccion`} 
              class="text-xs font-bold uppercase tracking-wider text-rose-600 hover:text-rose-700 flex items-center gap-1.5 self-start sm:self-auto shrink-0 transition-colors"
            >
              <span>{texts.viewAllBtn}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg>
            </a>
          </div>

          <!-- 4-Column Clean Product Grid (Matching Store Style Exactly) -->
          <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-x-2 gap-y-6 sm:gap-x-4 sm:gap-y-8 md:gap-x-6">
            {displayProducts.map((product) => (
              <div class="product-card group flex flex-col justify-start w-full">
                <!-- Product Image Slider -->
                <div class="relative aspect-[2/3] w-full bg-white border border-slate-100 overflow-hidden" style="aspect-ratio: 2/3;">
                  <div class="product-images-slider flex w-full h-full overflow-x-auto snap-x snap-mandatory scrollbar-none" style="scrollbar-width: none;">
                    {product.images.map((imgUrl, imgIdx) => (
                      <a
                        href={`/${lang}/productos/${product.slug}`}
                        class="block w-full h-full shrink-0 snap-start relative overflow-hidden"
                        style="aspect-ratio: 2/3;"
                      >
                        <img
                          src={imgUrl}
                          alt={`${isEn ? (product.title_en || product.title) : product.title} - ${imgIdx + 1}`}
                          class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                          style={`object-position: ${getObjectPosition(imgUrl)}`}
                          loading="lazy"
                        />
                      </a>
                    ))}
                  </div>

                  <!-- Synergy Tag Badge -->
                  <span class="absolute top-2.5 left-2.5 px-2 py-0.5 bg-slate-950 text-white text-[8px] md:text-[9px] font-bold uppercase tracking-wider z-10 select-none">
                    SURVIVOR × F3
                  </span>

                  <!-- Price Badge -->
                  <span class="absolute bottom-2 right-2 px-2 py-0.5 bg-slate-950/85 text-white text-[10px] sm:text-xs font-extrabold font-mono select-none">
                    {(product.price / 100).toFixed(2)} €
                  </span>
                </div>

                <!-- Product Details -->
                <div class="mt-2 pt-2 border-t border-slate-100 flex flex-col items-center gap-1 w-full text-center">
                  <a 
                    href={`/${lang}/productos/${product.slug}`} 
                    class="text-xs sm:text-sm font-medium text-slate-900 hover:text-rose-600 transition-colors line-clamp-2 h-[2.4rem] flex items-center justify-center leading-tight"
                  >
                    {isEn ? (product.title_en || product.title) : product.title}
                  </a>

                  {/* Color swatches */}
                  {product.variants && product.variants.length > 0 && (
                    <div class="flex items-center gap-1.5 justify-center min-h-[18px] mt-0.5">
                      {product.variants.map((v) => {
                        const colName = v.name.split('/')[0].trim();
                        return (
                          <span 
                            class="w-3.5 h-3.5 border border-slate-200" 
                            style={{ backgroundColor: v.colorHex || getColorHex(colName) }} 
                            title={colName}
                          />
                        );
                      })}
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>

          <!-- Big Clean Button To View All Synergies -->
          <div class="mt-12 text-center">
            <a 
              href={`/${lang}/synergies/coleccion`} 
              class="inline-flex items-center gap-3 px-10 py-4 bg-slate-950 hover:bg-rose-600 text-white text-xs font-bold uppercase tracking-widest transition-colors shadow-sm"
