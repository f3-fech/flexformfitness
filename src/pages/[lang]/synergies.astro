---
import { db } from '../../lib/firebase';
import type { Product, ProductCollection } from '../../types';
import SEO from '../../components/SEO.astro';
import Navbar from '../../components/Navbar.astro';
import { getColorHex, isLightColor } from '../../lib/utils';
import { optimizeProduct } from '../../lib/cdn';

export const prerender = true;

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const isEn = lang === 'en';

// Helper for image position
const getObjectPosition = (url: string | undefined): string => {
  if (!url) return 'center';
  const match = url.match(/#pos=([a-zA-Z0-9%_-]+)/);
  if (match && match[1]) {
    return match[1].replace('_', ' ');
  }
  return 'center';
};

// Fetch synergy collections from Firestore
let synergyCollections: ProductCollection[] = [];
let dbProducts: Product[] = [];

try {
  const colSnap = await db.collection('collections').where('isSynergy', '==', true).get();
  if (!colSnap.empty) {
    synergyCollections = colSnap.docs.map((doc) => ({ id: doc.id, ...doc.data() }) as ProductCollection);
    const productIds = Array.from(new Set(synergyCollections.flatMap((c) => c.productIds || [])));
    if (productIds.length > 0) {
      const prodDocs = await Promise.all(
        productIds.slice(0, 8).map((id) => db.collection('products').doc(id).get())
      );
      dbProducts = prodDocs.filter((d) => d.exists).map((d) => optimizeProduct({ id: d.id, ...d.data() } as Product));
    }
  }
} catch (error) {
  console.error('Error fetching synergy products:', error);
}

// Fallback showcase sample products if none are created in Firestore yet
const sampleProducts: Product[] = [
